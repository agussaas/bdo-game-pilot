<dialog id="help-dialog" aria-labelledby="help-title">
<h2 id="help-title">Help</h2>
<ul>
<li><a href="https://github.com/agussaas/bdo-game-pilot" target="_blank" rel="noopener noreferrer">GitHub</a></li>
<li><a href="https://t.me/+Xmmz3gE42BYzNmM1" target="_blank" rel="noopener noreferrer">Telegram Channel</a></li>
