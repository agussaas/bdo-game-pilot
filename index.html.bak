  /* 2. Progress hourly tanpa Agris */
  var calcHourly = function () {
    var out = document.getElementById("h-out");
    var t = Number(readNum("h-total"));
    var p = Number(readNum("h-rate"));
    var dropOn = document.getElementById("h-drop-on").checked;
    var dropRaw = readNum("h-drop");
    var dropItems = dropOn ? Number(dropRaw) : 0;
    var dRate = Number(readNum("h-drate"));
    var dSteps = ["h-d1", "h-d2", "h-d3", "h-d4"];

    if (!t || !p || t < 0 || p <= 0 || (dropOn && (dropRaw === "" || dropItems < 0 || !(dRate > 0)))) {
      out.value = "Invalid input.";
      fill("h-s", [], 5);
      dSteps.forEach(function (id) { put(id, null); });
      return;
    }

    var maxTL = 0;
    var enough = true;
    var hoursWith = 0;
    var hoursWithout = t / p;
    if (dropOn) {
      maxTL = dropItems * dRate;
      enough = t <= maxTL;
      hoursWith = enough ? t / dRate : dropItems;
      hoursWithout = enough ? 0 : (t - maxTL) / p;
    }
    var totalHours = dropOn ? hoursWith + hoursWithout : t / p;

    var totalSeconds = floorSec(totalHours);
    var hours = Math.floor(totalSeconds / 3600);
    var minutes = Math.floor((totalSeconds % 3600) / 60);
    var seconds = totalSeconds % 60;

    out.value = hours + " Hours " + minutes + " Minutes " + seconds + " Seconds";

    var l1 = document.getElementById("h-l1");
    l1.textContent = dropOn
      ? "Waktu dengan patokan Agris ditambah waktu dengan patokan biasa "
      : "Total TL dibagi TL per jam ";
    var l1b = document.createElement("strong");
    l1b.textContent = "(waktu dalam jam)";
    l1.appendChild(l1b);

    put("h-d1", dropOn ? dropItems + " × " + dRate + " = " + maxTL : null);
    put("h-d2", dropOn ? t + (enough ? " ≤ " : " > ") + maxTL : null);
    put("h-d3", dropOn
      ? (enough ? t + " ÷ " + dRate + " = " + hoursWith : "min(" + dropItems + " jam) = " + hoursWith)
      : null);
    put("h-d4", dropOn
      ? (enough ? "0" : "(" + t + " − " + maxTL + ") ÷ " + p + " = " + hoursWithout)
      : null);

    fill("h-s", [
      dropOn ? hoursWith + " + " + hoursWithout + " = " + totalHours : t + " ÷ " + p + " = " + (t / p),
      "floor(" + totalHours + " × 3600) = " + totalSeconds,
      "floor(" + totalSeconds + " ÷ 3600) = " + hours,
      "floor((" + totalSeconds + " mod 3600) ÷ 60) = " + minutes,
      totalSeconds + " mod 60 = " + seconds
    ], 5);
  };

  /* 3. Progress hourly dengan Agris */
  var calcAgris = function () {
    var out = document.getElementById("a-out");
    var withA = document.getElementById("a-with");
    var withoutA = document.getElementById("a-without");
    var totalTL = Number(readNum("a-total"));
    var agrisRate = Number(readNum("a-rate"));
    var agrisCostPerHour = Number(readNum("a-cost"));
    var normalRate = Number(readNum("a-normal"));
    var currentAgris = Number(readNum("a-current"));
    var dropOn = document.getElementById("a-drop-on").checked;
    var dropRaw = readNum("a-drop");
    var dropItems = dropOn ? Number(dropRaw) : 0;

    if (!totalTL || !agrisRate || !agrisCostPerHour || !normalRate || totalTL < 0 || agrisRate <= 0 || agrisCostPerHour <= 0 || normalRate <= 0 || (dropOn && (dropRaw === "" || dropItems < 0))) {
      out.value = "Invalid input.";
      withA.value = "";
      withoutA.value = "";
      document.getElementById("a-sd").value = "";
      fill("a-s", [], 5);
      fill("a-t", [], 4);
      fill("a-w", [], 4);
      fill("a-o", [], 4);
      return;
    }

    var agrisHours = currentAgris / agrisCostPerHour;
    var maxAgrisHours = agrisHours + dropItems;
    var maxAgrisTL = maxAgrisHours * agrisRate;

    
    var normalTL = 0;
    var hoursWithAgris = 0;
    var hoursWithoutAgris = 0;

    if (totalTL <= maxAgrisTL) {
      hoursWithAgris = totalTL / agrisRate;
    } else {
      normalTL = totalTL - maxAgrisTL;
      hoursWithAgris = maxAgrisHours;
      hoursWithoutAgris = normalTL / normalRate;
    }

    var formatHours = function (h) {
      var totalSecs = floorSec(h);
      var hrs = Math.floor(totalSecs / 3600);
      var mins = Math.floor((totalSecs % 3600) / 60);
      var secs = totalSecs % 60;
      return hrs + " Hours " + mins + " Minutes " + secs + " Seconds";
    };

    var totalSeconds = floorSec(hoursWithAgris + hoursWithoutAgris);
    var hours = Math.floor(totalSeconds / 3600);
    var minutes = Math.floor((totalSeconds % 3600) / 60);
    var seconds = totalSeconds % 60;

    out.value = hours + " Hours " + minutes + " Minutes " + seconds + " Seconds";
    withA.value = formatHours(hoursWithAgris);
    withoutA.value = formatHours(hoursWithoutAgris);

    var breakdown = function (h) {
      var secs = floorSec(h);
      return [
        "floor(" + h + " × 3600) = " + secs,
        "floor(" + secs + " ÷ 3600) = " + Math.floor(secs / 3600),
        "floor((" + secs + " mod 3600) ÷ 60) = " + Math.floor((secs % 3600) / 60),
        secs + " mod 60 = " + (secs % 60)
      ];
    };
    var enough = totalTL <= maxAgrisTL;

    var l4 = document.getElementById("a-l4");
    l4.textContent = enough
      ? "Total TL dibagi TL/hr dengan Agris "
      : "(Total TL dikurangi Maks TL Agris) dibagi TL/hr tanpa Agris ";
    var l4b = document.createElement("strong");
    l4b.textContent = enough ? "(waktu with Agris, dalam jam)" : "(waktu without Agris, dalam jam)";
    l4.appendChild(l4b);
        document.getElementById("a-sd").value = agrisHours + " + " + dropItems + " = " + maxAgrisHours;
    fill("a-s", [
      currentAgris + " ÷ " + agrisCostPerHour + " = " + agrisHours,
      maxAgrisHours + " × " + agrisRate + " = " + maxAgrisTL,
      totalTL + (enough ? " ≤ " : " > ") + maxAgrisTL,
      enough
        ? totalTL + " ÷ " + agrisRate + " = " + hoursWithAgris
        : "(" + totalTL + " − " + maxAgrisTL + ") ÷ " + normalRate + " = " + hoursWithoutAgris,
      hoursWithAgris + " + " + hoursWithoutAgris + " = " + (hoursWithAgris + hoursWithoutAgris)
    ], 5);
    fill("a-t", breakdown(hoursWithAgris + hoursWithoutAgris), 4);
    fill("a-w", breakdown(hoursWithAgris), 4);
    fill("a-o", breakdown(hoursWithoutAgris), 4);
  };

  /* 4. Total progress hourly */
  var calcTotal = function () {
    var out = document.getElementById("t-out");
    var p = function (s) {
      return Array.from(s.matchAll(/(\d+)\s*([hm])/gi)).reduce(function (a, m) {
        return a + (m[2].toLowerCase() === "h" ? Number(m[1]) * 60 : Number(m[1]));
      }, 0);
    };

    var explain = function (s) {
      var terms = [];
      var sum = 0;
      Array.from(s.matchAll(/(\d+)\s*([hm])/gi)).forEach(function (m) {
        var isHour = m[2].toLowerCase() === "h";
        sum += isHour ? Number(m[1]) * 60 : Number(m[1]);
        terms.push(isHour ? m[1] + " × 60" : m[1]);
      });
      var expr = terms.join(" + ");
      return (expr === String(sum) || !terms.length ? "" : expr + " = ") + sum;
    };

    var i = document.getElementById("t-prev").value.replace(/,/g, "");
    if (!i) { out.value = ""; fill("t-s", [], 5); return; }

    var x = document.getElementById("t-now").value.replace(/,/g, "");
    if (!x) { out.value = ""; fill("t-s", [], 5); return; }

    var okT = /^\s*(?:\d+\s*[hm][a-z]*\s*)+$/i;
    if (!okT.test(i) || !okT.test(x)) { out.value = "Invalid input."; fill("t-s", [], 5); return; }
    var totalMinutes = p(i) + p(x);
    var hours = Math.floor(totalMinutes / 60);
    var minutes = totalMinutes % 60;

    out.value = hours + " H " + minutes + " M";

    fill("t-s", [
      explain(i),
      explain(x),
      p(i) + " + " + p(x) + " = " + totalMinutes,
      "floor(" + totalMinutes + " ÷ 60) = " + hours,
      totalMinutes + " mod 60 = " + minutes
    ], 5);
  };
  /* 5. Buff counter */
  var DURATION_UNITS = { h: 3600, m: 60, s: 1 };
  var PRICE_SUFFIXES = { k: 1000, m: 1000000, b: 1000000000 };
  var MAX_SECONDS = 1e6;

  var asciiDigits = function (text) {
    return Array.from(text).map(function (ch) {
      var cp = ch.codePointAt(0);
      if (cp < 128 || !/^\p{Nd}$/u.test(ch)) return ch;
      var start = cp;
      while (/^\p{Nd}$/u.test(String.fromCodePoint(start - 1))) start--;
      return String((cp - start) % 10);
    }).join("");
  };
  var parseFloatStrict = function (text) {
    var t = asciiDigits(text.trim());
    if (/^[+-]?(inf|infinity)$/i.test(t)) return t.charAt(0) === "-" ? -Infinity : Infinity;
    if (/^[+-]?nan$/i.test(t)) return NaN;
    return /^[+-]?(\d+\.?\d*|\.\d+)(e[+-]?\d+)?$/.test(t) ? Number(t) : NaN;
  };
  var roundHalfEven = function (x) {
    var r = Math.round(x);
    return (Math.abs(x % 1) === 0.5 && r % 2 !== 0) ? r - 1 : r;
  };

  var parseDuration = function (text, defaultUnit, label, allowZero) {
    var cleaned = text.trim().toLowerCase().replace(/[,_]/g, "");
    if (!cleaned) throw new Error(label + " belum diisi");

    var unit = defaultUnit;
    var last = cleaned.charAt(cleaned.length - 1);
    if (DURATION_UNITS.hasOwnProperty(last)) {
      unit = last;
      cleaned = cleaned.slice(0, -1);
    }

    var value = parseFloatStrict(cleaned);
    if (isNaN(value)) throw new Error("'" + text + "' bukan " + label + " yang valid");
    var seconds = Number((value * DURATION_UNITS[unit]).toPrecision(15));

    if (!isFinite(seconds)) throw new Error("'" + text + "' bukan " + label + " yang valid");
    if (allowZero) {
      if (seconds < 0) throw new Error(label + " tidak boleh negatif");
    } else if (seconds <= 0) {
      throw new Error(label + " harus lebih dari nol");
    }
    if (seconds > MAX_SECONDS) throw new Error(label + " terlalu besar");
    return { value: value, mult: DURATION_UNITS[unit], seconds: seconds };
  };

  var parsePrice = function (text) {
    var cleaned = text.trim().toLowerCase().replace(/[,_]/g, "");
    if (!cleaned) throw new Error("harga belum diisi");

    var mult = 1;
    var last = cleaned.charAt(cleaned.length - 1);
    if (PRICE_SUFFIXES.hasOwnProperty(last)) {
      mult = PRICE_SUFFIXES[last];
      cleaned = cleaned.slice(0, -1);
    }

    var value = parseFloatStrict(cleaned);
    if (isNaN(value)) throw new Error("'" + text + "' bukan harga yang valid");
    var price = Number((value * mult).toPrecision(15));

    if (!isFinite(price)) throw new Error("'" + text + "' bukan harga yang valid");
    if (price <= 0) throw new Error("harga harus lebih dari nol");
    if (price > 1e15) throw new Error("harga terlalu besar");
    return { value: value, mult: mult, price: BigInt(Math.trunc(price)) };
  };

  var fmtDuration = function (seconds) {
    var total = roundHalfEven(seconds);
    var hours = Math.floor(total / 3600);
    var rem = total % 3600;
    var minutes = Math.floor(rem / 60);
    var secs = rem % 60;
    var parts = [];
    if (hours) parts.push(hours + "h");
    if (minutes) parts.push(minutes + "m");
    if (secs || !parts.length) parts.push(secs + "s");
    return parts.join(" ");
  };

  var calcBuff = function () {
    var outs = ["b-o1", "b-o2", "b-o3", "b-o4"].map(function (id) {
      return document.getElementById(id);
    });
    var clearAll = function (message) {
      outs[0].value = message;
      outs[1].value = "";
      outs[2].value = "";
      outs[3].value = "";
      fill("b-s", [], 9);
    };

    var shift, duration, cooldown, priceText, price, cycle, ratio, count;
    try {
      shift = parseDuration(document.getElementById("b-shift").value, "h", "durasi shift", false);
      duration = parseDuration(document.getElementById("b-duration").value, "m", "durasi buff", false);
      cooldown = parseDuration(document.getElementById("b-cooldown").value, "s", "cooldown", true);
      priceText = document.getElementById("b-price").value;
      price = priceText.trim() ? parsePrice(priceText) : null;

      cycle = duration.seconds + cooldown.seconds;
      ratio = Number((shift.seconds / cycle).toPrecision(12));
      if (!isFinite(ratio)) throw new Error("hasil terlalu besar");
      count = Math.max(1, Math.ceil(ratio));
    } catch (e) {
      clearAll(e.message);
      return;
    }

    var countStr = BigInt(count).toString();

    outs[0].value = fmtDuration(shift.seconds);
    outs[1].value = fmtDuration(duration.seconds) + " duration + " +
      fmtDuration(cooldown.seconds) + " cooldown (one buff covers " + fmtDuration(cycle) + ")";
    outs[2].value = countStr + " " + (count === 1 ? "buff" : "buffs");
    outs[3].value = price
      ? countStr + " x " + price.price.toLocaleString("en-US") + " = " +
        (BigInt(count) * price.price).toLocaleString("en-US") + " silver"
      : "";

    var lines = [
      shift.value + " × " + shift.mult + " = " + shift.seconds,
      duration.value + " × " + duration.mult + " = " + duration.seconds,
      cooldown.value + " × " + cooldown.mult + " = " + cooldown.seconds,
      duration.seconds + " + " + cooldown.seconds + " = " + cycle,
      shift.seconds + " ÷ " + cycle + " = " + ratio,
      "ceil(" + ratio + ") = " + BigInt(Math.ceil(ratio)).toString(),
      "max(1, " + BigInt(Math.ceil(ratio)).toString() + ") = " + countStr
    ];
    if (price) {
      lines.push("floor(" + price.value + " × " + price.mult + ") = " + price.price.toString());
      lines.push(countStr + " × " + price.price.toString() + " = " + (BigInt(count) * price.price).toString());
    }
    fill("b-s", lines, 9);
  };

  /* 6. BDO tax calculator */
  var TAX_BASE = 0.65;
  var TAX_VP = 0.30;
  var TAX_RING = 0.05;
  var TAX_FAME = { 1: 0.005, 2: 0.010, 3: 0.015 };
  var TAX_FAME_MIL = { 1: 5, 2: 10, 3: 15 };
  var TAX_FAME_PCT = { 1: "0.5%", 2: "1.0%", 3: "1.5%" };
  var TAX_SUFFIXES = { k: 1000, m: 1000000, b: 1000000000, t: 1000000000000 };

  var fameTier = function (points) {
    if (points >= 7000n) return 3;
    if (points >= 4000n) return 2;
    if (points >= 1000n) return 1;
    return 0;
  };

  var parseTaxPrice = function (text) {
    var cleaned = text.trim().toLowerCase().replace(/[,_]/g, "");
    if (!cleaned) throw new Error("harga belum diisi");

    var mult = 1;
    var last = cleaned.charAt(cleaned.length - 1);
    if (TAX_SUFFIXES.hasOwnProperty(last)) {
      mult = TAX_SUFFIXES[last];
      cleaned = cleaned.slice(0, -1);
    }

    var value = parseFloatStrict(cleaned);
    if (isNaN(value)) throw new Error("'" + text + "' bukan harga yang valid");
    var price = Number((value * mult).toPrecision(15));

    if (isNaN(price)) throw new Error("'" + text + "' bukan harga yang valid");
    if (price <= 0) throw new Error("harga harus lebih dari nol");
    if (price > 1e15) throw new Error("harga terlalu besar");
    return { value: value, mult: mult, price: Math.trunc(price) };
  };

  var parseTaxFlags = function (tokens) {
    var o = { vp: false, ring: false, fame: 0, famePoints: null };
    tokens.forEach(function (raw) {
      var token = raw.trim().toLowerCase().replace(/,/g, "");
      if (token === "vp") {
        o.vp = true;
      } else if (token === "ring") {
        o.ring = true;
      } else if (token === "fame1" || token === "fame2" || token === "fame3") {
        o.fame = Number(token.charAt(token.length - 1));
        o.famePoints = null;
      } else if (/^\p{Nd}+$/u.test(token)) {
        o.famePoints = BigInt(asciiDigits(token));
        o.fame = fameTier(o.famePoints);
      } else {
        throw new Error("Opsi tidak dikenal '" + token + "' \u2014 pakai: vp, ring, fame1, fame2, fame3, " +
          "atau poin Family Fame (contoh 4500)");
      }
    });
    return o;
  };

  var taxBreakdown = function (price, vp, ring, fame, famePoints) {
    var profit = price * 65 / 100;
    var vpBonus = vp ? profit * 30 / 100 : 0;
    var ringBonus = ring ? profit * 5 / 100 : 0;
    var fameBonus = fame ? profit * TAX_FAME_MIL[fame] / 1000 : 0;
    var total = profit + vpBonus + ringBonus + fameBonus;
    return {
      price: price, tax: price - profit, profit: profit,
      vp: vpBonus, ring: ringBonus, fameBonus: fameBonus, fame: fame, famePoints: famePoints,
      total: total, rate: total / price
    };
  };

  var money = function (value) { return roundHalfEven(value).toLocaleString("en-US"); };

  var put = function (id, text) {
    if (!id) return;
    var el = document.getElementById(id);
    var row = el.parentNode;
    var prev = row.previousElementSibling;
    var pair = prev && prev.firstElementChild && prev.firstElementChild.htmlFor === id ? prev : null;
    el.value = text === null ? "" : text;
    row.hidden = text === null;
    if (pair) pair.hidden = text === null;
  };

  var showTaxOut = function (ids, r) {
    put(ids.price, money(r.price));
    put(ids.tax, "-" + money(r.tax));
    put(ids.profit, money(r.profit));
    put(ids.vp, r.vp ? "+" + money(r.vp) : null);
    put(ids.ring, r.ring ? "+" + money(r.ring) : null);
    if (r.fameBonus) {
      document.getElementById("d-l6").textContent = "Family Fame (" +
        (r.famePoints !== null ? r.famePoints.toLocaleString("en-US") + " pts, " : "") +
        "+" + TAX_FAME_PCT[r.fame] + "):";
      put(ids.fame, "+" + money(r.fameBonus));
    } else if (r.famePoints !== null) {
      document.getElementById("d-l6").textContent = "Family Fame (" +
        r.famePoints.toLocaleString("en-US") + " pts):";
      put(ids.fame, "no bonus (below 1000)");
    } else {
      put(ids.fame, null);
    }
    put(ids.receive, money(r.total) + " (" + (r.rate * 100).toFixed(2) + "%)");
  };

  var showTaxSteps = function (ids, r, parsed) {
    var pctText = TAX_FAME[r.fame];
    put(ids.price, parsed ? "floor(" + parsed.value + " × " + parsed.mult + ") = " + r.price : null);
    put(ids.profit, r.price + " × " + TAX_BASE + " = " + r.profit);
    put(ids.tax, r.price + " − " + r.profit + " = " + r.tax);
    put(ids.vp, r.vp ? r.profit + " × " + TAX_VP + " = " + r.vp : null);
    put(ids.ring, r.ring ? r.profit + " × " + TAX_RING + " = " + r.ring : null);
    var pts = r.famePoints;
    put(ids.points, pts !== null
      ? pts.toString() + (pts >= 7000n ? " ≥ 7000" : pts >= 4000n ? " ≥ 4000" : pts >= 1000n ? " ≥ 1000" : " < 1000")
      : null);
    put(ids.fame, r.fameBonus ? r.profit + " × " + pctText + " = " + r.fameBonus : null);
    var terms = [String(r.profit)];
    if (r.vp) terms.push(String(r.vp));
    if (r.ring) terms.push(String(r.ring));
    if (r.fameBonus) terms.push(String(r.fameBonus));
    put(ids.total, terms.length > 1 ? terms.join(" + ") + " = " + r.total : null);
    put(ids.rate, r.total + " ÷ " + r.price + " = " + r.rate);
    put(ids.pct, r.rate + " × 100 = " + Number((r.rate * 100).toPrecision(12)));
  };

  var OUT1 = { price: "d-o1", tax: "d-o2", profit: "d-o3", vp: "d-o4", ring: "d-o5", fame: "d-o6", receive: "d-o7" };
  var OUT2 = { price: "d-p1", tax: "d-p2", profit: "d-p3", vp: "d-p4", ring: null, fame: null, receive: "d-p5" };
  var STP1 = { price: "d-s1", profit: "d-s2", tax: "d-s3", vp: "d-s4", ring: "d-s5", points: "d-s6", fame: "d-s7", total: "d-s8", rate: "d-s9", pct: "d-s10" };
  var STP2 = { price: null, profit: "d-t1", tax: "d-t2", vp: "d-t3", ring: null, points: null, fame: null, total: "d-t4", rate: "d-t5", pct: "d-t6" };

  var calcTax = function () {
    var parsed, options, r1, r2 = null;
    try {
      parsed = parseTaxPrice(document.getElementById("d-price").value);
      options = parseTaxFlags(document.getElementById("d-options").value.split(/\s+/).filter(function (t) { return t; }));
      if (parsed.price === 0) throw new Error("harga harus lebih dari nol");
    } catch (e) {
      Object.keys(OUT1).forEach(function (k) { put(OUT1[k], null); });
      Object.keys(OUT2).forEach(function (k) { put(OUT2[k], null); });
      Object.keys(STP1).forEach(function (k) { put(STP1[k], null); });
      Object.keys(STP2).forEach(function (k) { put(STP2[k], null); });
      put(OUT1.price, e.message);
      document.getElementById("d-out2").hidden = true;
      document.getElementById("d-stp2").hidden = true;
      return;
    }

    var noFlags = !options.vp && !options.ring && !options.fame && options.famePoints === null;
    if (noFlags) {
      r1 = taxBreakdown(parsed.price, false, false, 0, null);
      r2 = taxBreakdown(parsed.price, true, false, 0, null);
    } else {
      r1 = taxBreakdown(parsed.price, options.vp, options.ring, options.fame, options.famePoints);
    }

    showTaxOut(OUT1, r1);
    showTaxSteps(STP1, r1, parsed);
    document.getElementById("d-out2").hidden = !noFlags;
    document.getElementById("d-stp2").hidden = !noFlags;
    if (noFlags) {
      showTaxOut(OUT2, r2);
      showTaxSteps(STP2, r2, null);
    }
  };

  /* 7. Total TL */
  var calcTotalTL = function () {
    var out = document.getElementById("tl-out");
    var useSpot = document.getElementById("tl-spot-on").checked;
    var spot = document.getElementById("tl-spot").value;
    var isCustom = spot === "custom";
    document.getElementById("tl-custom").disabled = !useSpot;
    document.getElementById("tl-custom-row").hidden = !(useSpot && isCustom);

    var hidePrice = function () {
      put("tl-price", null);
      put("tl-all", null);
      put("tl-s2", null);
      put("tl-s3", null);
    };

    var a = readNum("tl-start");
    var b = readNum("tl-end");

    if (a === "" || b === "" || Number(a) < 0 || Number(b) < 0) {
      out.value = "Invalid input.";
      hidePrice();
      put("tl-s1", null);
      return;
    }

    var start = Number(a);
    var end = Number(b);
    var gain = end - start;
    if (gain < 0) {
      out.value = "TL akhir lebih kecil dari TL awal";
      hidePrice();
      put("tl-s1", null);
      return;
    }
    out.value = gain.toLocaleString("en-US");
    put("tl-s1", end + " − " + start + " = " + gain);

    if (!useSpot) {
      hidePrice();
      return;
    }

    var priceText = isCustom ? readNum("tl-custom") : spot;
    var price = Number(priceText);

    if (priceText === "" || !(price > 0) || !isFinite(price) || !isFinite(gain)) {
      put("tl-price", isCustom ? "Isi harga TL" : null);
      put("tl-all", null);
      put("tl-s2", null);
      put("tl-s3", null);
      return;
    }

    var all = BigInt(Math.round(gain)) * BigInt(Math.round(price));
    var compact = compactSilver(all);
    var full = all.toLocaleString("en-US");

    put("tl-price", price.toLocaleString("en-US") + " silver");
    put("tl-all", compact === full ? full + " silver" : full + " silver (" + compact + ")");
    put("tl-s2", String(price));
    put("tl-s3", gain + " × " + price + " = " + all);
  };

  /* 8. Compen */
  var parseSilver = function (text, label, allowZero) {
    var cleaned = text.trim().toLowerCase().replace(/[,_]/g, "");
    if (!cleaned) throw new Error(label + " belum diisi");

    var mult = 1;
    var last = cleaned.charAt(cleaned.length - 1);
    if (PRICE_SUFFIXES.hasOwnProperty(last)) {
      mult = PRICE_SUFFIXES[last];
      cleaned = cleaned.slice(0, -1);
    }

    var value = parseFloatStrict(cleaned);
    if (isNaN(value)) throw new Error("'" + text + "' bukan " + label + " yang valid");
    var amount = Number((value * mult).toPrecision(15));

    if (!isFinite(amount)) throw new Error("'" + text + "' bukan " + label + " yang valid");
    if (allowZero) {
      if (amount < 0) throw new Error(label + " tidak boleh negatif");
    } else if (amount <= 0) {
      throw new Error(label + " harus lebih dari nol");
    }
    if (amount > 1e15) throw new Error(label + " terlalu besar");
    var whole = BigInt(Math.trunc(amount));
    if (!allowZero && whole === 0n) throw new Error(label + " harus lebih dari nol");
    return { value: value, mult: mult, amount: whole };
  };

  var calcCompen = function () {
    var outs = ["cp-o1", "cp-o2", "cp-o3", "cp-o4", "cp-o5", "cp-o6"];
    var steps = ["cp-s1", "cp-s2", "cp-s3", "cp-s4", "cp-s5", "cp-s6"];
    var groups = [document.getElementById("cp-tl"), document.getElementById("cp-rng")];
    var compen, price;

    try {
      compen = parseSilver(document.getElementById("cp-compen").value, "compen");
      var priceText = document.getElementById("cp-price").value;
      price = priceText.trim() ? parseSilver(priceText, "harga TL") : null;
    } catch (e) {
      outs.forEach(function (id) { put(id, null); });
      steps.forEach(function (id) { put(id, null); });
      groups.forEach(function (g) { g.hidden = true; });
      put("cp-o1", e.message);
      return;
    }

    var pct = Math.min(100, Math.max(0, Number(document.getElementById("cp-pct").value) || 0));
    var total = compen.amount;
    var tlSilver = total * BigInt(pct) / 100n;
    var rngSilver = total - tlSilver;
    var count = price ? (tlSilver + price.amount - 1n) / price.amount : null;
    var silver = function (v) { return v.toLocaleString("en-US") + " silver"; };

    groups.forEach(function (g) { g.hidden = false; });
    put("cp-o1", silver(total));
    put("cp-o2", pct + "%");
    put("cp-o3", silver(tlSilver));
    put("cp-o4", count === null ? null : count.toLocaleString("en-US") + " TL");
    put("cp-o5", (100 - pct) + "%");
    put("cp-o6", silver(rngSilver));

    put("cp-s1", "floor(" + compen.value + " × " + compen.mult + ") = " + total);
    put("cp-s2", price ? "floor(" + price.value + " × " + price.mult + ") = " + price.amount : null);
    put("cp-s3", "floor(" + total + " × " + pct + " ÷ 100) = " + tlSilver);
    put("cp-s4", total + " − " + tlSilver + " = " + rngSilver);
    put("cp-s5", price ? "ceil(" + tlSilver + " ÷ " + price.amount + ") = " + count : null);
    put("cp-s6", price ? count + " × " + price.amount + " = " + (count * price.amount) : null);
  };

  /* 9. Silver */
  var compactSilver = function (big) {
    var neg = big < 0n;
    var abs = neg ? -big : big;
    var units = [["B", 1000000000n], ["M", 1000000n], ["K", 1000n]];
    var pick = -1;
    for (var i = 0; i < units.length; i++) {
      if (abs >= units[i][1]) { pick = i; break; }
    }
    if (pick === -1) return (neg ? "-" : "") + abs;
    var scale = function (k) { return (abs * 100n + units[k][1] / 2n) / units[k][1]; };
    var scaled = scale(pick);
    if (scaled >= 100000n && pick > 0) {
      pick -= 1;
      scaled = scale(pick);
    }
    var text = (scaled / 100n).toString();
    var frac = scaled % 100n;
    if (frac !== 0n) text += "." + frac.toString().padStart(2, "0").replace(/0+$/, "");
    return (neg ? "-" : "") + text + " " + units[pick][0];
  };

  var silverText = function (v) {
    var c = compactSilver(v);
    var n = v.toLocaleString("en-US");
    return c === n ? n + " silver" : n + " silver (" + c + ")";
  };

  var signedText = function (v) {
    return v > 0n ? "+" + silverText(v).replace(" (", " (+") : silverText(v);
  };

  var calcSilver = function () {
    var stepIds = ["sv-s1", "sv-s2", "sv-s3", "sv-sc", "sv-si", "sv-s4", "sv-s5", "sv-s6"];
    var cmpIds = ["sv-r1", "sv-r2", "sv-r3", "sv-r4"];
    var cmpBox = document.getElementById("sv-cmp");
    var isOn = function (id) { return document.getElementById(id + "-on").checked; };
    var text = function (id) { return document.getElementById(id).value; };
    var sum = function (list) { return list.reduce(function (a, b) { return a + b; }, 0n); };
    var line = function (list) { return (list.length > 1 ? list.join(" + ") + " = " : "") + sum(list); };
    var paint = function (ids, up, down) {
      ids.forEach(function (id) {
        var el = document.getElementById(id);
        el.classList.toggle("up", up);
        el.classList.toggle("down", down);
      });
    };
    var mark = function (up, down) { paint(["sv-r3", "sv-r4"], up, down); };

    var startTerms = [];
    var endTerms = [];
    var optTerms = [];
    var optParts = [];
    var cm0 = 0n;
    var cm1 = 0n;
    var inv0 = null;
    var inv1 = null;

    try {
      cm0 = parseSilver(text("sv-c0"), "central market silver (awal)", true).amount;
      startTerms.push(cm0);
      if (isOn("sv-i0")) {
        inv0 = parseSilver(text("sv-i0"), "inventory silver (awal)", true).amount;
        startTerms.push(inv0);
      }

      [["sv-o1", "sell in storage"], ["sv-o2", "sell in central market (sudah tax)"], ["sv-o3", "listed in cm (sudah tax)"], ["sv-o4", "keep owner"]].forEach(function (o) {
        if (!isOn(o[0])) return;
        if (document.getElementById(o[0] + "-m-on").checked) {
          var entries = text(o[0] + "-m").split(/\s+/).filter(function (s) { return s; });
          if (!entries.length) throw new Error("missing " + o[1] + " (manual)");
          var amounts = entries.map(function (s) { return parseSilver(s, o[1] + " (manual)", true).amount; });
          var manualSum = sum(amounts);
          document.getElementById(o[0]).value = manualSum.toLocaleString("en-US");
          optTerms.push(manualSum);
          optParts.push(amounts.length > 1 ? "(" + amounts.join(" + ") + ")" : String(manualSum));
        } else {
          var one = parseSilver(text(o[0]), o[1], true).amount;
          optTerms.push(one);
          optParts.push(String(one));
        }
      });

      cm1 = parseSilver(text("sv-c1"), "central market silver (akhir)", true).amount;
      endTerms.push(cm1);
      if (isOn("sv-i1")) {
        inv1 = parseSilver(text("sv-i1"), "inventory silver (akhir)", true).amount;
        endTerms.push(inv1);
      }
    } catch (e) {
      cmpIds.forEach(function (id) { put(id, null); });
      cmpBox.hidden = true;
      mark(false, false);
      put("sv-r6", null);
      stepIds.forEach(function (id) { put(id, null); });
      put("sv-r5", e.message);
      return;
    }

    var prev = 0n;
    var target = 0n;
    var progressError = null;
    try {
      var prevText = text("sv-p0");
      prev = prevText.trim() ? parseSilver(prevText, "total progress sebelumnya", true).amount : 0n;
      target = parseSilver(text("sv-p1"), "total progress keseluruhan", false).amount;
    } catch (e) {
      progressError = e.message;
    }

    var startTotal = sum(startTerms);
    var endTotal = sum(endTerms);
    var diff = endTotal - startTotal;
    var optTotal = sum(optTerms);
    var gain = diff + optTotal;
    var up = diff > 0n;
    var down = diff < 0n;

    cmpBox.hidden = false;
    put("sv-r1", silverText(startTotal));
    put("sv-r2", silverText(endTotal));
    put("sv-r3", signedText(diff));
    put("sv-r4", up
      ? "Silver bertambah (wajib tanyakan mod jika bingung, jangan buat keputusan sendiri)"
      : down
        ? "Silver berkurang (wajib tanyakan mod jika bingung, jangan buat keputusan sendiri)"
        : "Silver tidak berubah (wajib tanyakan mod jika bingung, jangan buat keputusan sendiri)");
    mark(up, down);

    var useInv = inv0 !== null || inv1 !== null;
    var invA = inv0 === null ? 0n : inv0;
    var invB = inv1 === null ? 0n : inv1;
    var cmDiff = cm1 - cm0;
    var invDiff = invB - invA;
    document.getElementById("sv-cm-box").hidden = !useInv;
    document.getElementById("sv-iv-box").hidden = !useInv;
    document.getElementById("sv-tot-legend").textContent = useInv ? "Total (Central Market + Inventory)" : "Central Market";
    if (useInv) {
      var ivNote;
      if (inv0 === null || inv1 === null) {
        ivNote = (inv0 === null ? "Inventory awal shift" : "Inventory end shift") +
          " tidak dicentang dan dihitung 0";
      } else if (invDiff > 0n) {
        ivNote = "Silver di inventory bertambah (wajib tanyakan mod jika bingung, jangan buat keputusan sendiri)";
      } else if (invDiff < 0n) {
        ivNote = "Silver di inventory berkurang (wajib tanyakan mod jika bingung, jangan buat keputusan sendiri)";
      } else {
        ivNote = "Silver di inventory tidak berubah (wajib tanyakan mod jika bingung, jangan buat keputusan sendiri)";
      }
      put("sv-cm1", silverText(cm0));
      put("sv-cm2", silverText(cm1));
      put("sv-cm3", signedText(cmDiff));
      put("sv-iv1", inv0 === null ? "0" : silverText(inv0));
      put("sv-iv2", inv1 === null ? "0" : silverText(inv1));
      put("sv-iv3", signedText(invDiff));
      put("sv-iv4", ivNote);
    } else {
      ["sv-cm1", "sv-cm2", "sv-cm3", "sv-iv1", "sv-iv2", "sv-iv3", "sv-iv4"].forEach(function (id) { put(id, null); });
    }
    paint(["sv-cm3"], cmDiff > 0n, cmDiff < 0n);
    paint(["sv-iv3", "sv-iv4"], invDiff > 0n, invDiff < 0n);
    put("sv-sc", useInv ? cm1 + " − " + cm0 + " = " + cmDiff : null);
    put("sv-si", useInv ? invB + " − " + invA + " = " + invDiff : null);
    put("sv-r5", silverText(gain));
    put("sv-r6", progressError !== null ? progressError : compactSilver(prev + gain) + " / " + compactSilver(target));

    put("sv-s1", line(startTerms));
    put("sv-s2", line(endTerms));
    put("sv-s3", endTotal + " − " + startTotal + " = " + diff);
    var optText = optParts.join(" + ");
    put("sv-s4", optTerms.length ? (optText === String(optTotal) ? optText : optText + " = " + optTotal) : null);
    put("sv-s5", diff + " + " + optTotal + " = " + gain);
    put("sv-s6", progressError === null ? prev + " + " + gain + " = " + (prev + gain) : null);
  };

  /* 10. Agris yang Digunakan */
  var AGRIS_RESET = 20000;
  var AGRIS_MAX = 100000;

  var calcAgrisUsed = function () {
    var a = readNum("au-start");
    var b = readNum("au-end");
    var reset = document.getElementById("au-reset").checked;
    var c = reset ? readNum("au-before") : "0";
    var steps = ["au-s1", "au-s2", "au-s3"];

    var fail = function (message) {
      put("au-out", message);
      steps.forEach(function (id) { put(id, null); });
    };

    if (a === "" || b === "" || c === "" ||
        Number(a) < 0 || Number(b) < 0 || Number(c) < 0 ||
        !isFinite(Number(a)) || !isFinite(Number(b)) || !isFinite(Number(c))) {
      fail("Invalid input.");
      return;
    }

    var start = Number(a);
    var end = Number(b);
    var before = Number(c);

    if (reset && before > start) {
      fail("Agris sebelum reset tidak boleh lebih besar dari agris awal");
      return;
    }
    if (reset && before > AGRIS_MAX) {
      fail("Agris sebelum reset tidak boleh lebih dari " + AGRIS_MAX.toLocaleString("en-US"));
      return;
    }

    var gain = reset ? Math.min(AGRIS_RESET, AGRIS_MAX - before) : 0;
    var total = start + gain;
    var used = total - end;

    put("au-s1", reset ? "min(" + AGRIS_RESET + ", " + AGRIS_MAX + " − " + before + ") = " + gain : null);
    put("au-s2", reset ? start + " + " + gain + " = " + total : String(total));

    if (used < 0) {
      put("au-out", "Agris akhir lebih besar dari total agris");
      put("au-s3", null);
      return;
    }

    put("au-out", used.toLocaleString("en-US"));
    put("au-s3", total + " − " + end + " = " + used);
  };

  /* 11. KPI (AVG) */
  var KPI_KEY = "bdo-game-pilot:kpi";
  var KPI_MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  var KPI_MAX_ROWS = 36;
  var kpiDefaults = function () {
    return [
      { m: "June 2026", mode: "kpi", kpi: "65.27", avg: "" },
      { m: "July 2026", mode: "kpi", kpi: "85.07", avg: "" },
      { m: "August 2026", mode: "kpi", kpi: "59.61", avg: "" },
      { m: "September 2026", mode: "kpi", kpi: "79.24", avg: "" },
      { m: "October 2026", mode: "avg", kpi: "", avg: "75.76" }
    ];
  };
  var kpiRows = kpiDefaults();
  try {
    var kpiSaved = JSON.parse(localStorage.getItem(KPI_KEY) || "null");
    if (Array.isArray(kpiSaved) && kpiSaved.length && kpiSaved.length <= KPI_MAX_ROWS) {
      kpiRows = kpiSaved.map(function (r) {
        r = r || {};
        var kpi = String(r.kpi || "");
        var avg = String(r.avg || "");
        var mode = r.mode === "avg" || r.mode === "kpi" ? r.mode : (kpi.trim() === "" && avg.trim() !== "" ? "avg" : "kpi");
        return { m: String(r.m || ""), mode: mode, kpi: kpi, avg: avg };
      });
    }
  } catch (e) {}
  var kpiSave = function () {
    try { localStorage.setItem(KPI_KEY, JSON.stringify(kpiRows)); } catch (e) {}
  };

  var kpiParse = function (s) {
    var t = asciiDigits(String(s).trim().replace(/\s/g, ""));
    if (t.indexOf(",") !== -1 && t.indexOf(".") === -1 && t.split(",").length === 2) t = t.replace(",", ".");
    else t = t.replace(/,/g, "");
    return /^-?(\d+\.?\d*|\.\d+)$/.test(t) ? Number(t) : NaN;
  };
  var kpiFmt = function (n) { return String(Math.round(n * 10000) / 10000); };

  var kpiTier = function (avg) {
    if (avg === null) return "";
    var a = Math.round(avg * 100) / 100;
    if (a >= 110) return "Tier 4";
    if (a >= 100) return "Tier 3";
    if (a >= 90) return "Tier 2";
    if (a >= 80) return "Tier 1";
    if (a >= 75) return "Tier 0";
    return "No Tier";
  };

  var kpiCompute = function (rows) {
    var eff = [];
    return rows.map(function (r, i) {
      var name = r.m.trim() || "Baris " + (i + 1);
      var from = Math.max(0, i - 2);
      var prev = eff.slice(from, i);
      var prevNames = rows.slice(from, i).map(function (x, j) { return x.m.trim() || "Baris " + (from + j + 1); });
      var n = prev.length + 1;
      var known = prev.every(function (x) { return x !== null; });
      var prevSum = prev.reduce(function (a, b) { return a + (b === null ? 0 : b); }, 0);
      var o = { kpi: null, avg: null, tier: "", steps: [], step: "" };
      var raw = r.mode === "avg" ? r.avg : r.kpi;
      var typed = raw.trim() !== "";
      var v = typed ? kpiParse(raw) : NaN;
      var bad = typed && isNaN(v);
      var st = o.steps;

      if (typed && !bad && known) {
        st.push({ t: "Jumlah bulan ini dan maksimal 2 bulan sebelumnya", s: "(n)", v: n + " (" + prevNames.concat(name).join(", ") + ")" });
        if (r.mode === "avg") {
          var total = n * v;
          o.avg = v;
          o.kpi = total - prevSum;
          st.push({ t: "Jumlah bulan dikali AVG", s: "(total KPI)", v: n + " × " + kpiFmt(v) + " = " + kpiFmt(total) });
          st.push({ t: "Total KPI dikurangi KPI bulan-bulan sebelumnya", s: "(KPI)", red: true,
            v: kpiFmt(total) + (prev.length ? " − (" + prev.map(kpiFmt).join(" + ") + ")" : "") + " = " + kpiFmt(o.kpi) });
        } else {
          var terms = prev.map(kpiFmt).concat(kpiFmt(v));
          var sum = prevSum + v;
          o.kpi = v;
          o.avg = sum / n;
          st.push({ t: "KPI bulan-bulan sebelumnya ditambah KPI bulan ini", s: "(total KPI)", v: terms.join(" + ") + " = " + kpiFmt(sum) });
          st.push({ t: "Total KPI dibagi jumlah bulan", s: "(AVG)", red: true, v: kpiFmt(sum) + " ÷ " + n + " = " + kpiFmt(o.avg) });
        }
        o.tier = kpiTier(o.avg);
        st.push({ t: "AVG dibulatkan 2 desimal, dibandingkan dengan batas tier", s: "(Tier)", red: true, v: o.avg.toFixed(2) + " → " + o.tier });
      } else if (bad) {
        st.push({ t: "Status", s: "", v: "Angka tidak valid" });
      } else if (typed) {
        st.push({ t: "Status", s: "", v: "Tidak bisa dihitung, KPI bulan sebelumnya belum lengkap" });
      } else {
        st.push({ t: "Status", s: "", v: "Belum diisi" });
      }
      eff.push(o.kpi);
      o.step = name + ": " + st.map(function (x) { return x.v; }).join(" ; ");
      return o;
    });
  };

  var kpiBody = document.getElementById("kpi-body");
  var kpiStepsEl = document.getElementById("kpi-steps");

  var kpiRefresh = function () {
    var res = kpiCompute(kpiRows);
    Array.prototype.forEach.call(kpiBody.rows, function (tr, i) {
      var r = kpiRows[i];
      var o = res[i];
      var sel = tr.querySelector("select");
      if (sel.value !== r.mode) sel.value = r.mode;
      [["kpi", "KPI"], ["avg", "AVG"]].forEach(function (f) {
        var el = tr.querySelector('input[data-f="' + f[0] + '"]');
        var isInput = r.mode === f[0];
        el.readOnly = !isInput;
        el.classList.toggle("result", !isInput);
        el.placeholder = isInput ? "isi " + f[1] : "hasil otomatis";
        el.setAttribute("aria-label", f[1] + " baris " + (i + 1) + (isInput ? " (input)" : " (hasil)"));
        if (!isInput) el.value = o[f[0]] === null ? "" : o[f[0]].toFixed(2);
        else if (document.activeElement !== el) el.value = r[f[0]];
      });
      tr.querySelector('input[data-f="tier"]').value = o.tier;
    });
    kpiStepsEl.textContent = "";
    res.forEach(function (o, i) {
      var fs = document.createElement("fieldset");
      var lg = document.createElement("legend");
      lg.textContent = kpiRows[i].m.trim() || "Baris " + (i + 1);
      fs.appendChild(lg);
      o.steps.forEach(function (s, k) {
        var id = "kpi-s-" + i + "-" + k;
        var p1 = document.createElement("p");
        var lb = document.createElement("label");
        lb.htmlFor = id;
        lb.appendChild(document.createTextNode(s.t + " "));
        if (s.s) {
          var sg = document.createElement("strong");
          if (s.red) sg.className = "red";
          sg.textContent = s.s;
          lb.appendChild(sg);
        }
        p1.appendChild(lb);
        var p2 = document.createElement("p");
        var ta = document.createElement("textarea");
        ta.id = id;
        ta.rows = 1;
        ta.cols = 50;
        ta.readOnly = true;
        ta.value = s.v;
        p2.appendChild(ta);
        fs.appendChild(p1);
        fs.appendChild(p2);
      });
      kpiStepsEl.appendChild(fs);
    });
    fitAll();
    return res;
  };

  var kpiBuild = function () {
    kpiBody.textContent = "";
    kpiRows.forEach(function (r, i) {
      var tr = document.createElement("tr");
      var cell = function (node) {
        var td = document.createElement("td");
        td.appendChild(node);
        tr.appendChild(td);
      };
      var field = function (key, label) {
        var inp = document.createElement("input");
        inp.type = "text";
        inp.setAttribute("data-f", key);
        inp.setAttribute("data-raw", "");
        inp.setAttribute("aria-label", label + " baris " + (i + 1));
        if (key === "kpi" || key === "avg") inp.setAttribute("inputmode", "decimal");
        if (key === "tier") {
          inp.readOnly = true;
          inp.classList.add("result");
        }
        if (key === "m") inp.value = r.m;
        return inp;
      };
      cell(field("m", "Bulan"));
      var sel = document.createElement("select");
      sel.setAttribute("data-raw", "");
      sel.setAttribute("aria-label", "Yang diinput baris " + (i + 1));
      [["kpi", "KPI"], ["avg", "AVG"]].forEach(function (o) {
        var opt = document.createElement("option");
        opt.value = o[0];
        opt.textContent = o[1];
        sel.appendChild(opt);
      });
      sel.value = r.mode;
      cell(sel);
      cell(field("kpi", "KPI"));
      cell(field("avg", "AVG"));
      cell(field("tier", "Tier"));
      var btn = document.createElement("button");
      btn.type = "button";
      btn.textContent = "Hapus";
      btn.setAttribute("aria-label", "Hapus baris " + (i + 1));
      cell(btn);
      kpiBody.appendChild(tr);
    });
    kpiRefresh();
  };

  var kpiIndex = function (el) {
    var tr = el.closest ? el.closest("tr") : null;
    return tr ? tr.sectionRowIndex : -1;
  };
  kpiBody.addEventListener("input", function (ev) {
    var el = ev.target;
    var f = el.getAttribute && el.getAttribute("data-f");
    var i = kpiIndex(el);
    if (!f || f === "tier" || i < 0 || el.tagName !== "INPUT" || el.readOnly) return;
    kpiRows[i][f] = el.value;
    kpiSave();
    kpiRefresh();
  });
  kpiBody.addEventListener("change", function (ev) {
    var el = ev.target;
    var i = kpiIndex(el);
    if (el.tagName !== "SELECT" || i < 0) return;
    var next = el.value === "avg" ? "avg" : "kpi";
    var other = next === "kpi" ? "avg" : "kpi";
    var carried = kpiCompute(kpiRows)[i][next];
    kpiRows[i].mode = next;
    kpiRows[i][next] = carried === null ? "" : kpiFmt(carried);
    kpiRows[i][other] = "";
    kpiSave();
    kpiRefresh();
  });
  kpiBody.addEventListener("focusout", function () { setTimeout(kpiRefresh, 0); });
  kpiBody.addEventListener("click", function (ev) {
    var btn = ev.target.closest ? ev.target.closest("button") : null;
    if (!btn || kpiRows.length <= 1) return;
    kpiRows.splice(kpiIndex(btn), 1);
    kpiSave();
    kpiBuild();
  });

  var kpiNextMonth = function (name, dir) {
    var m = name.trim().match(/^([A-Za-z]+)\s+(\d{4})$/);
    var word = m ? m[1] : name.trim();
    var idx = KPI_MONTHS.map(function (x) { return x.toLowerCase(); }).indexOf(word.toLowerCase());
    if (idx === -1) return "";
    var next = idx + dir;
    var year = m ? Number(m[2]) : null;
    if (next > 11) { next = 0; if (year !== null) year += 1; }
    if (next < 0) { next = 11; if (year !== null) year -= 1; }
    return KPI_MONTHS[next] + (year !== null ? " " + year : "");
  };
  document.getElementById("kpi-add-bottom").addEventListener("click", function () {
    if (kpiRows.length >= KPI_MAX_ROWS) return;
    kpiRows.push({ m: kpiNextMonth(kpiRows[kpiRows.length - 1].m, 1), mode: "kpi", kpi: "", avg: "" });
    kpiSave();
    kpiBuild();
  });
  document.getElementById("kpi-add-top").addEventListener("click", function () {
    if (kpiRows.length >= KPI_MAX_ROWS) return;
    kpiRows.unshift({ m: kpiNextMonth(kpiRows[0].m, -1), mode: "kpi", kpi: "", avg: "" });
    kpiSave();
    kpiBuild();
  });
  document.getElementById("reset-kpi").addEventListener("click", function () {
    kpiRows = kpiDefaults();
    try { localStorage.removeItem(KPI_KEY); } catch (e) {}
    kpiBuild();
  });
  document.getElementById("clear-kpi").addEventListener("click", function () {
    kpiRows = kpiRows.map(function (r) { return { m: r.m, mode: r.mode, kpi: "", avg: "" }; });
    kpiSave();
    kpiBuild();
  });

  /* Verifikasi KPI (AVG) (Claude, ChatGPT, Gemini) */
  var buildKpiVerifyPrompt = function () {
    var res = kpiCompute(kpiRows);
    var show = function (x) { return x === null ? "-" : x.toFixed(2); };
    var inputs = kpiRows.map(function (r, i) {
      var raw = r.mode === "avg" ? r.avg : r.kpi;
      return (i + 1) + ". " + (r.m.trim() || "(tanpa nama)") +
        " | Input: " + (r.mode === "avg" ? "AVG" : "KPI") + " = " + (raw.trim() || "(kosong)");
    });
    var outputs = res.map(function (o, i) {
      return (i + 1) + ". " + (kpiRows[i].m.trim() || "(tanpa nama)") +
        " | KPI: " + show(o.kpi) + " | AVG: " + show(o.avg) + " | Tier: " + (o.tier || "-");
    });
    var steps = res.map(function (o) { return o.step; }).filter(function (s) { return s; });
    var lines = [
      "Tolong verifikasi perhitungan KPI, rata-rata 3 bulan (AVG), dan Tier di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input (tabel diurutkan dari bulan terlama ke terbaru, tiap bulan hanya satu nilai yang diinput, KPI atau AVG):"
    ].concat(inputs, [
      "",
      "Aturan yang dipakai tool:",
      "- AVG suatu bulan = rata-rata KPI bulan itu dan 2 bulan sebelumnya (3 bulan terakhir).",
      "- Jika bulan sebelumnya tidak ada di tabel (baris pertama dan kedua), AVG dihitung dari bulan yang ada saja (1 atau 2 bulan).",
      "- Jika yang diinput KPI, AVG dihitung dari KPI. Jika yang diinput AVG, KPI dihitung balik: KPI = n × AVG − jumlah KPI bulan-bulan sebelumnya (n = jumlah bulan, maksimal 3).",
      "- Tier otomatis dari AVG (dibulatkan 2 desimal): di bawah 75 = No Tier, 75 sampai di bawah 80 = Tier 0, 80 sampai di bawah 90 = Tier 1, 90 sampai di bawah 100 = Tier 2, 100 sampai di bawah 110 = Tier 3, 110 ke atas = Tier 4.",
      "",
      "Hasil dari tool:"
    ], outputs);
    if (steps.length) {
      lines.push("", "Langkah perhitungan dari tool:");
      steps.forEach(function (s, i) { lines.push((i + 1) + ". " + s); });
    }
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumus AVG (rata-rata 3 bulan terakhir) dan rumus hitung balik KPI dari AVG sudah benar, termasuk untuk baris pertama dan kedua yang periodenya belum genap 3 bulan?",
      "2. Hitung ulang sendiri dari data input di atas, apakah hasilnya sama dengan hasil tool?",
      "3. Apakah Tier yang tampil sudah sesuai dengan aturan di atas untuk tiap AVG?",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
  };
  document.getElementById("verify-kpi-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildKpiVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });

  kpiBuild();

  /* 12. Login Logout */
  var PILOTS = {
    agus: { nama: "AGUS", divisi: "ASCENDANT", absen: "HK059" },
    ali: { nama: "ALI", divisi: "ASCENDANT", absen: "HK098" },
    anas: { nama: "ANAS", divisi: "ASCENDANT", absen: "HK018" },
    arsif: { nama: "ARSIF", divisi: "ASCENDANT", absen: "HK052" },
    azwary: { nama: "AZWARY", divisi: "ASCENDANT", absen: "HK076" },
    bobby: { nama: "BOBBY", divisi: "ASCENDANT", absen: "HK064" },
    denis: { nama: "DENIS", divisi: "ASCENDANT", absen: "HK111" },
    fajar: { nama: "FAJAR", divisi: "ASCENDANT", absen: "HK092" },
    faris: { nama: "FARIS", divisi: "ASCENDANT", absen: "ST002" },
    faza: { nama: "FAZA", divisi: "ASCENDANT", absen: "HK022" },
    heri: { nama: "HERI", divisi: "ASCENDANT", absen: "HK084" },
    insan: { nama: "INSAN", divisi: "ASCENDANT", absen: "HK093" },
    jibril: { nama: "JIBRIL", divisi: "ASCENDANT", absen: "HK019" },
    mosa: { nama: "MOSA", divisi: "ASCENDANT", absen: "HK040" },
    nafis: { nama: "NAFIS", divisi: "ASCENDANT", absen: "HK063" },
    rei: { nama: "REI", divisi: "ASCENDANT", absen: "HK120" },
    revi: { nama: "REVI", divisi: "ASCENDANT", absen: "HK058" }
  };

  var calcLogin = function () {
    var v = function (id) { return document.getElementById(id).value.trim(); };
    document.getElementById("lg-out").value = [
      "Login",
      "Nama: " + v("lg-nama"),
      "Divisi: " + v("lg-divisi"),
      "No Absen: " + v("lg-absen"),
      "No Order: " + v("lg-order")
    ].join("\n");
  };

  var calcLogout = function () {
    var v = function (id) { return document.getElementById(id).value.trim(); };
    var lain = v("lo-type") === "LAIN2";
    document.getElementById("lo-lain-row").hidden = !lain;
    document.getElementById("lo-progress-row").hidden = lain;
    var lines = [
      "Logout",
      "No Login: " + v("lo-login"),
      "No order: " + v("lo-order"),
      "Nama: " + v("lo-nama"),
      "Divisi: " + v("lo-divisi"),
      "No Absen : " + v("lo-absen"),
      "Type Job: " + v("lo-type")
    ];
    lines.push(lain ? v("lo-lain") : "Progress: " + v("lo-progress"));
    document.getElementById("lo-out").value = lines.join("\n");
  };

  /* Pilih pilot untuk otomatis isi form */
  var applyPilot = function (selectId, map) {
    var p = PILOTS[document.getElementById(selectId).value];
    if (!p) return;
    Object.keys(map).forEach(function (id) {
      var el = document.getElementById(id);
      el.value = p[map[id]];
      el.dispatchEvent(new Event("input", { bubbles: true }));
    });
  };
  document.getElementById("lg-pilot").addEventListener("change", function () {
    applyPilot("lg-pilot", { "lg-nama": "nama", "lg-divisi": "divisi", "lg-absen": "absen" });
  });
  document.getElementById("lo-pilot").addEventListener("change", function () {
    applyPilot("lo-pilot", { "lo-nama": "nama", "lo-divisi": "divisi", "lo-absen": "absen" });
  });

  /* Edit manual Nama/Divisi/No Absen: dropdown Pilot pindah ke custom */
  [["lg", "lg-pilot"], ["lo", "lo-pilot"], ["rp", "rp-pilot"]].forEach(function (g) {
    ["nama", "divisi", "absen"].forEach(function (f) {
      document.getElementById(g[0] + "-" + f).addEventListener("input", function () {
        setTimeout(function () {
          var sel = document.getElementById(g[1]);
          var p = PILOTS[sel.value];
          if (!p) return;
          var differs = ["nama", "divisi", "absen"].some(function (k) {
            return document.getElementById(g[0] + "-" + k).value !== p[k];
          });
          if (differs) {
            sel.value = "custom";
            sel.dispatchEvent(new Event("change", { bubbles: true }));
          }
        }, 0);
      });
    });
  });

  /* Output Login/Logout: klik otomatis langsung di copy */
  ["lg-out", "lo-out", "rp-out"].forEach(function (id) {
    var el = document.getElementById(id);
    var selectAll = function () {
      el.select();
      el.setSelectionRange(0, el.value.length);
    };
    el.addEventListener("click", selectAll);
    el.addEventListener("focus", selectAll);
  });

  /* 13. Laporan */
  var calcLaporan = function () {
    var v = function (id) { return document.getElementById(id).value.trim(); };
    var dash = function (s) { return s ? s : "-"; };
    var list = function (label, id) {
      var items = document.getElementById(id).value.split("\n").map(function (s) {
        return s.replace(/^\s*-\s*/, "").trim();
      }).filter(function (s) { return s; });
      return items.length
        ? [label + " :"].concat(items.map(function (s) { return "- " + s; }))
        : [label + " : -"];
    };

    var farm = v("rp-type") === "FARM";
    ["rp-sell-row", "rp-listed-row", "rp-keep-row"].forEach(function (id) {
      document.getElementById(id).hidden = !farm;
    });

    var spot = v("rp-spot").toUpperCase();
    var pSpot = v("rp-p-spot") ? v("rp-p-spot").toUpperCase() : spot;
    var ls = v("rp-ls");
    var tl = v("rp-tl");
    var agris = v("rp-agris");
    var buff = v("rp-buff");

    var total = v("rp-total");
    var target = v("rp-target");
    var totalText = total ? (target ? total + " / " + target : total) : "-";

    var spotTl = [pSpot, tl].filter(Boolean).join(" ");
    
    // Bagian sebelum Agris (LS + Spot/TL)
    var frontParts = [];
    if (ls) frontParts.push(ls);
    if (spotTl) frontParts.push(spotTl);
    var frontStr = frontParts.join(", ");

    // Bagian Agris
    var agrisStr = agris ? agris + " AGRIS" : "";

    // Gabung semuanya sesuai urutan
    var insideParts = [];
    if (frontStr || agrisStr) {
      insideParts.push(frontStr + (frontStr && agrisStr ? " / " : "") + agrisStr);
    }
    if (buff) {
      insideParts.push(buff);
    }

    var progressDetail = "";
    if (insideParts.length > 0) {
      progressDetail = " (" + insideParts.join(", ") + ")";
    }

    var head = [
      "Logout",
      "No Login: " + v("rp-login"),
      "No order: " + v("rp-order"),
      "Nama: " + v("rp-nama"),
      "Divisi: " + v("rp-divisi"),
      "No Absen : " + v("rp-absen"),
      "Type Job: " + v("rp-type"),
      "Progress: " + v("rp-progress") + progressDetail,
      ""
    ];

    var mid = farm ? [
      "Gaining :",
      "- " + pSpot + " : " + v("rp-tl"),
      "========================================",
      "Sell in storage : " + dash(v("rp-sell")),
      "Listed CM (TAX) : " + dash(v("rp-listed")),
      "Keep : " + dash(v("rp-keep")),
      "Progress : " + v("rp-progress"),
      "========================================",
      "Broken crystal : " + dash(v("rp-crystal")),
      "Total Progress : " + totalText
    ] : [
      "Progress :",
      "- " + v("rp-progress"),
      "- " + pSpot + " : " + v("rp-tl"),
      "",
      "================================",
      "Replace crystal : " + dash(v("rp-crystal")),
      "Total hours : " + totalText
    ];

    var tail = [""].concat(list("Keterangan", "rp-ket"), [
      "",
      "Class : " + v("rp-class").toUpperCase(),
      "Grinding Spot : " + spot,
      (farm ? "Agris yang Digunakan : " : "Agris Yang Digunakan : ") + v("rp-agris"),
      ""
    ], list("Kendala", "rp-kendala"), [""], list("Note", "rp-note"));

    var outEl = document.getElementById("rp-out");
    if (outEl) {
      outEl.value = head.concat(mid, tail).join("\n");
      outEl.style.height = "auto";
      outEl.style.height = outEl.scrollHeight + "px";
    }
  };

  document.getElementById("rp-pilot").addEventListener("change", function () {
    applyPilot("rp-pilot", { "rp-nama": "nama", "rp-divisi": "divisi", "rp-absen": "absen" });
  });

// 14. Import Laporan
  var importLaporan = function () {
    var rawText = document.getElementById("rp-import-text").value;
    var logEl = document.getElementById("rp-import-log");
    var logs = [];
    var logThis = function(msg) { 
      logs.push(msg); 
      if(logEl) { 
        logEl.value = logs.join("\n"); 
        logEl.style.height = "auto"; 
        logEl.style.height = logEl.scrollHeight + "px"; 
      } 
    };

    if (!rawText) {
      if(logEl) logEl.value = "Kotak import masih kosong";
      return;
    }

    if(logEl) logEl.value = "";
    logs = [];

    // A. Kosongkan field input form
    document.getElementById("rp-order").value = "";
    document.getElementById("rp-class").value = "";
    document.getElementById("rp-spot").value = "";
    document.getElementById("rp-progress").value = "";
    document.getElementById("rp-p-spot").value = "";
    document.getElementById("rp-ls").value = "";
    document.getElementById("rp-buff").value = "";
    document.getElementById("rp-tl").value = "";
    document.getElementById("rp-agris").value = "0 K";
    document.getElementById("rp-sell").value = "";
    document.getElementById("rp-listed").value = "";
    document.getElementById("rp-keep").value = "";
    document.getElementById("rp-total").value = "";
    document.getElementById("rp-target").value = "";
    document.getElementById("rp-crystal").value = "";
    document.getElementById("rp-ket").value = "";
    document.getElementById("rp-kendala").value = "";
    document.getElementById("rp-note").value = "";

    // B. Type Job (HOURLY atau FARM)
    var matchType = rawText.match(/Type Job\s*:\s*(.+)/i);
    var jobType = matchType ? matchType[1].trim().toUpperCase() : "HOURLY";
    document.getElementById("rp-type").value = jobType;
    if (matchType) {
      logThis("[OK] Type Job: " + jobType);
    } else {
      logThis("[FAILED] Type Job tidak ditemukan");
    }
    
    calcLaporan();

    // C. Parse No Order
    var matchOrder = rawText.match(/No\s+order\s*:\s*(.+)/i);
    if (matchOrder) {
      document.getElementById("rp-order").value = matchOrder[1].trim();
      logThis("[OK] No order: " + matchOrder[1].trim());
    } else {
      logThis("[FAILED] No order tidak ditemukan");
    }

    // D. Parse Class
    var matchClass = rawText.match(/(?:^|\n)[ \t]*(?:Class|Character)\s*:\s*(.+)/i);
    if (matchClass) {
      document.getElementById("rp-class").value = matchClass[1].trim();
      logThis("[OK] Class: " + matchClass[1].trim());
    } else {
      logThis("[FAILED] Class tidak ditemukan");
    }

    // E. Parse Grinding Spot
    var matchSpot = rawText.match(/(?:^|\n)[ \t]*Grinding Spot\s*:\s*(.+)/i) || rawText.match(/(?:^|\n)[ \t]*Spot\s*:\s*(.+)/i);
    if (matchSpot) {
      document.getElementById("rp-spot").value = matchSpot[1].trim();
      logThis("[OK] Grinding Spot: " + matchSpot[1].trim());
    } else {
      logThis("[FAILED] Grinding Spot tidak ditemukan");
    }

    // F. Parse Total Hours / Target seluruhnya
    if (jobType === "FARM") {
      var matchSell = rawText.match(/Sell in storage\s*:\s*(.+)/i);
      if (matchSell) {
        document.getElementById("rp-sell").value = matchSell[1].trim();
        logThis("[OK] Sell in storage: " + matchSell[1].trim());
      } else {
        logThis("[FAILED] Sell in storage tidak ditemukan");
      }

      var matchListed = rawText.match(/Listed CM \(TAX\)\s*:\s*(.+)/i);
      if (matchListed) {
        document.getElementById("rp-listed").value = matchListed[1].trim();
        logThis("[OK] Listed CM (TAX): " + matchListed[1].trim());
      } else {
        logThis("[FAILED] Listed CM (TAX) tidak ditemukan");
      }

      var matchKeep = rawText.match(/(?:^|\n)[ \t]*Keep\s*:\s*(.+)/i);
      if (matchKeep) {
        document.getElementById("rp-keep").value = matchKeep[1].trim();
        logThis("[OK] Keep: " + matchKeep[1].trim());
      } else {
        logThis("[FAILED] Keep tidak ditemukan");
      }

      var matchTotProgress = rawText.match(/Total Progress\s*:\s*(.+)/i);
      if (matchTotProgress) {
        var partsTot = matchTotProgress[1].split("/");
        document.getElementById("rp-total").value = partsTot[0].trim();
        if (partsTot[1]) document.getElementById("rp-target").value = partsTot[1].trim();
        logThis("[OK] Total Progress: " + matchTotProgress[1].trim());
      } else {
        logThis("[FAILED] Total Progress tidak ditemukan");
      }
    } else {
      var matchTotal = rawText.match(/Total\s+hours?\s*:\s*(.+)/i);
      if (matchTotal) {
        var partsTotal = matchTotal[1].split("/");
        document.getElementById("rp-total").value = partsTotal[0].trim();
        if (partsTotal[1]) document.getElementById("rp-target").value = partsTotal[1].trim();
        logThis("[OK] Total hours: " + matchTotal[1].trim());
      } else {
        logThis("[FAILED] Total hours tidak ditemukan");
      }
    }

    // G. Parse Progress
    var matchFullProg = rawText.match(/Progress\s*:\s*([^\(\n]+)(?:\(([^)]+)\))?/i);
    if (matchFullProg) {
      if (matchFullProg[1]) {
        document.getElementById("rp-progress").value = matchFullProg[1].trim();
        logThis("[OK] Progress: " + matchFullProg[1].trim());
      }
      
      if (matchFullProg[2]) {
        var insideParen = matchFullProg[2];
        var isNum = function (x) { return x !== "" && !isNaN(x.replace(/,/g, "")); };
        var splitC = function (str) {
          return str.split(/,(?!\d{3}\b)/).map(function (x) { return x.trim(); }).filter(function (x) { return x; });
        };
        var slashParts = insideParen.split("/");
        var headParts = splitC(slashParts[0]);
        var buffParts = slashParts.length > 1 ? splitC(slashParts.slice(1).join("/")).slice(1) : [];
        var firstPart = headParts.shift() || "";
        var firstTok = firstPart.split(/\s+/).filter(function (x) { return x; });
        var spotStr = firstPart;
        if (firstTok.length && firstTok[0].toUpperCase().indexOf("LS") === 0) {
          document.getElementById("rp-ls").value = firstTok[0];
          spotStr = firstTok.slice(1).join(" ") || headParts.shift() || "";
        }
        if (slashParts.length === 1) buffParts = headParts;
        if (buffParts.length) document.getElementById("rp-buff").value = buffParts.join(", ");
        var restTokens = spotStr.split(/\s+/).filter(function (x) { return x; });

        if (restTokens.length >= 2 && restTokens[restTokens.length - 1].toUpperCase() === "K" && isNum(restTokens[restTokens.length - 2])) {
          document.getElementById("rp-tl").value = restTokens.slice(-2).join(" ");
          document.getElementById("rp-p-spot").value = restTokens.slice(0, -2).join(" ");
        } else if (restTokens.length >= 2 && isNum(restTokens[restTokens.length - 1])) {
          document.getElementById("rp-tl").value = restTokens[restTokens.length - 1];
          document.getElementById("rp-p-spot").value = restTokens.slice(0, -1).join(" ");
        } else if (restTokens.length > 0) {
          document.getElementById("rp-p-spot").value = restTokens.join(" ");
        }
        logThis("[OK] Progress: " + insideParen);
      }
    } else {
      logThis("[FAILED] Progress tidak ditemukan");
    }

    // H. Parse Keterangan
    var matchKet = rawText.match(/(?:^|\n)[ \t]*Keterangan\s*:\s*\n?([\s\S]*?)(?=\n\s*(?:Class\s*:|Character\s*:|Grinding Spot\s*:|Agris[^\n:]*:|Kendala\s*:|Note\s*:|======|$))/i);
    if (matchKet) {
      var ketText = matchKet[1].trim();
      if (ketText && ketText !== "-" && !/^(?:Class|Character)\s*:/i.test(ketText)) {
        document.getElementById("rp-ket").value = ketText;
        logThis("[OK] Keterangan terbaca");
      } else {
        document.getElementById("rp-ket").value = "";
        logThis("[WARN] Keterangan kosong");
      }
    } else {
      logThis("[FAILED] Keterangan tidak ditemukan");
    }

    // I. Parse Kendala
    var matchKendala = rawText.match(/(?:^|\n)[ \t]*Kendala\s*:\s*\n?([\s\S]*?)(?=\n\s*(?:Class\s*:|Character\s*:|Grinding Spot\s*:|Agris[^\n:]*:|Keterangan\s*:|Note\s*:|======|$))/i);
    if (matchKendala) {
      var kendalaText = matchKendala[1].trim();
      if (kendalaText && kendalaText !== "-") {
        document.getElementById("rp-kendala").value = kendalaText;
        logThis("[OK] Kendala terbaca");
      } else {
        document.getElementById("rp-kendala").value = "";
        logThis("[WARN] Kendala kosong");
      }
    } else {
      logThis("[FAILED] Kendala tidak ditemukan");
    }

    // J. Parse Note
    var matchNote = rawText.match(/(?:^|\n)[ \t]*Note[ \t]*:[ \t]*\n?([\s\S]*)/i);
    if (matchNote) {
      var noteContent = matchNote[1].trim();
      if (noteContent && noteContent !== "-") {
        document.getElementById("rp-note").value = noteContent;
        logThis("[OK] Note terbaca");
      } else {
        document.getElementById("rp-note").value = "";
        logThis("[WARN] Note kosong");
      }
    } else {
      logThis("[FAILED] Note tidak ditemukan");
    }

    // K. Simpan ke localStorage
    calcLaporan();

    var storeData = readStore();
    var inputs = document.querySelectorAll("#form-laporan input, #form-laporan select, #form-laporan textarea");
    inputs.forEach(function (el) {
      if (el.id && el.id !== "rp-import-text" && el.id !== "rp-import-log") {
        if (el.value.trim() !== "") {
          storeData[el.id] = el.value;
        } else {
          delete storeData[el.id];
        }
      }
    });
    writeStore(storeData);
  };

  // Event listener button Load & Clear Import
  var btnImport = document.getElementById("btn-import-laporan");
  if (btnImport) {
    btnImport.addEventListener("click", importLaporan);
  }

  var btnClearImport = document.getElementById("clear-import");
  if (btnClearImport) {
    btnClearImport.addEventListener("click", function () {
      var importTextEl = document.getElementById("rp-import-text");
      var logEl = document.getElementById("rp-import-log");
      importTextEl.value = "";
      importTextEl.style.height = "";
      if (logEl) {
        logEl.value = "";
        logEl.style.height = "";
      }
      var storeData = readStore();
      delete storeData["rp-import-text"];
      writeStore(storeData);
      importTextEl.focus();
    });
  }

  /* 15. Pilot: Calculator */
  var CALC_SUFFIX = { k: 1e3, m: 1e6, b: 1e9, t: 1e12 };

  var calcEval = function (text) {
    var src = text.toLowerCase().replace(/,/g, "").replace(/[x×]/g, "*").replace(/÷/g, "/");
    var tokens = [];
    var i = 0;
    while (i < src.length) {
      var ch = src.charAt(i);
      if (/\s/.test(ch)) { i++; continue; }
      var m = /^(\d+\.?\d*|\.\d+)([kmbt])?/.exec(src.slice(i));
      if (m) {
        var after = src.charAt(i + m[0].length);
        if (/[a-z]/.test(after)) throw new Error("Satuan tidak dikenal: '" + after + "'");
        tokens.push({ n: Number(m[1]) * (m[2] ? CALC_SUFFIX[m[2]] : 1) });
        i += m[0].length;
      } else if ("+-*/^()%".indexOf(ch) !== -1) {
        tokens.push({ o: ch });
        i++;
      } else {
        throw new Error("Karakter tidak dikenal: '" + ch + "'");
      }
    }

    var pos = 0;
    var isOp = function (o) { return tokens[pos] && tokens[pos].o === o; };
    var expr, term, unary, power, postfix, primary;
    primary = function () {
      var t = tokens[pos];
      if (!t) throw new Error("Operasi belum lengkap");
      if (t.n !== undefined) { pos++; return t.n; }
      if (t.o === "(") {
        pos++;
        var v = expr();
        if (!isOp(")")) throw new Error("Kurung tutup ) kurang");
        pos++;
        return v;
      }
      throw new Error("Operasi tidak valid dekat '" + t.o + "'");
    };
    postfix = function () {
      var v = primary();
      while (isOp("%")) { pos++; v = v / 100; }
      return v;
    };
    power = function () {
      var b = postfix();
      if (isOp("^")) { pos++; return Math.pow(b, unary()); }
      return b;
    };
    unary = function () {
      if (isOp("-")) { pos++; return -unary(); }
      if (isOp("+")) { pos++; return unary(); }
      return power();
    };
    term = function () {
      var v = unary();
      while (isOp("*") || isOp("/")) {
        var o = tokens[pos++].o;
        var r = unary();
        if (o === "*") v *= r;
        else {
          if (r === 0) throw new Error("Tidak bisa dibagi nol");
          v /= r;
        }
      }
      return v;
    };
    expr = function () {
      var v = term();
      while (isOp("+") || isOp("-")) {
        var o = tokens[pos++].o;
        var r = term();
        v = o === "+" ? v + r : v - r;
      }
      return v;
    };

    var result = expr();
    if (pos < tokens.length) {
      var t = tokens[pos];
      throw new Error(t.o === ")" ? "Kurung buka ( kurang" : "Operasi tidak valid dekat '" + (t.o !== undefined ? t.o : t.n) + "'");
    }
    return result;
  };

  var calcFormat = function (n) {
    var r = Number(n.toPrecision(12));
    if (r === 0) r = 0;
    var full = r.toLocaleString("en-US", { maximumFractionDigits: 10 });
    var abs = Math.abs(r);
    if (abs < 1000) return full;
    var unit = abs >= 1e12 ? ["T", 1e12] : abs >= 1e9 ? ["B", 1e9] : abs >= 1e6 ? ["M", 1e6] : ["K", 1e3];
    var short = Math.round(abs / unit[1] * 100) / 100;
    return full + " (" + (r < 0 ? "-" : "") + short + " " + unit[0] + ")";
  };

  var calcCalculator = function () {
    var out = document.getElementById("pc-out");
    var text = document.getElementById("pc-in").value;
    if (!text.trim()) { out.value = ""; return; }
    try {
      var r = calcEval(text);
      if (!isFinite(r)) throw new Error("Hasil tidak valid (terlalu besar atau bukan angka)");
      out.value = calcFormat(r);
    } catch (e) {
      out.value = e.message;
    }
  };

  /* Pilot: Notepad */
  document.getElementById("pn-note").addEventListener("input", function () { fit(this); });

  document.getElementById("clear-note").addEventListener("click", function () {
    var el = document.getElementById("pn-note");
    el.value = "";
    el.dispatchEvent(new Event("input", { bubbles: true }));
    el.focus();
  });

  /* Simpan input di localStorage */
  var STORE_KEY = "bdo-game-pilot:inputs";
  var readStore = function () {
    try {
      var data = JSON.parse(localStorage.getItem(STORE_KEY) || "{}");
      return data && typeof data === "object" && !Array.isArray(data) ? data : {};
    } catch (e) {
      return {};
    }
  };
  var writeStore = function (data) {
    try {
      if (Object.keys(data).length) localStorage.setItem(STORE_KEY, JSON.stringify(data));
      else localStorage.removeItem(STORE_KEY);
    } catch (e) {}
  };

  var syncEnabled = function () {
    Array.prototype.forEach.call(document.querySelectorAll('main input[type="checkbox"][aria-controls]'), function (cb) {
      var target = document.getElementById(cb.getAttribute("aria-controls"));
      if (target) target.disabled = !cb.checked;
    });

    /* Hourly tanpa Agris: item dan patokan Agris aktif jika 100% Drop Amount dicentang */
    var hdOn = document.getElementById("h-drop-on").checked;
    document.getElementById("h-drop").disabled = !hdOn;
    document.getElementById("h-drate").disabled = !hdOn;

    /* Silver (TL & RNG): kolom nilai aktif jika opsi dicentang dan Hitung manual mati; kotak manual aktif jika keduanya dicentang */
    ["sv-o1", "sv-o2", "sv-o3", "sv-o4"].forEach(function (id) {
      var on = document.getElementById(id + "-on").checked;
      var manual = document.getElementById(id + "-m-on");
      var useManual = on && manual.checked;
      manual.disabled = !on;
      document.getElementById(id + "-m").disabled = !useManual;
      document.getElementById(id).disabled = !on || useManual;
    });
  };

  var selectDefault = function (el) {
    var o = Array.prototype.filter.call(el.options, function (x) { return x.defaultSelected; })[0];
    return o ? o.value : el.options[0].value;
  };

  var restoreInputs = function () {
    var data = readStore();
    Array.prototype.forEach.call(document.querySelectorAll("main input, main select, main textarea:not([readonly])"), function (el) {
      if (!Object.prototype.hasOwnProperty.call(data, el.id) || typeof data[el.id] !== "string") return;
      if (el.tagName === "SELECT") {
        var exists = Array.prototype.some.call(el.options, function (o) { return o.value === data[el.id]; });
        if (exists) el.value = data[el.id];
      } else if (el.type === "checkbox") {
        if (data[el.id] === "1" || data[el.id] === "0") el.checked = data[el.id] === "1";
      } else {
        el.value = data[el.id];
        if (isNumInput(el)) formatNumber(el);
      }
    });
    syncEnabled();
  };
  restoreInputs();

  document.querySelector("main").addEventListener("input", function (ev) {
    if (isNumInput(ev.target)) formatNumber(ev.target);
  }, true);

  var saveField = function (ev) {
    var el = ev.target;
    if (!el || !el.id || el.hasAttribute("data-raw") || (el.tagName !== "INPUT" && el.tagName !== "SELECT" && el.tagName !== "TEXTAREA")) return;
    var isCheck = el.type === "checkbox";
    var isSelect = el.tagName === "SELECT";
    if (ev.type === "change" && !isCheck && !isSelect) return;
    var data = readStore();
    var current = isCheck ? (el.checked ? "1" : "0") : el.value;
    var base = isCheck ? (el.defaultChecked ? "1" : "0") : isSelect ? selectDefault(el) : el.defaultValue;
    if (current === base) delete data[el.id];
    else data[el.id] = current;
    writeStore(data);
    if (isCheck) syncEnabled();
  };
  document.querySelector("main").addEventListener("input", saveField);
  document.querySelector("main").addEventListener("change", saveField);

  /* Silver: saat Hitung manual dimatikan, kolom nilai kembali ke default */
  ["sv-o1", "sv-o2", "sv-o3", "sv-o4"].forEach(function (id) {
    document.getElementById(id + "-m-on").addEventListener("change", function (ev) {
      if (ev.target.checked) return;
      var el = document.getElementById(id);
      var stored = readStore()[id];
      el.value = typeof stored === "string" ? stored : el.defaultValue;
    });
  });

  /* Live update */
  [
    ["form-stopwatch", calcStopwatch],
    ["form-hourly", calcHourly],
    ["form-agris", calcAgris],
    ["form-total", calcTotal],
    ["form-buff", calcBuff],
    ["form-tax", calcTax],
    ["form-totaltl", calcTotalTL],
    ["form-compen", calcCompen],
    ["form-silver", calcSilver],
    ["form-used", calcAgrisUsed],
    ["form-login", calcLogin],
    ["form-logout", calcLogout],
    ["form-laporan", calcLaporan],
    ["form-calc", calcCalculator]
  ].forEach(function (x) {
    var fn = x[1];
    x = [x[0], function () { try { fn(); } catch (e) { if (window.console) console.error(x[0], e); } }];
    var form = document.getElementById(x[0]);
    form.addEventListener("input", function () { x[1](); fitAll(); });
    form.addEventListener("change", function (ev) {
      if (ev.target.type === "checkbox" || ev.target.tagName === "SELECT") { x[1](); fitAll(); }
    });

    document.getElementById("reset-" + x[0].replace("form-", "")).addEventListener("click", function () {
      var data = readStore();
      Array.prototype.forEach.call(form.querySelectorAll("input, select, textarea:not([readonly])"), function (el) {
        if (el.id === "rp-import-text") return;
        if (el.tagName === "SELECT") el.value = selectDefault(el);
        else if (el.type === "checkbox") el.checked = el.defaultChecked;
        else el.value = el.defaultValue;
        delete data[el.id];
      });
      writeStore(data);
      syncEnabled();
      x[1]();
      fitAll();
    });

document.getElementById("clear-" + x[0].replace("form-", "")).addEventListener("click", function () {
      var data = readStore();
      Array.prototype.forEach.call(form.querySelectorAll("input, select, textarea:not([readonly])"), function (el) {
        if (el.id === "rp-import-text") return;
        if (el.tagName === "SELECT") {
          var hasCustom = Array.prototype.some.call(el.options, function (o) { return o.value === "custom"; });
          if (!hasCustom) return;
          el.value = "custom";
          if (el.value === selectDefault(el)) delete data[el.id];
          else data[el.id] = "custom";
          return;
        }
        if (el.type === "range") return;
        if (el.type === "checkbox") {
          el.checked = false;
          if (el.checked === el.defaultChecked) delete data[el.id];
          else data[el.id] = "0";
          return;
        }
        el.value = "";
        if (el.value === el.defaultValue) delete data[el.id];
        else data[el.id] = el.value;
      });
      writeStore(data);
      syncEnabled();
      x[1]();
      if (!/^form-(stopwatch|login|logout|laporan|calc)$/.test(x[0])) {
        Array.prototype.forEach.call(form.querySelectorAll("textarea[readonly]"), function (el) { el.value = ""; });
      }
      fitAll();
    });

    x[1]();
  });

  fitAll();
  window.addEventListener("resize", fitAll);
  document.addEventListener("toggle", fitAll, true);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitAll);
})();
</script>
