  /* Verifikasi Total TL (Claude, ChatGPT, Gemini) */
  var buildTotalTLVerifyPrompt = function () {
    var v = function (id) { return document.getElementById(id).value; };
    var useSpot = document.getElementById("tl-spot-on").checked;
    var spotEl = document.getElementById("tl-spot");
    var isCustom = spotEl.value === "custom";
    var steps = ["tl-s1", "tl-s2", "tl-s3"].map(v).filter(function (s) { return s; });
    var lines = [
      "Tolong verifikasi perhitungan Total TL (Black Desert Online) di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input:",
      "- TL awal (yang sudah ada di storage): " + v("tl-start"),
      "- TL akhir (setelah grinding selama shift): " + v("tl-end"),
      "- Harga TL (opsional): " + (useSpot
        ? (isCustom
            ? "custom, " + v("tl-custom") + " silver per TL"
            : spotEl.options[spotEl.selectedIndex].text + " silver per TL")
        : "tidak dipakai (checkbox Spot tidak dicentang)"),
      "",
      "Rumus yang dipakai:",
      "1. Total perolehan TL = TL akhir − TL awal",
      "2. Harga TL seluruhnya = total perolehan TL × harga TL (hanya jika harga TL dipakai)",
      "3. Angka besar ditampilkan juga dalam bentuk ringkas: K = ribu, M = juta, B = miliar",
      "",
      "Hasil dari tool:",
      "- Total perolehan TL: " + v("tl-out")
    ];
    if (v("tl-price")) lines.push("- Harga TL: " + v("tl-price"));
    if (v("tl-all")) lines.push("- Harga TL seluruhnya: " + v("tl-all"));
    if (steps.length) {
      lines.push("", "Langkah perhitungan dari tool:");
      steps.forEach(function (s, i) { lines.push((i + 1) + ". " + s); });
    }
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumusnya sudah benar untuk menghitung total perolehan TL dan nilai silvernya?",
      "2. Hitung ulang sendiri dari data input di atas, apakah hasilnya sama dengan hasil tool?",
      "3. Apakah format angka ringkas (K, M, B) sudah sesuai dengan angka lengkapnya?",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
  };
  document.getElementById("verify-totaltl-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildTotalTLVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });

  /* Verifikasi Silver (Claude, ChatGPT, Gemini) */
  var buildSilverVerifyPrompt = function () {
    var v = function (id) { return document.getElementById(id).value; };
    var on = function (id) { return document.getElementById(id + "-on").checked; };
    var optional = function (id, label) {
      return "- " + label + ": " + (on(id) ? v(id) : "tidak dicentang (dihitung 0)");
    };
    var optionLine = function (o) {
      var id = o[0];
      if (!on(id)) return "- " + o[1] + ": tidak dicentang (dihitung 0)";
      if (document.getElementById(id + "-m-on").checked) {
        var items = v(id + "-m").split(/\s+/).filter(function (s) { return s; });
        return "- " + o[1] + ": hitung manual, daftar angka: " +
          (items.length ? items.join(", ") : "(kosong)") +
          " (hasil penjumlahan di kolom: " + v(id) + ")";
      }
      return "- " + o[1] + ": " + v(id);
    };
    var results = [
      ["Awal shift", "sv-r1"],
      ["End shift", "sv-r2"],
      ["Selisih", "sv-r3"],
      ["Total perolehan silver", "sv-r5"],
      ["Total Progress", "sv-r6"]
    ].filter(function (r) { return v(r[1]); })
     .map(function (r) { return "- " + r[0] + ": " + v(r[1]); });
    var steps = ["sv-s1", "sv-s2", "sv-s3", "sv-s4", "sv-s5", "sv-s6"].map(v).filter(function (s) { return s; });
    var prev = v("sv-p0").trim();

    var lines = [
      "Tolong verifikasi perhitungan silver selama shift (Black Desert Online) di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input:",
      "Awal shift:",
      "- Silver di Central Market: " + v("sv-c0"),
      optional("sv-i0", "Silver di Inventory (opsional)"),
      "TL & RNG:"
    ];
    lines = lines.concat([
      ["sv-o1", "Sell in storage"],
      ["sv-o2", "Sell in Central Market (Tax)"],
      ["sv-o3", "Listed in CM (Tax)"],
      ["sv-o4", "Keep owner"]
    ].map(optionLine));
    lines.push(
      "End shift:",
      "- Silver di Central Market: " + v("sv-c1"),
      optional("sv-i1", "Silver di Inventory (opsional)"),
      "Total progress:",
      "- Total progress sebelumnya (opsional): " + (prev ? v("sv-p0") : "(kosong, dihitung 0)"),
      "- Total progress seluruhnya: " + v("sv-p1"),
      "",
      "Aturan yang dipakai tool:",
      "- Silver bisa diisi angka biasa, pemisah ribuan (koma), atau akhiran k (ribu), m (juta), b (miliar).",
      "- Silver awal dan akhir shift dijumlahkan dari Central Market dan Inventory (Inventory hanya jika dicentang), jadi perpindahan silver antara keduanya tidak memengaruhi hasil.",
      "- Opsi TL & RNG yang tidak dicentang dihitung 0. Untuk Sell in Central Market (Tax), angka yang diisi adalah harga setelah dijual (sudah dikurangi tax).",
      "- Opsi dengan hitung manual: beberapa angka dijumlahkan, satu angka per baris atau dipisah spasi. Koma adalah pemisah ribuan, bukan pemisah antar angka.",
      "- Format ringkas: B = miliar, M = juta, K = ribu.",
      "",
      "Rumus yang dipakai:",
      "1. Silver awal = silver Central Market awal + silver Inventory awal (jika dicentang)",
      "2. Silver akhir = silver Central Market akhir + silver Inventory akhir (jika dicentang)",
      "3. Selisih = silver akhir − silver awal (boleh negatif karena ada biaya seperti repair gear dan beli buff)",
      "4. Total TL & RNG = jumlah semua opsi TL & RNG yang dicentang",
      "5. Total perolehan silver = selisih + total TL & RNG",
      "6. Total progress = total progress sebelumnya + total perolehan silver, dibandingkan dengan total progress seluruhnya (format: progress / target)",
      "",
      "Hasil dari tool:"
    );
    lines = lines.concat(results);
    if (steps.length) {
      lines.push("", "Langkah perhitungan dari tool:");
      steps.forEach(function (s, i) { lines.push((i + 1) + ". " + s); });
    }
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumusnya sudah benar, termasuk penjumlahan Central Market dengan Inventory dan penjumlahan TL & RNG?",
      "2. Hitung ulang sendiri dari data input di atas (termasuk penjumlahan hitung manual), apakah hasilnya sama dengan hasil tool?",
      "3. Apakah Total Progress dan format ringkasnya (B, M, K) sudah tepat?",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
  };
  document.getElementById("verify-silver-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildSilverVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });

  /* Verifikasi Agris yang Digunakan (Claude, ChatGPT, Gemini) */
  var buildUsedVerifyPrompt = function () {
    var v = function (id) { return document.getElementById(id).value; };
    var reset = document.getElementById("au-reset").checked;
    var steps = ["au-s1", "au-s2", "au-s3"].map(v).filter(function (s) { return s; });
    var lines = [
      "Tolong verifikasi perhitungan Agris yang digunakan selama shift (Black Desert Online) di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input:",
      "- Agris awal (di awal shift): " + v("au-start"),
      "- Agris akhir (sisa setelah grinding): " + v("au-end"),
      "- Agris reset: " + (reset
        ? "dicentang, Agris sebelum reset = " + v("au-before")
        : "tidak dicentang (tidak ada reset selama shift)"),
      "",
      "Aturan yang dipakai tool:",
      "- Reset Agris menambah 20,000 Agris per hari (pukul 06:00 UTC), tetapi Agris tidak bisa melebihi batas maksimal 100,000.",
      "- Agris sebelum reset: jika reset terjadi di awal shift, diisi sama dengan Agris awal. Jika reset terjadi di tengah shift setelah sebagian Agris terpakai, diisi dengan sisa Agris saat itu.",
      "- Agris sebelum reset tidak boleh lebih besar dari Agris awal dan tidak boleh lebih dari 100,000.",
      "- Jika Agris akhir lebih besar dari total Agris yang tersedia, hasilnya menampilkan error.",
      "",
      "Rumus yang dipakai:",
      "1. Agris dari reset = min(20,000, 100,000 − Agris sebelum reset) (hanya jika reset dicentang, jika tidak 0)",
      "2. Total Agris = Agris awal + Agris dari reset",
      "3. Agris yang digunakan = total Agris − Agris akhir",
      "",
      "Hasil dari tool:",
      "- Agris yang digunakan: " + v("au-out")
    ];
    if (steps.length) {
      lines.push("", "Langkah perhitungan dari tool:");
      steps.forEach(function (s, i) { lines.push((i + 1) + ". " + s); });
    }
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumusnya sudah benar, termasuk batas maksimal 100,000 saat reset?",
      "2. Hitung ulang sendiri dari data input di atas, apakah hasilnya sama dengan hasil tool?",
      "3. Apakah validasi (Agris sebelum reset tidak boleh lebih besar dari Agris awal, dan Agris akhir tidak boleh lebih besar dari total Agris) sudah masuk akal?",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
  };
  document.getElementById("verify-used-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildUsedVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });

  /* Verifikasi Compen (Claude, ChatGPT, Gemini) */
  var buildCompenVerifyPrompt = function () {
    var v = function (id) { return document.getElementById(id).value; };
    var price = v("cp-price").trim();
    var steps = ["cp-s1", "cp-s2", "cp-s3", "cp-s4", "cp-s5", "cp-s6"].map(v).filter(function (s) { return s; });
    var lines = [
      "Tolong verifikasi perhitungan Compen (Black Desert Online) di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input:",
      "- Compen: " + v("cp-compen"),
      "- Harga TL (opsional): " + (price ? price : "(kosong, jumlah TL tidak dihitung)"),
      "- Persen TL (slider): " + v("cp-pct") + "%",
      "",
      "Aturan yang dipakai tool:",
      "- Compen dan harga TL bisa diisi angka biasa, pemisah ribuan, atau akhiran k (ribu), m (juta), b (miliar).",
      "- Slider Persen TL membagi compen antara TL dan RNG: 0% berarti semuanya RNG, 100% berarti semuanya TL. Contoh 40% TL berarti 60% RNG.",
      "- Jumlah TL yang harus disell dibulatkan ke atas supaya silver dari TL mencapai bagian compen TL.",
      "",
      "Rumus yang dipakai:",
      "1. Compen dan harga TL diubah ke silver = floor(nilai × pengali)",
      "2. Compen TL = floor(compen × persen TL ÷ 100)",
      "3. Compen RNG = compen − compen TL",
      "4. Jumlah TL = ceil(compen TL ÷ harga TL) (hanya jika harga TL diisi)",
      "5. Total silver dari TL = jumlah TL × harga TL",
      "",
      "Hasil dari tool:",
      "- Compen: " + v("cp-o1")
    ];
    if (v("cp-o2")) lines.push("- TL, Persen: " + v("cp-o2"));
    if (v("cp-o3")) lines.push("- TL, Silver: " + v("cp-o3"));
    if (v("cp-o4")) lines.push("- TL, Jumlah TL yang harus disell: " + v("cp-o4"));
    if (v("cp-o5")) lines.push("- RNG, Persen: " + v("cp-o5"));
    if (v("cp-o6")) lines.push("- RNG, Silver: " + v("cp-o6"));
    if (steps.length) {
      lines.push("", "Langkah perhitungan dari tool:");
      steps.forEach(function (s, i) { lines.push((i + 1) + ". " + s); });
    }
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumusnya sudah benar untuk membagi compen antara TL dan RNG?",
      "2. Hitung ulang sendiri dari data input di atas, apakah hasilnya sama dengan hasil tool?",
      "3. Apakah pembulatan (floor untuk silver, ceil untuk jumlah TL) sudah tepat?",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
  };
  document.getElementById("verify-compen-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildCompenVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });

  /* 2. Progress hourly tanpa Agris */
  var calcHourly = function () {
    var out = document.getElementById("h-out");
    var t = Number(readNum("h-total"));
    var p = Number(readNum("h-rate"));

    if (!t || !p || t < 0 || p <= 0) {
      out.value = "Invalid input.";
      fill("h-s", [], 5);
      return;
    }

    var totalSeconds = Math.floor((t / p) * 3600);
    var hours = Math.floor(totalSeconds / 3600);
    var minutes = Math.floor((totalSeconds % 3600) / 60);
    var seconds = totalSeconds % 60;

    out.value = hours + " Hours " + minutes + " Minutes " + seconds + " Seconds";

    fill("h-s", [
      t + " ÷ " + p + " = " + (t / p),
      "floor(" + (t / p) + " × 3600) = " + totalSeconds,
      "floor(" + totalSeconds + " ÷ 3600) = " + hours,
      "floor((" + totalSeconds + " mod 3600) ÷ 60) = " + minutes,
      totalSeconds + " mod 60 = " + seconds
    ], 5);
  };

  /* 3. Progress hourly dengan Agris */
  var calcAgris = function () {
    var out = document.getElementById("a-out");
    var withA = document.getElementById("a-with");
    var withoutA = document.getElementById("a-without");
    var totalTL = Number(readNum("a-total"));
    var agrisRate = Number(readNum("a-rate"));
    var agrisCostPerHour = Number(readNum("a-cost"));
    var normalRate = Number(readNum("a-normal"));
    var currentAgris = Number(readNum("a-current"));

    if (!totalTL || !agrisRate || !agrisCostPerHour || !normalRate || totalTL < 0 || agrisRate <= 0 || agrisCostPerHour <= 0 || normalRate <= 0) {
      out.value = "Invalid input.";
      withA.value = "";
      withoutA.value = "";
      fill("a-s", [], 5);
      fill("a-t", [], 4);
      fill("a-w", [], 4);
      fill("a-o", [], 4);
      return;
    }

    var maxAgrisHours = currentAgris / agrisCostPerHour;
    var maxAgrisTL = maxAgrisHours * agrisRate;

    var agrisTL = 0;
    var normalTL = 0;
    var hoursWithAgris = 0;
    var hoursWithoutAgris = 0;

    if (totalTL <= maxAgrisTL) {
      agrisTL = totalTL;
      hoursWithAgris = agrisTL / agrisRate;
    } else {
      agrisTL = maxAgrisTL;
      normalTL = totalTL - maxAgrisTL;
      hoursWithAgris = maxAgrisHours;
      hoursWithoutAgris = normalTL / normalRate;
    }

    var formatHours = function (h) {
      var totalSecs = Math.floor(h * 3600);
      var hrs = Math.floor(totalSecs / 3600);
      var mins = Math.floor((totalSecs % 3600) / 60);
      var secs = totalSecs % 60;
      return hrs + " Hours " + mins + " Minutes " + secs + " Seconds";
    };

    var totalSeconds = Math.floor((hoursWithAgris + hoursWithoutAgris) * 3600);
    var hours = Math.floor(totalSeconds / 3600);
    var minutes = Math.floor((totalSeconds % 3600) / 60);
    var seconds = totalSeconds % 60;

    out.value = hours + " Hours " + minutes + " Minutes " + seconds + " Seconds";
    withA.value = formatHours(hoursWithAgris);
    withoutA.value = formatHours(hoursWithoutAgris);

    var breakdown = function (h) {
      var secs = Math.floor(h * 3600);
      return [
        "floor(" + h + " × 3600) = " + secs,
        "floor(" + secs + " ÷ 3600) = " + Math.floor(secs / 3600),
        "floor((" + secs + " mod 3600) ÷ 60) = " + Math.floor((secs % 3600) / 60),
        secs + " mod 60 = " + (secs % 60)
      ];
    };
    var enough = totalTL <= maxAgrisTL;

    var l4 = document.getElementById("a-l4");
    l4.textContent = enough
      ? "Total TL dibagi TL/hr dengan Agris "
      : "(Total TL dikurangi Maks TL Agris) dibagi TL/hr tanpa Agris ";
    var l4b = document.createElement("strong");
    l4b.textContent = enough ? "(waktu with Agris, dalam jam)" : "(waktu without Agris, dalam jam)";
    l4.appendChild(l4b);
    fill("a-s", [
      currentAgris + " ÷ " + agrisCostPerHour + " = " + maxAgrisHours,
      maxAgrisHours + " × " + agrisRate + " = " + maxAgrisTL,
      totalTL + (enough ? " ≤ " : " > ") + maxAgrisTL,
      enough
        ? totalTL + " ÷ " + agrisRate + " = " + hoursWithAgris
        : "(" + totalTL + " − " + maxAgrisTL + ") ÷ " + normalRate + " = " + hoursWithoutAgris,
      hoursWithAgris + " + " + hoursWithoutAgris + " = " + (hoursWithAgris + hoursWithoutAgris)
    ], 5);
    fill("a-t", breakdown(hoursWithAgris + hoursWithoutAgris), 4);
    fill("a-w", breakdown(hoursWithAgris), 4);
    fill("a-o", breakdown(hoursWithoutAgris), 4);
  };

  /* 4. Total progress hourly */
  var calcTotal = function () {
    var out = document.getElementById("t-out");
    var p = function (s) {
      return Array.from(s.matchAll(/(\d+)\s*([hm])/gi)).reduce(function (a, m) {
        return a + (m[2].toLowerCase() === "h" ? Number(m[1]) * 60 : Number(m[1]));
      }, 0);
    };

    var explain = function (s) {
      var terms = [];
      var sum = 0;
      Array.from(s.matchAll(/(\d+)\s*([hm])/gi)).forEach(function (m) {
        var isHour = m[2].toLowerCase() === "h";
        sum += isHour ? Number(m[1]) * 60 : Number(m[1]);
        terms.push(isHour ? m[1] + " × 60" : m[1]);
      });
      var expr = terms.join(" + ");
      return (expr === String(sum) || !terms.length ? "" : expr + " = ") + sum;
    };

    var i = document.getElementById("t-prev").value.replace(/,/g, "");
    if (!i) { out.value = ""; fill("t-s", [], 5); return; }

    var x = document.getElementById("t-now").value.replace(/,/g, "");
    if (!x) { out.value = ""; fill("t-s", [], 5); return; }

    var totalMinutes = p(i) + p(x);
    var hours = Math.floor(totalMinutes / 60);
    var minutes = totalMinutes % 60;

    out.value = hours + " H " + minutes + " M";

    fill("t-s", [
      explain(i),
      explain(x),
      p(i) + " + " + p(x) + " = " + totalMinutes,
      "floor(" + totalMinutes + " ÷ 60) = " + hours,
      totalMinutes + " mod 60 = " + minutes
    ], 5);
  };
  /* 5. Buff counter */
  var DURATION_UNITS = { h: 3600, m: 60, s: 1 };
  var PRICE_SUFFIXES = { k: 1000, m: 1000000, b: 1000000000 };
  var MAX_SECONDS = 1e6;

  var asciiDigits = function (text) {
    return Array.from(text).map(function (ch) {
      var cp = ch.codePointAt(0);
      if (cp < 128 || !/^\p{Nd}$/u.test(ch)) return ch;
      var start = cp;
      while (/^\p{Nd}$/u.test(String.fromCodePoint(start - 1))) start--;
      return String((cp - start) % 10);
    }).join("");
  };
  var pyFloat = function (text) {
    var t = asciiDigits(text.trim());
    if (/^[+-]?(inf|infinity)$/i.test(t)) return t.charAt(0) === "-" ? -Infinity : Infinity;
    if (/^[+-]?nan$/i.test(t)) return NaN;
    return /^[+-]?(\d+\.?\d*|\.\d+)(e[+-]?\d+)?$/.test(t) ? Number(t) : NaN;
  };
  var pyRound = function (x) {
    var r = Math.round(x);
    return (Math.abs(x % 1) === 0.5 && r % 2 !== 0) ? r - 1 : r;
  };

  var parseDuration = function (text, defaultUnit, label, allowZero) {
    var cleaned = text.trim().toLowerCase().replace(/[,_]/g, "");
    if (!cleaned) throw new Error("missing " + label);

    var unit = defaultUnit;
    var last = cleaned.charAt(cleaned.length - 1);
    if (DURATION_UNITS.hasOwnProperty(last)) {
      unit = last;
      cleaned = cleaned.slice(0, -1);
    }

    var value = pyFloat(cleaned);
    if (isNaN(value)) throw new Error("'" + text + "' is not a valid " + label);
    var seconds = value * DURATION_UNITS[unit];

    if (!isFinite(seconds)) throw new Error("'" + text + "' is not a valid " + label);
    if (allowZero) {
      if (seconds < 0) throw new Error(label + " cannot be negative");
    } else if (seconds <= 0) {
      throw new Error(label + " must be greater than zero");
    }
    if (seconds > MAX_SECONDS) throw new Error(label + " is too large");
    return { value: value, mult: DURATION_UNITS[unit], seconds: seconds };
  };

  var parsePrice = function (text) {
    var cleaned = text.trim().toLowerCase().replace(/[,_]/g, "");
    if (!cleaned) throw new Error("missing price");

    var mult = 1;
    var last = cleaned.charAt(cleaned.length - 1);
    if (PRICE_SUFFIXES.hasOwnProperty(last)) {
      mult = PRICE_SUFFIXES[last];
      cleaned = cleaned.slice(0, -1);
    }

    var value = pyFloat(cleaned);
    if (isNaN(value)) throw new Error("'" + text + "' is not a valid price");
    var price = value * mult;

    if (!isFinite(price)) throw new Error("'" + text + "' is not a valid price");
    if (price <= 0) throw new Error("price must be greater than zero");
    if (price > 1e15) throw new Error("price is too large");
    return { value: value, mult: mult, price: BigInt(Math.trunc(price)) };
  };

  var fmtDuration = function (seconds) {
    var total = pyRound(seconds);
    var hours = Math.floor(total / 3600);
    var rem = total % 3600;
    var minutes = Math.floor(rem / 60);
    var secs = rem % 60;
    var parts = [];
    if (hours) parts.push(hours + "h");
    if (minutes) parts.push(minutes + "m");
    if (secs || !parts.length) parts.push(secs + "s");
    return parts.join(" ");
  };

  var calcBuff = function () {
    var outs = ["b-o1", "b-o2", "b-o3", "b-o4"].map(function (id) {
      return document.getElementById(id);
    });
    var clearAll = function (message) {
      outs[0].value = message;
      outs[1].value = "";
      outs[2].value = "";
      outs[3].value = "";
      fill("b-s", [], 9);
    };

    var shift, duration, cooldown, priceText, price, cycle, ratio, count;
    try {
      shift = parseDuration(document.getElementById("b-shift").value, "h", "shift length", false);
      duration = parseDuration(document.getElementById("b-duration").value, "m", "buff duration", false);
      cooldown = parseDuration(document.getElementById("b-cooldown").value, "s", "cooldown", true);
      priceText = document.getElementById("b-price").value;
      price = priceText.trim() ? parsePrice(priceText) : null;

      cycle = duration.seconds + cooldown.seconds;
      ratio = shift.seconds / cycle;
      if (!isFinite(ratio)) throw new Error("result is too large");
      count = Math.max(1, Math.ceil(ratio));
    } catch (e) {
      clearAll(e.message);
      return;
    }

    var countStr = BigInt(count).toString();

    outs[0].value = fmtDuration(shift.seconds);
    outs[1].value = fmtDuration(duration.seconds) + " duration + " +
      fmtDuration(cooldown.seconds) + " cooldown (one buff covers " + fmtDuration(cycle) + ")";
    outs[2].value = countStr + " " + (count === 1 ? "buff" : "buffs");
    outs[3].value = price
      ? countStr + " x " + price.price.toLocaleString("en-US") + " = " +
        (BigInt(count) * price.price).toLocaleString("en-US") + " silver"
      : "";

    var lines = [
      shift.value + " × " + shift.mult + " = " + shift.seconds,
      duration.value + " × " + duration.mult + " = " + duration.seconds,
      cooldown.value + " × " + cooldown.mult + " = " + cooldown.seconds,
      duration.seconds + " + " + cooldown.seconds + " = " + cycle,
      shift.seconds + " ÷ " + cycle + " = " + ratio,
      "ceil(" + ratio + ") = " + BigInt(Math.ceil(ratio)).toString(),
      "max(1, " + BigInt(Math.ceil(ratio)).toString() + ") = " + countStr
    ];
    if (price) {
      lines.push("floor(" + price.value + " × " + price.mult + ") = " + price.price.toString());
      lines.push(countStr + " × " + price.price.toString() + " = " + (BigInt(count) * price.price).toString());
    }
    fill("b-s", lines, 9);
  };

  /* 6. BDO tax calculator */
  var TAX_BASE = 0.65;
  var TAX_VP = 0.30;
  var TAX_RING = 0.05;
  var TAX_FAME = { 1: 0.005, 2: 0.010, 3: 0.015 };
  var TAX_FAME_PCT = { 1: "0.5%", 2: "1.0%", 3: "1.5%" };
  var TAX_SUFFIXES = { k: 1000, m: 1000000, b: 1000000000, t: 1000000000000 };

  var fameTier = function (points) {
    if (points >= 7000n) return 3;
    if (points >= 4000n) return 2;
    if (points >= 1000n) return 1;
    return 0;
  };

  var parseTaxPrice = function (text) {
    var cleaned = text.trim().toLowerCase().replace(/[,_]/g, "");
    if (!cleaned) throw new Error("missing price");

    var mult = 1;
    var last = cleaned.charAt(cleaned.length - 1);
    if (TAX_SUFFIXES.hasOwnProperty(last)) {
      mult = TAX_SUFFIXES[last];
      cleaned = cleaned.slice(0, -1);
    }

    var value = pyFloat(cleaned);
    if (isNaN(value)) throw new Error("'" + text + "' is not a valid price");
    var price = value * mult;

    if (isNaN(price)) throw new Error("'" + text + "' is not a valid price");
    if (price <= 0) throw new Error("price must be greater than zero");
    if (price > 1e15) throw new Error("price is too large");
    return { value: value, mult: mult, price: Math.trunc(price) };
  };

  var parseTaxFlags = function (tokens) {
    var o = { vp: false, ring: false, fame: 0, famePoints: null };
    tokens.forEach(function (raw) {
      var token = raw.trim().toLowerCase();
      if (token === "vp") {
        o.vp = true;
      } else if (token === "ring") {
        o.ring = true;
      } else if (token === "fame1" || token === "fame2" || token === "fame3") {
        o.fame = Number(token.charAt(token.length - 1));
        o.famePoints = null;
      } else if (/^\p{Nd}+$/u.test(token)) {
        o.famePoints = BigInt(asciiDigits(token));
        o.fame = fameTier(o.famePoints);
      } else {
        throw new Error("unknown option '" + token + "' \u2014 use: vp, ring, fame1, fame2, fame3, " +
          "or your Family Fame points (e.g. 4500)");
      }
    });
    return o;
  };

  var taxBreakdown = function (price, vp, ring, fame, famePoints) {
    var profit = price * TAX_BASE;
    var vpBonus = vp ? profit * TAX_VP : 0;
    var ringBonus = ring ? profit * TAX_RING : 0;
    var fameBonus = fame ? profit * TAX_FAME[fame] : 0;
    var total = profit + vpBonus + ringBonus + fameBonus;
    return {
      price: price, tax: price - profit, profit: profit,
      vp: vpBonus, ring: ringBonus, fameBonus: fameBonus, fame: fame, famePoints: famePoints,
      total: total, rate: total / price
    };
  };

  var money = function (value) { return pyRound(value).toLocaleString("en-US"); };

  var put = function (id, text) {
    if (!id) return;
    var el = document.getElementById(id);
    var row = el.parentNode;
    var prev = row.previousElementSibling;
    var pair = prev && prev.firstElementChild && prev.firstElementChild.htmlFor === id ? prev : null;
    el.value = text === null ? "" : text;
    row.hidden = text === null;
    if (pair) pair.hidden = text === null;
  };

  var showTaxOut = function (ids, r) {
    put(ids.price, money(r.price));
    put(ids.tax, "-" + money(r.tax));
    put(ids.profit, money(r.profit));
    put(ids.vp, r.vp ? "+" + money(r.vp) : null);
    put(ids.ring, r.ring ? "+" + money(r.ring) : null);
    if (r.fameBonus) {
      document.getElementById("d-l6").textContent = "Family Fame (" +
        (r.famePoints !== null ? r.famePoints.toLocaleString("en-US") + " pts, " : "") +
        "+" + TAX_FAME_PCT[r.fame] + "):";
      put(ids.fame, "+" + money(r.fameBonus));
    } else if (r.famePoints !== null) {
      document.getElementById("d-l6").textContent = "Family Fame (" +
        r.famePoints.toLocaleString("en-US") + " pts):";
      put(ids.fame, "no bonus (below 1000)");
    } else {
      put(ids.fame, null);
    }
    put(ids.receive, money(r.total) + " (" + (r.rate * 100).toFixed(2) + "%)");
  };

  var showTaxSteps = function (ids, r, parsed) {
    var pctText = TAX_FAME[r.fame];
    put(ids.price, parsed ? "floor(" + parsed.value + " × " + parsed.mult + ") = " + r.price : null);
    put(ids.profit, r.price + " × " + TAX_BASE + " = " + r.profit);
    put(ids.tax, r.price + " − " + r.profit + " = " + r.tax);
    put(ids.vp, r.vp ? r.profit + " × " + TAX_VP + " = " + r.vp : null);
    put(ids.ring, r.ring ? r.profit + " × " + TAX_RING + " = " + r.ring : null);
    var pts = r.famePoints;
    put(ids.points, pts !== null
      ? pts.toString() + (pts >= 7000n ? " ≥ 7000" : pts >= 4000n ? " ≥ 4000" : pts >= 1000n ? " ≥ 1000" : " < 1000")
      : null);
    put(ids.fame, r.fameBonus ? r.profit + " × " + pctText + " = " + r.fameBonus : null);
    var terms = [String(r.profit)];
    if (r.vp) terms.push(String(r.vp));
    if (r.ring) terms.push(String(r.ring));
    if (r.fameBonus) terms.push(String(r.fameBonus));
    put(ids.total, terms.length > 1 ? terms.join(" + ") + " = " + r.total : null);
    put(ids.rate, r.total + " ÷ " + r.price + " = " + r.rate);
    put(ids.pct, r.rate + " × 100 = " + (r.rate * 100));
  };

  var OUT1 = { price: "d-o1", tax: "d-o2", profit: "d-o3", vp: "d-o4", ring: "d-o5", fame: "d-o6", receive: "d-o7" };
  var OUT2 = { price: "d-p1", tax: "d-p2", profit: "d-p3", vp: "d-p4", ring: null, fame: null, receive: "d-p5" };
  var STP1 = { price: "d-s1", profit: "d-s2", tax: "d-s3", vp: "d-s4", ring: "d-s5", points: "d-s6", fame: "d-s7", total: "d-s8", rate: "d-s9", pct: "d-s10" };
  var STP2 = { price: null, profit: "d-t1", tax: "d-t2", vp: "d-t3", ring: null, points: null, fame: null, total: "d-t4", rate: "d-t5", pct: "d-t6" };

  var calcTax = function () {
    var parsed, options, r1, r2 = null;
    try {
      parsed = parseTaxPrice(document.getElementById("d-price").value);
      options = parseTaxFlags(document.getElementById("d-options").value.split(/\s+/).filter(function (t) { return t; }));
      if (parsed.price === 0) throw new Error("price must be greater than zero");
    } catch (e) {
      Object.keys(OUT1).forEach(function (k) { put(OUT1[k], null); });
      Object.keys(OUT2).forEach(function (k) { put(OUT2[k], null); });
      Object.keys(STP1).forEach(function (k) { put(STP1[k], null); });
      Object.keys(STP2).forEach(function (k) { put(STP2[k], null); });
      put(OUT1.price, e.message);
      document.getElementById("d-out2").hidden = true;
      document.getElementById("d-stp2").hidden = true;
      return;
    }

    var noFlags = !options.vp && !options.ring && !options.fame && options.famePoints === null;
    if (noFlags) {
      r1 = taxBreakdown(parsed.price, false, false, 0, null);
      r2 = taxBreakdown(parsed.price, true, false, 0, null);
    } else {
      r1 = taxBreakdown(parsed.price, options.vp, options.ring, options.fame, options.famePoints);
    }

    showTaxOut(OUT1, r1);
    showTaxSteps(STP1, r1, parsed);
    document.getElementById("d-out2").hidden = !noFlags;
    document.getElementById("d-stp2").hidden = !noFlags;
    if (noFlags) {
      showTaxOut(OUT2, r2);
      showTaxSteps(STP2, r2, null);
    }
  };

  /* 7. Total TL */
  var calcTotalTL = function () {
    var out = document.getElementById("tl-out");
    var useSpot = document.getElementById("tl-spot-on").checked;
    var spot = document.getElementById("tl-spot").value;
    var isCustom = spot === "custom";
    document.getElementById("tl-custom").disabled = !useSpot;
    document.getElementById("tl-custom-row").hidden = !(useSpot && isCustom);

    var hidePrice = function () {
      put("tl-price", null);
      put("tl-all", null);
      put("tl-s2", null);
      put("tl-s3", null);
    };

    var a = readNum("tl-start");
    var b = readNum("tl-end");

    if (a === "" || b === "" || Number(a) < 0 || Number(b) < 0) {
      out.value = "Invalid input.";
      hidePrice();
      put("tl-s1", null);
      return;
    }

    var start = Number(a);
    var end = Number(b);
    var gain = end - start;
    out.value = gain.toLocaleString("en-US");
    put("tl-s1", end + " − " + start + " = " + gain);

    if (!useSpot) {
      hidePrice();
      return;
    }

    var priceText = isCustom ? readNum("tl-custom") : spot;
    var price = Number(priceText);

    if (priceText === "" || !(price > 0) || !isFinite(price) || !isFinite(gain)) {
      put("tl-price", isCustom ? "Isi harga TL" : null);
      put("tl-all", null);
      put("tl-s2", null);
      put("tl-s3", null);
      return;
    }

    var all = BigInt(Math.round(gain)) * BigInt(Math.round(price));
    var compact = compactSilver(all);
    var full = all.toLocaleString("en-US");

    put("tl-price", price.toLocaleString("en-US") + " silver");
    put("tl-all", compact === full ? full + " silver" : full + " silver (" + compact + ")");
    put("tl-s2", String(price));
    put("tl-s3", gain + " × " + price + " = " + all);
  };

  /* 8. Compen */
  var parseSilver = function (text, label, allowZero) {
    var cleaned = text.trim().toLowerCase().replace(/[,_]/g, "");
    if (!cleaned) throw new Error("missing " + label);

    var mult = 1;
    var last = cleaned.charAt(cleaned.length - 1);
    if (PRICE_SUFFIXES.hasOwnProperty(last)) {
      mult = PRICE_SUFFIXES[last];
      cleaned = cleaned.slice(0, -1);
    }

    var value = pyFloat(cleaned);
    if (isNaN(value)) throw new Error("'" + text + "' is not a valid " + label);
    var amount = value * mult;

    if (!isFinite(amount)) throw new Error("'" + text + "' is not a valid " + label);
    if (allowZero) {
      if (amount < 0) throw new Error(label + " cannot be negative");
    } else if (amount <= 0) {
      throw new Error(label + " must be greater than zero");
    }
    if (amount > 1e15) throw new Error(label + " is too large");
    var whole = BigInt(Math.trunc(amount));
    if (!allowZero && whole === 0n) throw new Error(label + " must be greater than zero");
    return { value: value, mult: mult, amount: whole };
  };

  var calcCompen = function () {
    var outs = ["cp-o1", "cp-o2", "cp-o3", "cp-o4", "cp-o5", "cp-o6"];
    var steps = ["cp-s1", "cp-s2", "cp-s3", "cp-s4", "cp-s5", "cp-s6"];
    var groups = [document.getElementById("cp-tl"), document.getElementById("cp-rng")];
    var compen, price;

    try {
      compen = parseSilver(document.getElementById("cp-compen").value, "compen");
      var priceText = document.getElementById("cp-price").value;
      price = priceText.trim() ? parseSilver(priceText, "TL price") : null;
    } catch (e) {
      outs.forEach(function (id) { put(id, null); });
      steps.forEach(function (id) { put(id, null); });
      groups.forEach(function (g) { g.hidden = true; });
      put("cp-o1", e.message);
      return;
    }

    var pct = Math.min(100, Math.max(0, Number(document.getElementById("cp-pct").value) || 0));
    var total = compen.amount;
    var tlSilver = total * BigInt(pct) / 100n;
    var rngSilver = total - tlSilver;
    var count = price ? (tlSilver + price.amount - 1n) / price.amount : null;
    var silver = function (v) { return v.toLocaleString("en-US") + " silver"; };

    groups.forEach(function (g) { g.hidden = false; });
    put("cp-o1", silver(total));
    put("cp-o2", pct + "%");
    put("cp-o3", silver(tlSilver));
    put("cp-o4", count === null ? null : count.toLocaleString("en-US") + " TL");
    put("cp-o5", (100 - pct) + "%");
    put("cp-o6", silver(rngSilver));

    put("cp-s1", "floor(" + compen.value + " × " + compen.mult + ") = " + total);
    put("cp-s2", price ? "floor(" + price.value + " × " + price.mult + ") = " + price.amount : null);
    put("cp-s3", "floor(" + total + " × " + pct + " ÷ 100) = " + tlSilver);
    put("cp-s4", total + " − " + tlSilver + " = " + rngSilver);
    put("cp-s5", price ? "ceil(" + tlSilver + " ÷ " + price.amount + ") = " + count : null);
    put("cp-s6", price ? count + " × " + price.amount + " = " + (count * price.amount) : null);
  };

  /* 9. Silver */
  var compactSilver = function (big) {
    var neg = big < 0n;
    var abs = neg ? -big : big;
    var units = [["B", 1000000000n], ["M", 1000000n], ["K", 1000n]];
    var pick = -1;
    for (var i = 0; i < units.length; i++) {
      if (abs >= units[i][1]) { pick = i; break; }
    }
    if (pick === -1) return (neg ? "-" : "") + abs;
    var scale = function (k) { return (abs * 100n + units[k][1] / 2n) / units[k][1]; };
    var scaled = scale(pick);
    if (scaled >= 100000n && pick > 0) {
      pick -= 1;
      scaled = scale(pick);
    }
    var text = (scaled / 100n).toString();
    var frac = scaled % 100n;
    if (frac !== 0n) text += "." + frac.toString().padStart(2, "0").replace(/0+$/, "");
    return (neg ? "-" : "") + text + " " + units[pick][0];
  };

  var silverText = function (v) {
    var c = compactSilver(v);
    var n = v.toLocaleString("en-US");
    return c === n ? n + " silver" : n + " silver (" + c + ")";
  };

  var calcSilver = function () {
    var stepIds = ["sv-s1", "sv-s2", "sv-s3", "sv-s4", "sv-s5", "sv-s6"];
    var cmpIds = ["sv-r1", "sv-r2", "sv-r3", "sv-r4"];
    var cmpBox = document.getElementById("sv-cmp");
    var isOn = function (id) { return document.getElementById(id + "-on").checked; };
    var text = function (id) { return document.getElementById(id).value; };
    var sum = function (list) { return list.reduce(function (a, b) { return a + b; }, 0n); };
    var line = function (list) { return (list.length > 1 ? list.join(" + ") + " = " : "") + sum(list); };
    var mark = function (up, down) {
      ["sv-r3", "sv-r4"].forEach(function (id) {
        var el = document.getElementById(id);
        el.classList.toggle("up", up);
        el.classList.toggle("down", down);
      });
    };

    var startTerms = [];
    var endTerms = [];
    var optTerms = [];
    var optParts = [];

    try {
      startTerms.push(parseSilver(text("sv-c0"), "central market silver (awal)", true).amount);
      if (isOn("sv-i0")) startTerms.push(parseSilver(text("sv-i0"), "inventory silver (awal)", true).amount);

      [["sv-o1", "sell in storage"], ["sv-o2", "sell in central market (sudah tax)"], ["sv-o3", "listed in cm (sudah tax)"], ["sv-o4", "keep owner"]].forEach(function (o) {
        if (!isOn(o[0])) return;
        if (document.getElementById(o[0] + "-m-on").checked) {
          var entries = text(o[0] + "-m").split(/\s+/).filter(function (s) { return s; });
          if (!entries.length) throw new Error("missing " + o[1] + " (manual)");
          var amounts = entries.map(function (s) { return parseSilver(s, o[1] + " (manual)", true).amount; });
          var manualSum = sum(amounts);
          document.getElementById(o[0]).value = manualSum.toLocaleString("en-US");
          optTerms.push(manualSum);
          optParts.push(amounts.length > 1 ? "(" + amounts.join(" + ") + ")" : String(manualSum));
        } else {
          var one = parseSilver(text(o[0]), o[1], true).amount;
          optTerms.push(one);
          optParts.push(String(one));
        }
      });

      endTerms.push(parseSilver(text("sv-c1"), "central market silver (akhir)", true).amount);
      if (isOn("sv-i1")) endTerms.push(parseSilver(text("sv-i1"), "inventory silver (akhir)", true).amount);
    } catch (e) {
      cmpIds.forEach(function (id) { put(id, null); });
      cmpBox.hidden = true;
      mark(false, false);
      put("sv-r6", null);
      stepIds.forEach(function (id) { put(id, null); });
      put("sv-r5", e.message);
      return;
    }

    var prev = 0n;
    var target = 0n;
    var progressError = null;
    try {
      var prevText = text("sv-p0");
      prev = prevText.trim() ? parseSilver(prevText, "total progress sebelumnya", true).amount : 0n;
      target = parseSilver(text("sv-p1"), "total progress keseluruhan", false).amount;
    } catch (e) {
      progressError = e.message;
    }

    var startTotal = sum(startTerms);
    var endTotal = sum(endTerms);
    var diff = endTotal - startTotal;
    var optTotal = sum(optTerms);
    var gain = diff + optTotal;
    var up = diff > 0n;
    var down = diff < 0n;

    cmpBox.hidden = false;
    put("sv-r1", silverText(startTotal));
    put("sv-r2", silverText(endTotal));
    put("sv-r3", up ? "+" + silverText(diff).replace(" (", " (+") : silverText(diff));
    put("sv-r4", up
      ? "Silver bertambah. Cek apakah ada aktivitas di luar grinding (wajib tanyakan mod, jangan buat keputusan sendiri), yang ikut menambah total perolehan silver"
      : down
        ? "Silver berkurang. Wajar karena ada biaya saat atau sebelum grinding, seperti repair gear dan beli buff"
        : "Silver tidak berubah. Tolong hitung lagi, biaya buff (jika beli buff) maupun biaya repair gear saat grinding seharusnya masuk di perhitungan");
    mark(up, down);
    put("sv-r5", silverText(gain));
    put("sv-r6", progressError !== null ? progressError : compactSilver(prev + gain) + " / " + compactSilver(target));

    put("sv-s1", line(startTerms));
    put("sv-s2", line(endTerms));
    put("sv-s3", endTotal + " − " + startTotal + " = " + diff);
    var optText = optParts.join(" + ");
    put("sv-s4", optTerms.length ? (optText === String(optTotal) ? optText : optText + " = " + optTotal) : null);
    put("sv-s5", diff + " + " + optTotal + " = " + gain);
    put("sv-s6", progressError === null ? prev + " + " + gain + " = " + (prev + gain) : null);
  };

  /* 10. Agris yang Digunakan */
  var AGRIS_RESET = 20000;
  var AGRIS_MAX = 100000;

  var calcAgrisUsed = function () {
    var a = readNum("au-start");
    var b = readNum("au-end");
    var reset = document.getElementById("au-reset").checked;
    var c = reset ? readNum("au-before") : "0";
    var steps = ["au-s1", "au-s2", "au-s3"];

    var fail = function (message) {
      put("au-out", message);
      steps.forEach(function (id) { put(id, null); });
    };

    if (a === "" || b === "" || c === "" ||
        Number(a) < 0 || Number(b) < 0 || Number(c) < 0 ||
        !isFinite(Number(a)) || !isFinite(Number(b)) || !isFinite(Number(c))) {
      fail("Invalid input.");
      return;
    }

    var start = Number(a);
    var end = Number(b);
    var before = Number(c);

    if (reset && before > start) {
      fail("Agris sebelum reset tidak boleh lebih besar dari agris awal");
      return;
    }
    if (reset && before > AGRIS_MAX) {
      fail("Agris sebelum reset tidak boleh lebih dari " + AGRIS_MAX.toLocaleString("en-US"));
      return;
    }

    var gain = reset ? Math.min(AGRIS_RESET, AGRIS_MAX - before) : 0;
    var total = start + gain;
    var used = total - end;

    put("au-s1", reset ? "min(" + AGRIS_RESET + ", " + AGRIS_MAX + " − " + before + ") = " + gain : null);
    put("au-s2", reset ? start + " + " + gain + " = " + total : String(total));

    if (used < 0) {
      put("au-out", "Agris akhir lebih besar dari total agris");
      put("au-s3", null);
      return;
    }

    put("au-out", used.toLocaleString("en-US"));
    put("au-s3", total + " − " + end + " = " + used);
  };

  /* Simpan input di localStorage (hanya nilai yang berbeda dari default) */
  var STORE_KEY = "bdo-game-pilot:inputs";
  var readStore = function () {
    try {
      var data = JSON.parse(localStorage.getItem(STORE_KEY) || "{}");
      return data && typeof data === "object" && !Array.isArray(data) ? data : {};
    } catch (e) {
      return {};
    }
  };
  var writeStore = function (data) {
    try {
      if (Object.keys(data).length) localStorage.setItem(STORE_KEY, JSON.stringify(data));
      else localStorage.removeItem(STORE_KEY);
    } catch (e) {}
  };

  var syncEnabled = function () {
    Array.prototype.forEach.call(document.querySelectorAll('main input[type="checkbox"][aria-controls]'), function (cb) {
      var target = document.getElementById(cb.getAttribute("aria-controls"));
      if (target) target.disabled = !cb.checked;
    });
    /* Silver (TL & RNG): kolom nilai aktif jika opsi dicentang dan Hitung manual mati; kotak manual aktif jika keduanya dicentang */
    ["sv-o1", "sv-o2", "sv-o3", "sv-o4"].forEach(function (id) {
      var on = document.getElementById(id + "-on").checked;
      var manual = document.getElementById(id + "-m-on");
      var useManual = on && manual.checked;
      manual.disabled = !on;
      document.getElementById(id + "-m").disabled = !useManual;
      document.getElementById(id).disabled = !on || useManual;
    });
  };

  var selectDefault = function (el) {
    var o = Array.prototype.filter.call(el.options, function (x) { return x.defaultSelected; })[0];
    return o ? o.value : el.options[0].value;
  };

  var restoreInputs = function () {
    var data = readStore();
    Array.prototype.forEach.call(document.querySelectorAll("main input, main select, main textarea:not([readonly])"), function (el) {
      if (!Object.prototype.hasOwnProperty.call(data, el.id) || typeof data[el.id] !== "string") return;
      if (el.tagName === "SELECT") {
        var exists = Array.prototype.some.call(el.options, function (o) { return o.value === data[el.id]; });
        if (exists) el.value = data[el.id];
      } else if (el.type === "checkbox") {
        if (data[el.id] === "1" || data[el.id] === "0") el.checked = data[el.id] === "1";
      } else {
        el.value = data[el.id];
        if (isNumInput(el)) formatNumber(el);
      }
    });
    syncEnabled();
  };
  restoreInputs();

  document.querySelector("main").addEventListener("input", function (ev) {
    if (isNumInput(ev.target)) formatNumber(ev.target);
  }, true);

  var saveField = function (ev) {
    var el = ev.target;
    if (!el || !el.id || (el.tagName !== "INPUT" && el.tagName !== "SELECT" && el.tagName !== "TEXTAREA")) return;
    var isCheck = el.type === "checkbox";
    var isSelect = el.tagName === "SELECT";
    if (ev.type === "change" && !isCheck && !isSelect) return;
    var data = readStore();
    var current = isCheck ? (el.checked ? "1" : "0") : el.value;
    var base = isCheck ? (el.defaultChecked ? "1" : "0") : isSelect ? selectDefault(el) : el.defaultValue;
    if (current === base) delete data[el.id];
    else data[el.id] = current;
    writeStore(data);
    if (isCheck) syncEnabled();
  };
  document.querySelector("main").addEventListener("input", saveField);
  document.querySelector("main").addEventListener("change", saveField);

  /* Silver: saat Hitung manual dimatikan, kolom nilai kembali ke default */
  ["sv-o1", "sv-o2", "sv-o3", "sv-o4"].forEach(function (id) {
    document.getElementById(id + "-m-on").addEventListener("change", function (ev) {
      if (ev.target.checked) return;
      var el = document.getElementById(id);
      var stored = readStore()[id];
      el.value = typeof stored === "string" ? stored : el.defaultValue;
    });
  });

  /* Live update */
  [
    ["form-stopwatch", calcStopwatch],
    ["form-hourly", calcHourly],
    ["form-agris", calcAgris],
    ["form-total", calcTotal],
    ["form-buff", calcBuff],
    ["form-tax", calcTax],
    ["form-totaltl", calcTotalTL],
    ["form-compen", calcCompen],
    ["form-silver", calcSilver],
    ["form-used", calcAgrisUsed]
  ].forEach(function (x) {
    var form = document.getElementById(x[0]);
    form.addEventListener("input", function () { x[1](); fitAll(); });
    form.addEventListener("change", function (ev) {
      if (ev.target.type === "checkbox" || ev.target.tagName === "SELECT") { x[1](); fitAll(); }
    });

    document.getElementById("reset-" + x[0].replace("form-", "")).addEventListener("click", function () {
      var data = readStore();
      Array.prototype.forEach.call(form.querySelectorAll("input, select, textarea:not([readonly])"), function (el) {
        if (el.tagName === "SELECT") el.value = selectDefault(el);
        else if (el.type === "checkbox") el.checked = el.defaultChecked;
        else el.value = el.defaultValue;
        delete data[el.id];
      });
      writeStore(data);
      syncEnabled();
      x[1]();
      fitAll();
    });

    document.getElementById("clear-" + x[0].replace("form-", "")).addEventListener("click", function () {
      var data = readStore();
      Array.prototype.forEach.call(form.querySelectorAll("input, select, textarea:not([readonly])"), function (el) {
        if (el.tagName === "SELECT") {
          var hasCustom = Array.prototype.some.call(el.options, function (o) { return o.value === "custom"; });
          if (!hasCustom) return;
          el.value = "custom";
          if (el.value === selectDefault(el)) delete data[el.id];
          else data[el.id] = "custom";
          return;
        }
        if (el.type === "range") return;
        if (el.type === "checkbox") {
          el.checked = false;
          if (el.checked === el.defaultChecked) delete data[el.id];
          else data[el.id] = "0";
          return;
        }
        el.value = "";
        if (el.value === el.defaultValue) delete data[el.id];
        else data[el.id] = el.value;
      });
      writeStore(data);
      syncEnabled();
      x[1]();
      fitAll();
    });

    x[1]();
  });

  fitAll();
  window.addEventListener("resize", fitAll);
  document.addEventListener("toggle", fitAll, true);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitAll);
})();
</script>
