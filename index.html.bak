</ul>
<p><em>Use at your own risk!</em></p>
<p><button type="button" id="help-close">Tutup</button></p>
</dialog>
<dialog id="purge-dialog" aria-labelledby="purge-title">
<h2 id="purge-title">Purge</h2>
<p><button type="button" id="purge-reset">Reset</button> <button type="button" id="purge-clear">Clear</button></p>
</dialog>
<dialog id="data-dialog" aria-labelledby="data-title">
<h2 id="data-title">Import/Export</h2>
<p><button type="button" id="data-import">Import</button> <button type="button" id="data-export">Export</button></p>
<p id="data-msg" role="status"></p>
<input type="file" id="data-file" accept="application/json,.json" hidden>
</dialog>
<dialog id="verify-dialog" aria-labelledby="verify-title">
<h2 id="verify-title">Verifikasi (ChatGPT, Claude, Gemini)</h2>
<p>Copy prompt di bawah, lalu paste ke ChatGPT, Claude, atau Gemini untuk verifikasi</p>
<p><textarea id="verify-out" name="verify-out" rows="12" cols="60" readonly></textarea></p>
<p><button type="button" id="verify-close">Tutup</button></p>
</dialog>
<script>
(function () {
  "use strict";

  /* Tidak peduli berapa element HTML-nya, tinggi textarea wajib mengikuti semua element HTML */
  var fit = function (el) {
    if (!el.clientWidth) return;
    el.style.height = "auto";
    el.style.height = (el.scrollHeight + el.offsetHeight - el.clientHeight) + "px";
  };
  var fitAll = function () {
    var list = Array.prototype.filter.call(document.querySelectorAll("textarea"), function (el) { return el.clientWidth; });
    list.forEach(function (el) { el.style.height = "auto"; });
    var heights = list.map(function (el) { return el.scrollHeight + el.offsetHeight - el.clientHeight; });
    list.forEach(function (el, k) { el.style.height = heights[k] + "px"; });
  };

  /* Detik dari jam, toleran error float (mis. 31744.999999999) */
  var floorSec = function (h) { return Math.floor(h * 3600 + 1e-7); };

  /* Textarea untuk perhitungan per langkah */
  var fill = function (prefix, lines, count) {
    for (var k = 0; k < count; k++) {
      document.getElementById(prefix + (k + 1)).value = lines[k] || "";
    }
  };

  /* Input angka: pemisah ribuan (koma), koma yang diketik diabaikan saat menghitung */
  var readNum = function (id) {
    var t = document.getElementById(id).value.replace(/,/g, "").trim();
    return /^-?(\d+\.?\d*|\.\d+)(e[+-]?\d+)?$/i.test(t) ? t : "";
  };
  var isNumInput = function (el) {
    return el && el.tagName === "INPUT" && el.getAttribute("inputmode") === "decimal" && !el.hasAttribute("data-raw");
  };
  var formatNumber = function (el) {
    var raw = el.value;
    var compact = raw.replace(/[,\s]/g, "");
    if (/e/i.test(compact) && /^[-+]?[\d.]*e[+-]?\d*$/i.test(compact)) return;
    var caret = typeof el.selectionStart === "number" ? el.selectionStart : raw.length;
    var before = raw.slice(0, caret).replace(/[^\d.]/g, "").length;
    var neg = /^\s*-/.test(raw);
    var cleaned = raw.replace(/[^\d.]/g, "");
    var dot = cleaned.indexOf(".");
    var intPart = dot === -1 ? cleaned : cleaned.slice(0, dot);
    var decPart = dot === -1 ? null : cleaned.slice(dot + 1).replace(/\./g, "");
    intPart = intPart.replace(/^0+(?=\d)/, "");
    var out = (neg ? "-" : "") + intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ",") + (decPart === null ? "" : "." + decPart);
    if (out === raw) return;
    el.value = out;
    if (document.activeElement === el && el.setSelectionRange) {
      var pos = 0;
      var seen = 0;
      while (pos < out.length && seen < before) {
        if (/[\d.]/.test(out.charAt(pos))) seen++;
        pos++;
      }
      el.setSelectionRange(pos, pos);
    }
  };

  /* Tema terang/gelap */
  var root = document.documentElement;
  var themeBtn = document.getElementById("theme-toggle");
  var themeIcon = document.getElementById("theme-icon");
  var themeLabel = document.getElementById("theme-label");
  var mq = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;
  var currentTheme = function () {
    return root.getAttribute("data-theme") || (mq && mq.matches ? "dark" : "light");
  };
  var renderTheme = function () {
    var dark = currentTheme() === "dark";
    themeIcon.textContent = dark ? "\u2600\uFE0E" : "\u263E";
    themeLabel.textContent = dark ? "Mode Terang" : "Mode Gelap";
  };
  themeBtn.addEventListener("click", function () {
    var next = currentTheme() === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try { localStorage.setItem("theme", next); } catch (e) {}
    renderTheme();
  });
  if (mq && mq.addEventListener) mq.addEventListener("change", renderTheme);
  renderTheme();

  /* Help (dialog) */
  var helpDlg = document.getElementById("help-dialog");
  var closeHelp = function () {
    if (typeof helpDlg.close === "function") helpDlg.close();
    else helpDlg.removeAttribute("open");
  };
  document.getElementById("help-open").addEventListener("click", function () {
    if (helpDlg.open) return;
    if (typeof helpDlg.showModal === "function") helpDlg.showModal();
    else helpDlg.setAttribute("open", "");
  });
  document.getElementById("help-close").addEventListener("click", closeHelp);
  helpDlg.addEventListener("click", function (ev) {
    if (ev.target !== helpDlg) return;
    var r = helpDlg.getBoundingClientRect();
    var inside = ev.clientX >= r.left && ev.clientX <= r.right && ev.clientY >= r.top && ev.clientY <= r.bottom;
    if (!inside) closeHelp();
  });

  /* Purge (global Reset dan Clear) */
  var purgeDlg = document.getElementById("purge-dialog");
  var closePurge = function () {
    if (typeof purgeDlg.close === "function") purgeDlg.close();
    else purgeDlg.removeAttribute("open");
  };
  document.getElementById("purge-open").addEventListener("click", function () {
    if (purgeDlg.open) return;
    if (typeof purgeDlg.showModal === "function") purgeDlg.showModal();
    else purgeDlg.setAttribute("open", "");
  });
  purgeDlg.addEventListener("click", function (ev) {
    if (ev.target !== purgeDlg) return;
    var r = purgeDlg.getBoundingClientRect();
    var inside = ev.clientX >= r.left && ev.clientX <= r.right && ev.clientY >= r.top && ev.clientY <= r.bottom;
    if (!inside) closePurge();
  });
  var purgeAll = function (prefix) {
    Array.prototype.forEach.call(document.querySelectorAll('main button[id^="' + prefix + '-"]'), function (b) {
      b.click();
    });
    closePurge();
  };
  document.getElementById("purge-reset").addEventListener("click", function () { purgeAll("reset"); });
  document.getElementById("purge-clear").addEventListener("click", function () { purgeAll("clear"); });

  /* Import/Export (data tersimpan di localStorage) */
  var DATA_KEYS = ["bdo-game-pilot:inputs", "bdo-game-pilot:kpi", "bdo-game-pilot:tab", "theme"];
  var dataDlg = document.getElementById("data-dialog");
  var dataMsg = document.getElementById("data-msg");
  var dataFile = document.getElementById("data-file");
  var closeData = function () {
    if (typeof dataDlg.close === "function") dataDlg.close();
    else dataDlg.removeAttribute("open");
  };
  document.getElementById("data-open").addEventListener("click", function () {
    if (dataDlg.open) return;
    dataMsg.textContent = "";
    if (typeof dataDlg.showModal === "function") dataDlg.showModal();
    else dataDlg.setAttribute("open", "");
  });
  dataDlg.addEventListener("click", function (ev) {
    if (ev.target !== dataDlg) return;
    var r = dataDlg.getBoundingClientRect();
    var inside = ev.clientX >= r.left && ev.clientX <= r.right && ev.clientY >= r.top && ev.clientY <= r.bottom;
    if (!inside) closeData();
  });

  document.getElementById("data-export").addEventListener("click", function () {
    var data = {};
    DATA_KEYS.forEach(function (k) {
      try {
        var s = localStorage.getItem(k);
        if (s !== null) data[k] = s;
      } catch (e) {}
    });
    var json = JSON.stringify({ app: "bdo-game-pilot", version: 1, exported: new Date().toISOString(), data: data }, null, 2);
    var d = new Date();
    var pad = function (n) { return String(n).padStart(2, "0"); };
    var name = "bdo-game-pilot-" + d.getFullYear() + pad(d.getMonth() + 1) + pad(d.getDate()) + ".json";
    var url = URL.createObjectURL(new Blob([json], { type: "application/json" }));
    var a = document.createElement("a");
    a.href = url;
    a.download = name;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
    dataMsg.textContent = "Export berhasil: " + name;
  });

  document.getElementById("data-import").addEventListener("click", function () {
    dataMsg.textContent = "";
    dataFile.click();
  });
  dataFile.addEventListener("change", function () {
    var f = dataFile.files && dataFile.files[0];
    if (!f) return;
    if (f.size > 5 * 1024 * 1024) {
      dataMsg.textContent = "Import gagal: file terlalu besar";
      dataFile.value = "";
      return;
    }
    var reader = new FileReader();
    reader.onerror = function () {
      dataMsg.textContent = "Import gagal: file tidak bisa dibaca";
      dataFile.value = "";
    };
    reader.onload = function () {
      var clean = {};
      try {
        var parsed = JSON.parse(String(reader.result));
        if (!parsed || parsed.app !== "bdo-game-pilot" || !parsed.data || typeof parsed.data !== "object" || Array.isArray(parsed.data)) {
          throw new Error("file bukan hasil export BDO Game Pilot");
        }
        DATA_KEYS.forEach(function (k) {
          var s = parsed.data[k];
          if (s === undefined) return;
          if (typeof s !== "string") throw new Error("data '" + k + "' tidak valid");
          if (k === "bdo-game-pilot:inputs") {
            var o = JSON.parse(s);
            if (!o || typeof o !== "object" || Array.isArray(o)) throw new Error("data input tidak valid");
          } else if (k === "bdo-game-pilot:kpi") {
            if (!Array.isArray(JSON.parse(s))) throw new Error("data KPI tidak valid");
          } else if (k === "theme") {
            if (s !== "light" && s !== "dark") throw new Error("data tema tidak valid");
          } else if (k === "bdo-game-pilot:tab") {
            if (!document.getElementById(s) || s.indexOf("tab-") !== 0) throw new Error("data tab tidak valid");
          }
          clean[k] = s;
        });
      } catch (e) {
        dataMsg.textContent = "Import gagal: " + (e instanceof SyntaxError ? "file bukan JSON yang valid" : e.message);
        dataFile.value = "";
        return;
      }
      try {
        DATA_KEYS.forEach(function (k) {
          if (Object.prototype.hasOwnProperty.call(clean, k)) localStorage.setItem(k, clean[k]);
          else localStorage.removeItem(k);
        });
      } catch (e) {
        dataMsg.textContent = "Import gagal: storage browser penuh atau diblokir";
        dataFile.value = "";
        return;
      }
      location.reload();
    };
    reader.readAsText(f);
  });

  /* Tabs */
  var TAB_KEY = "bdo-game-pilot:tab";
  var tabs = Array.prototype.slice.call(document.querySelectorAll('[role="tab"]'));
  function activate(tab, skipSave) {
    tabs.forEach(function (t) {
      var on = t === tab;
      t.setAttribute("aria-selected", on ? "true" : "false");
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")).hidden = !on;
    });
    if (!skipSave) {
      try { localStorage.setItem(TAB_KEY, tab.id); } catch (e) {}
    }
    fitAll();
  }
  tabs.forEach(function (t, i) {
    t.addEventListener("click", function () { activate(t); });
    t.addEventListener("keydown", function (ev) {
      var n = null;
      if (ev.key === "ArrowRight") n = tabs[(i + 1) % tabs.length];
      if (ev.key === "ArrowLeft") n = tabs[(i + tabs.length - 1) % tabs.length];
      if (ev.key === "Home") n = tabs[0];
      if (ev.key === "End") n = tabs[tabs.length - 1];
      if (n) { ev.preventDefault(); activate(n); n.focus(); }
    });
  });

  /* Pulihkan tab terakhir */
  var savedTab = null;
  try { savedTab = localStorage.getItem(TAB_KEY); } catch (e) {}
  var lastTab = tabs.filter(function (t) { return t.id === savedTab; })[0];
  if (lastTab) activate(lastTab, true);

  /* 1. Google Stopwatch */
  var calcStopwatch = function () {
    var h = String(Number(readNum("sw-h")));
    var m = String(Number(readNum("sw-m"))).padStart(2, "0");
    var s = String(Number(readNum("sw-s"))).padStart(2, "0");
    var t = h + ":" + m + ":" + s;
    var code = '(()=>{const t=' + JSON.stringify(t) + ',e=document.querySelector(\'[jsname="LQ3Xe"]\');if(!e){console.error(\'Element with selector [jsname="LQ3Xe"] was not found on this page.\');return}const s=document.title.replace(/^[\\d:\\s]+/,""),f=(e.textContent.match(/\\.\\d+$/)||[".00"])[0],o=`${t}${f}`;e.textContent=o;document.title=`${t.padStart(8,"0")} ${s.trim()}`;console.log(o)})();';
    document.getElementById("sw-out").value = code;
  };

  /* Klik stopwatch: langsung siap di copy */
  var swOut = document.getElementById("sw-out");
  var selectSwOut = function () {
    swOut.select();
    swOut.setSelectionRange(0, swOut.value.length);
  };
  swOut.addEventListener("click", selectSwOut);
  swOut.addEventListener("focus", selectSwOut);

  /* Verifikasi Google Stopwatch (Claude, ChatGPT, Gemini) */
  var verifyDlg = document.getElementById("verify-dialog");
  var verifyOut = document.getElementById("verify-out");
  var buildVerifyPrompt = function () {
    return [
      "Tolong verifikasi kode JavaScript di bawah ini. Kode ini untuk di-paste di browser console pada halaman Google Stopwatch (hasil search \"Stopwatch\" di Google).",
      "",
      "Yang ingin saya ketahui:",
      "1. Apa sebenarnya yang dilakukan kode ini, langkah demi langkah?",
      "2. Apakah benar kode ini hanya mengubah teks tampilan stopwatch (elemen [jsname=\"LQ3Xe\"]) dan judul tab, tidak lebih dari itu?",
      "3. Apakah ada hal berbahaya: mengirim data ke luar (fetch, XMLHttpRequest, WebSocket, dll), membaca cookie atau localStorage, memakai eval, atau memuat script lain?",
      "4. Apakah aman untuk di-paste di browser console?",
      "",
      "Jawab jujur dan jelas. Jika ada yang mencurigakan, jelaskan. Jika tidak yakin, bilang tidak yakin.",
      "",
      "Kode:",
      "```",
      document.getElementById("sw-out").value,
      "```"
    ].join("\n");
  };
  var closeVerify = function () {
    if (typeof verifyDlg.close === "function") verifyDlg.close();
    else verifyDlg.removeAttribute("open");
  };
  document.getElementById("verify-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });
  document.getElementById("verify-close").addEventListener("click", closeVerify);
  verifyDlg.addEventListener("click", function (ev) {
    if (ev.target !== verifyDlg) return;
    var r = verifyDlg.getBoundingClientRect();
    var inside = ev.clientX >= r.left && ev.clientX <= r.right && ev.clientY >= r.top && ev.clientY <= r.bottom;
    if (!inside) closeVerify();
  });
  var selectVerify = function () {
    verifyOut.select();
    verifyOut.setSelectionRange(0, verifyOut.value.length);
  };
  verifyOut.addEventListener("click", selectVerify);
  verifyOut.addEventListener("focus", selectVerify);

  /* Verifikasi Progress Hourly no Agris (Claude, ChatGPT, Gemini) */
  var buildHourlyVerifyPrompt = function () {
    var v = function (id) { return document.getElementById(id).value; };
    var dropOn = document.getElementById("h-drop-on").checked;
    var steps = ["h-d1", "h-d2", "h-d3", "h-d4", "h-s1", "h-s2", "h-s3", "h-s4", "h-s5"].map(v).filter(function (s) { return s; });
    var lines = [
      "Tolong verifikasi perhitungan progress hourly (tanpa Agris) di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input:",
      "- Total TL selama shift: " + v("h-total"),
      "- TL per jam (patokan di note): " + v("h-rate"),
      "- 100% Drop Amount (Blessing of Old Moon Scroll / [Event] Golden Blessing of Agris): " + (dropOn
        ? v("h-drop") + " item (masing-masing 1 jam, efeknya seperti Agris 1 jam), TL/hr dengan Agris: " + v("h-drate")
        : "tidak dicentang"),
      "",
      "Rumus yang dipakai:"
    ];
    if (dropOn) {
      lines.push(
        "1. Maks TL Agris = jumlah item × TL/hr dengan Agris (tiap item 1 jam)",
        "2. Jika Total TL ≤ Maks TL Agris: waktu dengan patokan Agris = Total TL ÷ TL/hr dengan Agris, waktu biasa = 0",
        "3. Jika Total TL > Maks TL Agris: waktu dengan patokan Agris = jumlah item (jam), waktu biasa = (Total TL − Maks TL Agris) ÷ TL per jam",
        "4. Waktu (jam) = waktu dengan patokan Agris + waktu biasa",
        "5. Total detik = floor(waktu × 3600)",
        "6. Jam = floor(total detik ÷ 3600), Menit = floor((total detik mod 3600) ÷ 60), Detik = total detik mod 60"
      );
    } else {
      lines.push(
        "1. Waktu (jam) = Total TL ÷ TL per jam",
        "2. Total detik = floor(waktu × 3600)",
        "3. Jam = floor(total detik ÷ 3600)",
        "4. Menit = floor((total detik mod 3600) ÷ 60)",
        "5. Detik = total detik mod 60"
      );
    }
    lines.push("", "Hasil dari tool:", v("h-out"));
    if (steps.length) {
      lines.push("", "Langkah perhitungan dari tool:");
      steps.forEach(function (s, i) { lines.push((i + 1) + ". " + s); });
    }
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumusnya sudah benar untuk menghitung lama grinding dari total TL dan TL per jam" + (dropOn ? " (termasuk pembagian jam dengan patokan Agris dan patokan biasa)?" : "?"),
      "2. Hitung ulang sendiri dari data input di atas, apakah hasilnya sama dengan hasil tool?",
      "3. Apakah pembulatan ke bawah (floor) sudah tepat?",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
  };
  document.getElementById("verify-hourly-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildHourlyVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });

  /* Verifikasi Progress Hourly dengan Agris (Claude, ChatGPT, Gemini) */
  var buildAgrisVerifyPrompt = function () {
    var v = function (id) { return document.getElementById(id).value; };
    var group = function (title, prefix, count) {
      var items = [];
      for (var k = 1; k <= count; k++) {
        var s = v(prefix + k);
        if (s) items.push(s);
      }
      return items.length
        ? ["", title].concat(items.map(function (s, i) { return (i + 1) + ". " + s; }))
        : [];
    };
    var lines = [
      "Tolong verifikasi perhitungan progress hourly (dengan Agris) di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input:",
      "- Total TL selama shift: " + v("a-total"),
      "- TL/hr dengan Agris (patokan note): " + v("a-rate"),
      "- Agris yang digunakan per jam (patokan note): " + v("a-cost"),
      "- TL/hr tanpa Agris (patokan note): " + v("a-normal"),
      "- Agris yang digunakan selama shift: " + v("a-current"),
      "- 100% Drop Amount (Blessing of Old Moon Scroll / [Event] Golden Blessing of Agris): " + (document.getElementById("a-drop-on").checked ? v("a-drop") + " item (masing-masing 1 jam, efeknya seperti Agris 1 jam)" : "tidak dicentang"),
      "",
      "Rumus yang dipakai:",
      "1. Jam Agris = Agris yang digunakan selama shift ÷ Agris per jam",
      "1b. Maks jam Agris = jam Agris + (jumlah item 100% Drop Amount × 1 jam), item bernilai 0 jika tidak dicentang. Item ini tidak mengurangi Agris",
      "2. Maks TL Agris = Maks jam Agris × TL/hr dengan Agris",
      "3. Jika Total TL ≤ Maks TL Agris (Agris cukup): waktu with Agris = Total TL ÷ TL/hr dengan Agris, waktu without Agris = 0",
      "4. Jika Total TL > Maks TL Agris (Agris tidak cukup): waktu with Agris = Maks jam Agris, waktu without Agris = (Total TL − Maks TL Agris) ÷ TL/hr tanpa Agris",
      "5. Total waktu = waktu with Agris + waktu without Agris (dijumlahkan dalam jam, sebelum dibulatkan)",
      "6. Setiap waktu (dalam jam) diubah ke jam/menit/detik: total detik = floor(jam × 3600), jam = floor(total detik ÷ 3600), menit = floor((total detik mod 3600) ÷ 60), detik = total detik mod 60",
      "Catatan: karena pembulatan dilakukan terpisah untuk tiap hasil, Total Time boleh berbeda sekitar 1 detik dari penjumlahan Time with Agris dan Time without Agris.",
      "",
      "Hasil dari tool:",
      "- Total Time: " + v("a-out"),
      "- Time with Agris: " + v("a-with"),
      "- Time without Agris: " + v("a-without")
    ];
    lines = lines
      .concat(["", "Langkah perhitungan dari tool:"].concat(
        ["a-s1", "a-sd", "a-s2", "a-s3", "a-s4", "a-s5"].map(v).filter(function (s) { return s; })
          .map(function (s, i) { return (i + 1) + ". " + s; })
      ))
      .concat(group("Konversi Total Time:", "a-t", 4))
      .concat(group("Konversi Time with Agris:", "a-w", 4))
      .concat(group("Konversi Time without Agris:", "a-o", 4));
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumusnya sudah benar, termasuk pembagian kasus Agris cukup dan Agris tidak cukup?",
      "2. Hitung ulang sendiri dari data input di atas, apakah hasilnya sama dengan hasil tool?",
      "3. Apakah pembulatan ke bawah (floor) sudah tepat?",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
  };
  document.getElementById("verify-agris-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildAgrisVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });

  /* Verifikasi Total Progress Hourly (Claude, ChatGPT, Gemini) */
  var buildTotalVerifyPrompt = function () {
    var v = function (id) { return document.getElementById(id).value; };
    var steps = ["t-s1", "t-s2", "t-s3", "t-s4", "t-s5"].map(v).filter(function (s) { return s; });
    var lines = [
      "Tolong verifikasi perhitungan total progress hourly di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input (format H = jam, M = menit):",
      "- Total progress sebelumnya: " + v("t-prev"),
      "- Progress saat ini: " + v("t-now"),
      "",
      "Rumus yang dipakai:",
      "1. Total progress sebelumnya diubah ke menit = jam × 60 + menit",
      "2. Progress saat ini diubah ke menit = jam × 60 + menit",
      "3. Total menit = menit sebelumnya + menit saat ini",
      "4. Jam = floor(total menit ÷ 60)",
      "5. Menit = total menit mod 60",
      "",
      "Hasil dari tool:",
      "- Total Hours: " + v("t-out")
    ];
    if (steps.length) {
      lines.push("", "Langkah perhitungan dari tool:");
      steps.forEach(function (s, i) { lines.push((i + 1) + ". " + s); });
    }
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumusnya sudah benar untuk menjumlahkan dua progress dalam format jam dan menit?",
      "2. Hitung ulang sendiri dari data input di atas, apakah hasilnya sama dengan hasil tool?",
      "3. Apakah pembagian jam dan sisa menitnya sudah tepat, terutama saat menit melebihi 60?",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
  };
  document.getElementById("verify-total-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildTotalVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });

  /* Verifikasi Total Buff (Claude, ChatGPT, Gemini) */
  var buildBuffVerifyPrompt = function () {
    var v = function (id) { return document.getElementById(id).value; };
    var steps = ["b-s1", "b-s2", "b-s3", "b-s4", "b-s5", "b-s6", "b-s7", "b-s8", "b-s9"].map(v).filter(function (s) { return s; });
    var price = v("b-price").trim();
    var lines = [
      "Tolong verifikasi perhitungan jumlah buff yang digunakan di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input:",
      "- Durasi shift: " + v("b-shift"),
      "- Durasi buff: " + v("b-duration"),
      "- Buff cooldown: " + v("b-cooldown"),
      "- Harga per buff (opsional): " + (price ? price : "(kosong, biaya tidak dihitung)"),
      "",
      "Aturan satuan:",
      "- Satuan waktu: h = jam, m = menit, s = detik. Tanpa satuan, durasi shift dihitung jam, durasi buff menit, dan cooldown detik.",
      "- Satuan harga: k = ribu, m = juta, b = miliar. Perhatikan bahwa m pada waktu berarti menit, tetapi m pada harga berarti juta.",
      "",
      "Rumus yang dipakai:",
      "1. Durasi shift, durasi buff, dan cooldown masing-masing diubah ke detik",
      "2. Satu siklus buff = durasi buff + cooldown (dalam detik)",
      "3. Jumlah buff = max(1, ceil(durasi shift ÷ siklus))",
      "4. Harga per buff diubah ke silver = floor(nilai × pengali)",
      "5. Total biaya = jumlah buff × harga per buff",
      "",
      "Hasil dari tool:",
      "- Shift: " + v("b-o1"),
      "- Buff: " + v("b-o2"),
      "- Total Buff: " + v("b-o3"),
      "- Harga: " + (v("b-o4") || "(tidak dihitung)")
    ];
    if (steps.length) {
      lines.push("", "Langkah perhitungan dari tool:");
      steps.forEach(function (s, i) { lines.push((i + 1) + ". " + s); });
    }
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumusnya sudah benar, termasuk pembulatan ke atas (ceil) dan minimal 1 buff?",
      "2. Hitung ulang sendiri dari data input di atas, apakah hasilnya sama dengan hasil tool?",
      "3. Apakah konversi satuan waktu dan harga sudah tepat?",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
  };
  document.getElementById("verify-buff-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildBuffVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });

  /* Verifikasi BDO Tax Calculator (Claude, ChatGPT, Gemini) */
  var buildTaxVerifyPrompt = function () {
    var v = function (id) { return document.getElementById(id).value; };
    var rows = function (pairs) {
      return pairs
        .map(function (p) { return v(p[1]) ? "- " + p[0] + " " + v(p[1]) : ""; })
        .filter(function (s) { return s; });
    };
    var group = function (title, prefix, count) {
      var items = [];
      for (var k = 1; k <= count; k++) {
        var s = v(prefix + k);
        if (s) items.push(s);
      }
      return items.length
        ? ["", title].concat(items.map(function (s, i) { return (i + 1) + ". " + s; }))
        : [];
    };
    var options = v("d-options").trim();
    var fameLabel = document.getElementById("d-l6").textContent;
    var lines = [
      "Tolong verifikasi perhitungan BDO Tax Calculator (Black Desert Online) di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input:",
      "- Price: " + v("d-price"),
      "- Options: " + (options ? options : "(kosong)"),
      "",
      "Aturan yang dipakai tool:",
      "- Satuan harga: k = ribu, m = juta, b = miliar, t = triliun.",
      "- Options (dipisah spasi): vp = Value Pack aktif, ring = Rich Merchant's Ring atau Old Moon Trade Pass (tidak bisa ditumpuk), fame1/fame2/fame3 = tier Family Fame, atau poin Family Fame berupa angka yang otomatis diubah ke tier.",
      "- Jika Options kosong, tool menampilkan dua versi: biasa dan with Value Pack.",
      "- Pajak total 35% (30% Central Market dan 5% territory), jadi seller menerima 65% (profit).",
      "- Semua bonus dihitung dari profit setelah pajak (65%), lalu dijumlahkan: Value Pack +30%, Ring/Pass +5%, Family Fame 1000-3999 poin +0.5%, 4000-6999 poin +1.0%, 7000 ke atas +1.5%.",
      "- Total diterima = profit + semua bonus. Rate efektif = total diterima ÷ harga.",
      "Catatan: tiap angka yang ditampilkan dibulatkan ke silver terdekat, sedangkan total dihitung dari angka sebelum dibulatkan, jadi penjumlahan angka yang tampil boleh berbeda sekitar 1 silver dari total.",
      "",
      "Hasil dari tool:"
    ];
    lines = lines.concat(rows([
      ["Sale price:", "d-o1"],
      ["Tax (35%):", "d-o2"],
      ["Base profit (65%):", "d-o3"],
      ["Value Pack (+30%):", "d-o4"],
      ["Ring/Pass (+5%):", "d-o5"],
      [fameLabel, "d-o6"],
      ["You receive:", "d-o7"]
    ]));
    var second = rows([
      ["Sale price:", "d-p1"],
      ["Tax (35%):", "d-p2"],
      ["Base profit (65%):", "d-p3"],
      ["Value Pack (+30%):", "d-p4"],
      ["You receive:", "d-p5"]
    ]);
    if (second.length) lines = lines.concat(["", "Versi with Value Pack:"], second);
    lines = lines
      .concat(group("Langkah perhitungan dari tool:", "d-s", 10))
      .concat(group("Langkah perhitungan versi with Value Pack:", "d-t", 6));
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumus pajak dan bonusnya sudah sesuai dengan aturan yang saya tulis di atas?",
      "2. Hitung ulang sendiri dari data input di atas, apakah hasilnya sama dengan hasil tool?",
      "3. Apakah tier Family Fame yang dipilih sudah tepat untuk poin yang diinput?",
      "4. Sepengetahuan kamu tentang Black Desert Online, apakah persentase pajak dan bonus di atas sesuai dengan game? Jika tidak yakin, bilang tidak yakin.",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
  };
  document.getElementById("verify-tax-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildTaxVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });

  /* Verifikasi Total TL (Claude, ChatGPT, Gemini) */
  var buildTotalTLVerifyPrompt = function () {
    var v = function (id) { return document.getElementById(id).value; };
    var useSpot = document.getElementById("tl-spot-on").checked;
    var spotEl = document.getElementById("tl-spot");
    var isCustom = spotEl.value === "custom";
    var steps = ["tl-s1", "tl-s2", "tl-s3"].map(v).filter(function (s) { return s; });
    var lines = [
      "Tolong verifikasi perhitungan Total TL (Black Desert Online) di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input:",
      "- TL awal (yang sudah ada di storage): " + v("tl-start"),
      "- TL akhir (setelah grinding selama shift): " + v("tl-end"),
      "- Harga TL (opsional): " + (useSpot
        ? (isCustom
            ? "custom, " + v("tl-custom") + " silver per TL"
            : spotEl.options[spotEl.selectedIndex].text + " silver per TL")
        : "tidak dipakai (checkbox Spot tidak dicentang)"),
      "",
      "Rumus yang dipakai:",
      "1. Total perolehan TL = TL akhir − TL awal",
      "2. Harga TL seluruhnya = total perolehan TL × harga TL (hanya jika harga TL dipakai)",
      "3. Angka besar ditampilkan juga dalam bentuk ringkas: K = ribu, M = juta, B = miliar",
      "",
      "Hasil dari tool:",
      "- Total perolehan TL: " + v("tl-out")
    ];
    if (v("tl-price")) lines.push("- Harga TL: " + v("tl-price"));
    if (v("tl-all")) lines.push("- Harga TL seluruhnya: " + v("tl-all"));
    if (steps.length) {
      lines.push("", "Langkah perhitungan dari tool:");
      steps.forEach(function (s, i) { lines.push((i + 1) + ". " + s); });
    }
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumusnya sudah benar untuk menghitung total perolehan TL dan nilai silvernya?",
      "2. Hitung ulang sendiri dari data input di atas, apakah hasilnya sama dengan hasil tool?",
      "3. Apakah format angka ringkas (K, M, B) sudah sesuai dengan angka lengkapnya?",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
  };
  document.getElementById("verify-totaltl-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildTotalTLVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });

  /* Verifikasi Silver (Claude, ChatGPT, Gemini) */
  var buildSilverVerifyPrompt = function () {
    var v = function (id) { return document.getElementById(id).value; };
    var on = function (id) { return document.getElementById(id + "-on").checked; };
    var optional = function (id, label) {
      return "- " + label + ": " + (on(id) ? v(id) : "tidak dicentang (dihitung 0)");
    };
    var optionLine = function (o) {
      var id = o[0];
      if (!on(id)) return "- " + o[1] + ": tidak dicentang (dihitung 0)";
      if (document.getElementById(id + "-m-on").checked) {
        var items = v(id + "-m").split(/\s+/).filter(function (s) { return s; });
        return "- " + o[1] + ": hitung manual, daftar angka: " +
          (items.length ? items.join(", ") : "(kosong)") +
          " (hasil penjumlahan di kolom: " + v(id) + ")";
      }
      return "- " + o[1] + ": " + v(id);
    };
    var results = [
      ["Central Market awal shift", "sv-cm1"],
      ["Central Market end shift", "sv-cm2"],
      ["Central Market selisih", "sv-cm3"],
      ["Inventory awal shift", "sv-iv1"],
      ["Inventory end shift", "sv-iv2"],
      ["Inventory selisih", "sv-iv3"],
      ["Total awal shift", "sv-r1"],
      ["Total end shift", "sv-r2"],
      ["Total selisih", "sv-r3"],
      ["Total perolehan silver", "sv-r5"],
      ["Total Progress", "sv-r6"]
    ].filter(function (r) { return v(r[1]); })
     .map(function (r) { return "- " + r[0] + ": " + v(r[1]); });
    var steps = ["sv-s1", "sv-s2", "sv-s3", "sv-sc", "sv-si", "sv-s4", "sv-s5", "sv-s6"].map(v).filter(function (s) { return s; });
    var prev = v("sv-p0").trim();

    var lines = [
      "Tolong verifikasi perhitungan silver selama shift (Black Desert Online) di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input:",
      "Awal shift:",
      "- Silver di Central Market: " + v("sv-c0"),
      optional("sv-i0", "Silver di Inventory (opsional)"),
      "TL & RNG:"
    ];
    lines = lines.concat([
      ["sv-o1", "Sell in storage"],
      ["sv-o2", "Sell in Central Market (Tax)"],
      ["sv-o3", "Listed in CM (Tax)"],
      ["sv-o4", "Keep owner"]
    ].map(optionLine));
    lines.push(
      "End shift:",
      "- Silver di Central Market: " + v("sv-c1"),
      optional("sv-i1", "Silver di Inventory (opsional)"),
      "Total progress:",
      "- Total progress sebelumnya (opsional): " + (prev ? v("sv-p0") : "(kosong, dihitung 0)"),
      "- Total progress seluruhnya: " + v("sv-p1"),
      "",
      "Aturan yang dipakai tool:",
      "- Silver bisa diisi angka biasa, pemisah ribuan (koma), atau akhiran k (ribu), m (juta), b (miliar).",
      "- Silver awal dan akhir shift dijumlahkan dari Central Market dan Inventory (Inventory hanya jika dicentang), jadi perpindahan silver antara keduanya tidak memengaruhi hasil.",
      "- Jika Inventory dicentang di awal atau end shift, perbandingan juga ditampilkan terpisah: selisih Central Market = CM akhir − CM awal, selisih Inventory = inventory akhir − inventory awal (sisi yang tidak dicentang dihitung 0), dan Total = Central Market + Inventory.",
      "- Opsi TL & RNG yang tidak dicentang dihitung 0. Untuk Sell in Central Market (Tax), angka yang diisi adalah harga setelah dijual (sudah dikurangi tax).",
      "- Opsi dengan hitung manual: beberapa angka dijumlahkan, satu angka per baris atau dipisah spasi. Koma adalah pemisah ribuan, bukan pemisah antar angka.",
      "- Format ringkas: B = miliar, M = juta, K = ribu.",
      "",
      "Rumus yang dipakai:",
      "1. Silver awal = silver Central Market awal + silver Inventory awal (jika dicentang)",
      "2. Silver akhir = silver Central Market akhir + silver Inventory akhir (jika dicentang)",
      "3. Selisih = silver akhir − silver awal (boleh negatif karena ada biaya seperti repair gear dan beli buff)",
      "4. Total TL & RNG = jumlah semua opsi TL & RNG yang dicentang",
      "5. Total perolehan silver = selisih + total TL & RNG",
      "6. Total progress = total progress sebelumnya + total perolehan silver, dibandingkan dengan total progress seluruhnya (format: progress / target)",
      "",
      "Hasil dari tool:"
    );
    lines = lines.concat(results);
    if (steps.length) {
      lines.push("", "Langkah perhitungan dari tool:");
      steps.forEach(function (s, i) { lines.push((i + 1) + ". " + s); });
    }
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumusnya sudah benar, termasuk penjumlahan Central Market dengan Inventory dan penjumlahan TL & RNG?",
      "2. Hitung ulang sendiri dari data input di atas (termasuk penjumlahan hitung manual), apakah hasilnya sama dengan hasil tool?",
      "3. Apakah Total Progress dan format ringkasnya (B, M, K) sudah tepat?",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
  };
  document.getElementById("verify-silver-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildSilverVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });

  /* Verifikasi Agris yang Digunakan (Claude, ChatGPT, Gemini) */
  var buildUsedVerifyPrompt = function () {
    var v = function (id) { return document.getElementById(id).value; };
    var reset = document.getElementById("au-reset").checked;
    var steps = ["au-s1", "au-s2", "au-s3"].map(v).filter(function (s) { return s; });
    var lines = [
      "Tolong verifikasi perhitungan Agris yang digunakan selama shift (Black Desert Online) di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input:",
      "- Agris awal (di awal shift): " + v("au-start"),
      "- Agris akhir (sisa setelah grinding): " + v("au-end"),
      "- Agris reset: " + (reset
        ? "dicentang, Agris sebelum reset = " + v("au-before")
        : "tidak dicentang (tidak ada reset selama shift)"),
      "",
      "Aturan yang dipakai tool:",
      "- Reset Agris menambah 20,000 Agris per hari (pukul 06:00 UTC), tetapi Agris tidak bisa melebihi batas maksimal 100,000.",
      "- Agris sebelum reset: jika reset terjadi di awal shift, diisi sama dengan Agris awal. Jika reset terjadi di tengah shift setelah sebagian Agris terpakai, diisi dengan sisa Agris saat itu.",
      "- Agris sebelum reset tidak boleh lebih besar dari Agris awal dan tidak boleh lebih dari 100,000.",
      "- Jika Agris akhir lebih besar dari total Agris yang tersedia, hasilnya menampilkan error.",
      "",
      "Rumus yang dipakai:",
      "1. Agris dari reset = min(20,000, 100,000 − Agris sebelum reset) (hanya jika reset dicentang, jika tidak 0)",
      "2. Total Agris = Agris awal + Agris dari reset",
      "3. Agris yang digunakan = total Agris − Agris akhir",
      "",
      "Hasil dari tool:",
      "- Agris yang digunakan: " + v("au-out")
    ];
    if (steps.length) {
      lines.push("", "Langkah perhitungan dari tool:");
      steps.forEach(function (s, i) { lines.push((i + 1) + ". " + s); });
    }
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumusnya sudah benar, termasuk batas maksimal 100,000 saat reset?",
      "2. Hitung ulang sendiri dari data input di atas, apakah hasilnya sama dengan hasil tool?",
      "3. Apakah validasi (Agris sebelum reset tidak boleh lebih besar dari Agris awal, dan Agris akhir tidak boleh lebih besar dari total Agris) sudah masuk akal?",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
  };
  document.getElementById("verify-used-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildUsedVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });

  /* Verifikasi Compen (Claude, ChatGPT, Gemini) */
  var buildCompenVerifyPrompt = function () {
    var v = function (id) { return document.getElementById(id).value; };
    var price = v("cp-price").trim();
    var steps = ["cp-s1", "cp-s2", "cp-s3", "cp-s4", "cp-s5", "cp-s6"].map(v).filter(function (s) { return s; });
    var lines = [
      "Tolong verifikasi perhitungan Compen (Black Desert Online) di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input:",
      "- Compen: " + v("cp-compen"),
      "- Harga TL (opsional): " + (price ? price : "(kosong, jumlah TL tidak dihitung)"),
      "- Persen TL (slider): " + v("cp-pct") + "%",
      "",
      "Aturan yang dipakai tool:",
      "- Compen dan harga TL bisa diisi angka biasa, pemisah ribuan, atau akhiran k (ribu), m (juta), b (miliar).",
      "- Slider Persen TL membagi compen antara TL dan RNG: 0% berarti semuanya RNG, 100% berarti semuanya TL. Contoh 40% TL berarti 60% RNG.",
      "- Jumlah TL yang harus disell dibulatkan ke atas supaya silver dari TL mencapai bagian compen TL.",
      "",
      "Rumus yang dipakai:",
      "1. Compen dan harga TL diubah ke silver = floor(nilai × pengali)",
      "2. Compen TL = floor(compen × persen TL ÷ 100)",
      "3. Compen RNG = compen − compen TL",
      "4. Jumlah TL = ceil(compen TL ÷ harga TL) (hanya jika harga TL diisi)",
      "5. Total silver dari TL = jumlah TL × harga TL",
      "",
      "Hasil dari tool:",
      "- Compen: " + v("cp-o1")
    ];
    if (v("cp-o2")) lines.push("- TL, Persen: " + v("cp-o2"));
    if (v("cp-o3")) lines.push("- TL, Silver: " + v("cp-o3"));
    if (v("cp-o4")) lines.push("- TL, Jumlah TL yang harus disell: " + v("cp-o4"));
    if (v("cp-o5")) lines.push("- RNG, Persen: " + v("cp-o5"));
    if (v("cp-o6")) lines.push("- RNG, Silver: " + v("cp-o6"));
    if (steps.length) {
      lines.push("", "Langkah perhitungan dari tool:");
      steps.forEach(function (s, i) { lines.push((i + 1) + ". " + s); });
    }
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumusnya sudah benar untuk membagi compen antara TL dan RNG?",
      "2. Hitung ulang sendiri dari data input di atas, apakah hasilnya sama dengan hasil tool?",
      "3. Apakah pembulatan (floor untuk silver, ceil untuk jumlah TL) sudah tepat?",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
