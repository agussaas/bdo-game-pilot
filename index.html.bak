<p><label><input type="checkbox" id="sv-o2-m-on" name="sv-o2-m-on" aria-controls="sv-o2 sv-o2-m" aria-label="Hitung manual Sell in Central Market (sudah tax)" disabled> Hitung manual (per baris):</label> <textarea id="sv-o2-m" name="o2-m" rows="3" cols="40" disabled aria-label="Hitung manual Sell in Central Market (sudah tax), satu angka per baris">1.1b
1,235,000,000
512,000,000</textarea></p>
<p><label><input type="checkbox" id="sv-o3-on" name="sv-o3-on" aria-controls="sv-o3 sv-o3-m-on sv-o3-m"> Listed in CM (sudah tax):</label> <input type="text" id="sv-o3" name="o3" value="1.3b" disabled aria-label="Listed in CM (sudah tax)"></p>
<p><label><input type="checkbox" id="sv-o3-m-on" name="sv-o3-m-on" aria-controls="sv-o3 sv-o3-m" aria-label="Hitung manual Listed in CM (sudah tax)" disabled> Hitung manual (per baris):</label> <textarea id="sv-o3-m" name="o3-m" rows="3" cols="40" disabled aria-label="Hitung manual Listed in CM (sudah tax), satu angka per baris">1.5b
1,725,000,000</textarea></p>
<p><label><input type="checkbox" id="sv-o4-on" name="sv-o4-on" aria-controls="sv-o4 sv-o4-m-on sv-o4-m"> Keep owner:</label> <input type="text" id="sv-o4" name="o4" value="2.1b" disabled aria-label="Keep owner"></p>
<p><label><input type="checkbox" id="sv-o4-m-on" name="sv-o4-m-on" aria-controls="sv-o4 sv-o4-m" aria-label="Hitung manual Keep owner" disabled> Hitung manual (per baris):</label> <textarea id="sv-o4-m" name="o4-m" rows="3" cols="40" disabled aria-label="Hitung manual Keep owner, satu angka per baris">1.8b
1,775,000,000
525,000,000
125,000,000</textarea></p>
</fieldset>
