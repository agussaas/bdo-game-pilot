<script async src="https://www.googletagmanager.com/gtag/js?id=G-CNZKP0WWJ8"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-CNZKP0WWJ8');
</script>
</body>
</html>
