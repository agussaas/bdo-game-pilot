<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&amp;family=JetBrains+Mono:wght@400&amp;display=swap">
<title>BDO Game Pilot</title>
<link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<style>
:root { color-scheme: light dark; }
:root[data-theme="light"] { color-scheme: light; }
:root[data-theme="dark"] { color-scheme: dark; }
:root {
  --bg: light-dark(#ffffff, #121212);
  --fg: light-dark(#1a1a1a, #ededed);
  --ctl: light-dark(#f3f3f3, #262626);
  --bd: light-dark(#6b6b6b, #9a9a9a);
  --sel-bg: light-dark(#1a1a1a, #ededed);
  --sel-fg: light-dark(#ffffff, #121212);
}
body { background: var(--bg); color: var(--fg); }
button, input, textarea { background: var(--ctl); color: var(--fg); border: 1px solid var(--bd); }
fieldset { border: 1px solid var(--bd); }
[aria-selected="true"] { background: var(--sel-bg); color: var(--sel-fg); }

/* Font */
:root {
  --font-ui: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
}

/* Responsif */
*, *::before, *::after { box-sizing: border-box; }
[hidden] { display: none !important; }
html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
body {
  margin: 0;
  padding: clamp(0.75rem, 3vw, 2rem);
  font: 0.9375rem/1.6 var(--font-ui);
  overflow-wrap: break-word;
}
header, main { width: 100%; max-width: 52rem; margin-inline: auto; }
h1 { margin: 0 0 1rem; font-size: clamp(1.25rem, 1rem + 1.2vw, 1.75rem); line-height: 1.2; }
h2 { margin: 0 0 1rem; font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.25rem); line-height: 1.3; }

button {
  min-height: 2.75rem;
  padding: 0.5rem 1rem;
  font: inherit;
  font-weight: 600;
  border-radius: 0.5rem;
  cursor: pointer;
}
nav[role="tablist"] {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  gap: 0.5rem;
  margin: 1rem 0 1.5rem;
}

main > section { min-width: 0; }
fieldset { min-width: 0; margin: 0 0 1.25rem; padding: 0.75rem 1rem 0.25rem; border-radius: 0.5rem; }
legend { padding: 0 0.5rem; font-weight: 600; }
fieldset fieldset { margin: 0 0 0.9rem; }
p { margin: 0 0 0.9rem; }
p:has(> label:first-child) { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.35rem; }
label { overflow-wrap: anywhere; }

input, textarea {
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 2.75rem;
  padding: 0.5rem 0.75rem;
  font: inherit;
  border-radius: 0.5rem;
}
textarea { font-family: var(--font-mono); font-size: 0.875rem; line-height: 1.5; resize: none; }
code, samp { font-family: var(--font-mono); font-size: 0.9em; overflow-wrap: anywhere; }
summary { display: list-item; min-height: 2.75rem; padding: 0.5rem 0; font-weight: 600; cursor: pointer; }
ul { padding-inline-start: 1.25rem; }
li { margin-bottom: 0.25rem; }

#note-images {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  gap: 1rem;
  margin: 0.5rem 0 1rem;
}
figure { min-width: 0; margin: 0; }
img { display: block; max-width: 100%; height: auto; border: 1px solid var(--bd); border-radius: 0.5rem; }
figcaption { margin-top: 0.5rem; font-size: 0.875rem; }

details p:has(> label:only-child) { display: block; margin-bottom: 0.25rem; }
details p:has(> label:only-child) > label { padding-top: 0; }

@media (hover: none) and (pointer: coarse) {
  input { font-size: 1rem; }
}
@media (min-width: 40rem) {
  p:has(> label:first-child) { grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); align-items: start; gap: 0.35rem 1rem; }
  p:has(> label:first-child) > label { padding-top: 0.5rem; }
}
</style>
<script>
try { var saved = localStorage.getItem("theme"); if (saved === "light" || saved === "dark") document.documentElement.setAttribute("data-theme", saved); } catch (e) {}
</script>
</head>
<body>
<header>
<h1>BDO Game Pilot</h1>
<button type="button" id="theme-toggle"><span id="theme-icon" aria-hidden="true">☾</span> <span id="theme-label">Mode Gelap</span></button>
<nav role="tablist" aria-label="Tab">
<button type="button" role="tab" id="tab-stopwatch" aria-controls="panel-stopwatch" aria-selected="true">Google Stopwatch</button>
<button type="button" role="tab" id="tab-hourly" aria-controls="panel-hourly" aria-selected="false" tabindex="-1">Progress Hourly (Tanpa Agris)</button>
<button type="button" role="tab" id="tab-agris" aria-controls="panel-agris" aria-selected="false" tabindex="-1">Progress Hourly (Dengan Agris)</button>
<button type="button" role="tab" id="tab-total" aria-controls="panel-total" aria-selected="false" tabindex="-1">Total Progress Hourly</button>
<button type="button" role="tab" id="tab-buff" aria-controls="panel-buff" aria-selected="false" tabindex="-1">Buff Counter</button>
<button type="button" role="tab" id="tab-tax" aria-controls="panel-tax" aria-selected="false" tabindex="-1">BDO Tax Calculator</button>
</nav>
</header>
<main>

<section role="tabpanel" id="panel-stopwatch" aria-labelledby="tab-stopwatch">
<h2>Google Stopwatch</h2>
<div id="form-stopwatch">
<fieldset>
<legend>Enter H:MM:SS</legend>
<p><label for="sw-h">Jam (H)</label> <input type="number" id="sw-h" name="h" min="0" step="1" value="1" required></p>
<p><label for="sw-m">Menit (MM)</label> <input type="number" id="sw-m" name="m" min="0" max="59" step="1" value="41" required></p>
<p><label for="sw-s">Detik (SS)</label> <input type="number" id="sw-s" name="s" min="0" max="59" step="1" value="49" required></p>
<p><button type="button" id="reset-stopwatch">Reset input</button></p>
</fieldset>
<p><label for="sw-out">Paste di browser console</label></p>
<p><textarea id="sw-out" name="out" rows="8" cols="80" readonly></textarea></p>
<p>Note:</p>
<ul>
<li>Buka tab baru, search <code>Stopwatch</code> di Google</li>
<li>Play dulu 1–3 detik, yang penting stopwatch udah jalan</li>
<li>Buka browser console, tekan <strong>F12</strong></li>
<li>Paste, ketik <code>allow pasting</code> terus enter jika tidak bisa paste</li>
</ul>
</div>
</section>

<section role="tabpanel" id="panel-hourly" aria-labelledby="tab-hourly" hidden>
<h2>Progress Hourly (Tanpa Agris)</h2>
<div id="form-hourly">
<fieldset>
<legend>Input</legend>
<p><label for="h-total">Total TL:</label> <input type="number" id="h-total" name="total" step="any" value="55000"></p>
<p><label for="h-rate">TL per jam:</label> <input type="number" id="h-rate" name="rate" step="any" value="19000"></p>
<p><button type="button" id="reset-hourly">Reset input</button></p>
</fieldset>
<p><label for="h-out">Progress:</label> <textarea id="h-out" name="progress" rows="1" cols="50" readonly></textarea></p>
<p>Contoh:</p>
<ul>
<li>Total perolehan TL dalam satu shift: <code>55000</code></li>
<li><em>TL per jam sesuai note: <code>19000</code></em></li>
<li>Progress: <samp>2 Hours 53 Minutes 41 Seconds</samp></li>
</ul>
<details>
<summary>Perhitungan</summary>
<p><label for="h-s1">Total TL dibagi TL per jam <strong>(waktu dalam jam)</strong></label></p>
<p><textarea id="h-s1" name="h-s1" rows="1" cols="50" readonly></textarea></p>
<p><label for="h-s2">Waktu dalam jam dikali 3600, dibulatkan ke bawah <strong>(total detik)</strong></label></p>
<p><textarea id="h-s2" name="h-s2" rows="1" cols="50" readonly></textarea></p>
<p><label for="h-s3">Total detik dibagi 3600, dibulatkan ke bawah <strong>(jam)</strong></label></p>
<p><textarea id="h-s3" name="h-s3" rows="1" cols="50" readonly></textarea></p>
<p><label for="h-s4">Sisa total detik dibagi 3600, lalu dibagi 60 dan dibulatkan ke bawah <strong>(menit)</strong></label></p>
<p><textarea id="h-s4" name="h-s4" rows="1" cols="50" readonly></textarea></p>
<p><label for="h-s5">Sisa total detik dibagi 60 <strong>(detik)</strong></label></p>
<p><textarea id="h-s5" name="h-s5" rows="1" cols="50" readonly></textarea></p>
</details>
</div>
</section>

<section role="tabpanel" id="panel-agris" aria-labelledby="tab-agris" hidden>
<h2>Progress Hourly (Dengan Agris)</h2>
<div id="form-agris">
<fieldset>
<legend>Input</legend>
<p><label for="a-total">Total TL:</label> <input type="number" id="a-total" name="total" step="any" value="55000"></p>
<fieldset>
<legend>Patokan Agris</legend>
<p><label for="a-rate">TL/hr dengan Agris:</label> <input type="number" id="a-rate" name="rate" step="any" value="19000"></p>
<p><label for="a-cost">Agris yang digunakan per jam:</label> <input type="number" id="a-cost" name="cost" step="any" value="32000"></p>
</fieldset>
<p><label for="a-normal">TL/hr tanpa Agris:</label> <input type="number" id="a-normal" name="normal" step="any" value="11000"></p>
<p><label for="a-current">Agris yang digunakan:</label> <input type="number" id="a-current" name="current" step="any" value="32000"></p>
<p><button type="button" id="reset-agris">Reset input</button></p>
</fieldset>
<p><label for="a-out">Total Time:</label> <textarea id="a-out" name="total-time" rows="1" cols="40" readonly></textarea></p>
<p><label for="a-with">Time with Agris:</label> <textarea id="a-with" name="time-with-agris" rows="1" cols="40" readonly></textarea></p>
<p><label for="a-without">Time without Agris:</label> <textarea id="a-without" name="time-without-agris" rows="1" cols="40" readonly></textarea></p>
<p>Note:</p>
<ul>
<li>Harus ada patokan <em>Agris yang digunakan</em> dan <em>total TL</em> per jam</li>
</ul>
<div id="note-images">
<figure>
<img src="tidak-bisa-di-hitung.png" alt="Screenshot Note laporan dengan kotak merah: hanya ada TL per jam dengan Agris, tanpa Agris yang digunakan per jam" loading="lazy">
<figcaption><strong>Tidak bisa dihitung.</strong> Pada kotak merah di note, hanya TL per jam dengan Agris, sedangkan Agris yang digunakan per jam tidak ada. Tanpa patokan itu, perhitungannya tidak akan bisa. Solusinya, grinding sendiri dengan Agris berdasarkan TL per jam yang ada di note.</figcaption>
</figure>
<figure>
<img src="bisa-di-hitung.png" alt="Screenshot Note laporan dengan kotak biru: Agris yang digunakan per jam dan TL per jamnya tercantum" loading="lazy">
<figcaption><strong>Bisa dihitung.</strong> Pada kotak biru di note, ada patokan Agris yang digunakan per jam beserta TL per jamnya. Dengan kedua patokan ini, perhitungan total time, time with Agris, dan time without Agris bisa dijalankan.</figcaption>
</figure>
</div>
<p>Contoh:</p>
<ul>
<li>Total TL selama shift: <code>55000</code></li>
<li><em>Note dari TL per jam pake Agris: <code>19000</code></em></li>
<li><em>Note dari TL per jam berapa Agris: <code>32000</code></em></li>
<li><em>Note dari TL per jam tanpa Agris: <code>11000</code></em></li>
<li>Agris yang digunakan selama shift: <code>32000</code></li>
<li>Total Time: <samp>4 Hours 16 Minutes 21 Seconds</samp></li>
<li>Time with Agris: <samp>1 Hours 0 Minutes 0 Seconds</samp></li>
<li>Time without Agris: <samp>3 Hours 16 Minutes 21 Seconds</samp></li>
</ul>
<details>
<summary>Perhitungan</summary>
<p><label for="a-s1">Agris yang digunakan selama shift dibagi dengan Agris yang digunakan per jam <strong>(maks jam Agris)</strong></label></p>
<p><textarea id="a-s1" name="a-s1" rows="1" cols="50" readonly></textarea></p>
<p><label for="a-s2">Maks jam Agris dikali TL/hr dengan Agris <strong>(maks TL Agris)</strong></label></p>
<p><textarea id="a-s2" name="a-s2" rows="1" cols="50" readonly></textarea></p>
<p><label for="a-s3">Total TL dibandingkan dengan Maks TL Agris <strong>(≤ berarti Agris cukup, > berarti Agris tidak cukup)</strong></label></p>
<p><textarea id="a-s3" name="a-s3" rows="1" cols="50" readonly></textarea></p>
<p><label for="a-s4" id="a-l4">(Total TL dikurangi Maks TL Agris) dibagi TL/hr tanpa Agris <strong>(waktu without Agris, dalam jam)</strong></label></p>
<p><textarea id="a-s4" name="a-s4" rows="1" cols="50" readonly></textarea></p>
<p><label for="a-s5">Waktu with Agris ditambah waktu without Agris <strong>(total waktu, dalam jam)</strong></label></p>
<p><textarea id="a-s5" name="a-s5" rows="1" cols="50" readonly></textarea></p>
<fieldset>
<legend>Total Time</legend>
<p><label for="a-t1">Waktu dalam jam dikali 3600, dibulatkan ke bawah <strong>(total detik)</strong></label></p>
<p><textarea id="a-t1" name="a-t1" rows="1" cols="50" readonly></textarea></p>
<p><label for="a-t2">Total detik dibagi 3600, dibulatkan ke bawah <strong>(jam)</strong></label></p>
<p><textarea id="a-t2" name="a-t2" rows="1" cols="50" readonly></textarea></p>
<p><label for="a-t3">Sisa total detik dibagi 3600, lalu dibagi 60 dan dibulatkan ke bawah <strong>(menit)</strong></label></p>
<p><textarea id="a-t3" name="a-t3" rows="1" cols="50" readonly></textarea></p>
<p><label for="a-t4">Sisa total detik dibagi 60 <strong>(detik)</strong></label></p>
<p><textarea id="a-t4" name="a-t4" rows="1" cols="50" readonly></textarea></p>
</fieldset>
<fieldset>
<legend>Time with Agris</legend>
<p><label for="a-w1">Waktu dalam jam dikali 3600, dibulatkan ke bawah <strong>(total detik)</strong></label></p>
<p><textarea id="a-w1" name="a-w1" rows="1" cols="50" readonly></textarea></p>
<p><label for="a-w2">Total detik dibagi 3600, dibulatkan ke bawah <strong>(jam)</strong></label></p>
<p><textarea id="a-w2" name="a-w2" rows="1" cols="50" readonly></textarea></p>
<p><label for="a-w3">Sisa total detik dibagi 3600, lalu dibagi 60 dan dibulatkan ke bawah <strong>(menit)</strong></label></p>
<p><textarea id="a-w3" name="a-w3" rows="1" cols="50" readonly></textarea></p>
<p><label for="a-w4">Sisa total detik dibagi 60 <strong>(detik)</strong></label></p>
<p><textarea id="a-w4" name="a-w4" rows="1" cols="50" readonly></textarea></p>
</fieldset>
<fieldset>
<legend>Time without Agris</legend>
<p><label for="a-o1">Waktu dalam jam dikali 3600, dibulatkan ke bawah <strong>(total detik)</strong></label></p>
<p><textarea id="a-o1" name="a-o1" rows="1" cols="50" readonly></textarea></p>
<p><label for="a-o2">Total detik dibagi 3600, dibulatkan ke bawah <strong>(jam)</strong></label></p>
<p><textarea id="a-o2" name="a-o2" rows="1" cols="50" readonly></textarea></p>
<p><label for="a-o3">Sisa total detik dibagi 3600, lalu dibagi 60 dan dibulatkan ke bawah <strong>(menit)</strong></label></p>
<p><textarea id="a-o3" name="a-o3" rows="1" cols="50" readonly></textarea></p>
<p><label for="a-o4">Sisa total detik dibagi 60 <strong>(detik)</strong></label></p>
<p><textarea id="a-o4" name="a-o4" rows="1" cols="50" readonly></textarea></p>
</fieldset>
</details>
</div>
</section>

<section role="tabpanel" id="panel-total" aria-labelledby="tab-total" hidden>
<h2>Total Progress Hourly</h2>
<div id="form-total">
<fieldset>
<legend>Input</legend>
<p><label for="t-prev">Total progress sebelumnya:</label> <input type="text" id="t-prev" name="prev" value="360 H 51 M"></p>
<p><label for="t-now">Progress:</label> <input type="text" id="t-now" name="now" value="8 H 30 M"></p>
<p><button type="button" id="reset-total">Reset input</button></p>
</fieldset>
<p><label for="t-out">Total Hours:</label> <textarea id="t-out" name="total-hours" rows="1" cols="40" readonly></textarea></p>
<p>Contoh:</p>
<ul>
<li>Total progress sebelumnya adalah <code>360 H 51 M</code></li>
<li>Progress sekarang: <code>8 H 30 M</code></li>
<li>Total Hours: <samp>369 H 21 M</samp></li>
</ul>
<details>
<summary>Perhitungan</summary>
<p><label for="t-s1">Total progress sebelumnya diubah ke menit <strong>(jam dikali 60 ditambah menit)</strong></label></p>
<p><textarea id="t-s1" name="t-s1" rows="1" cols="50" readonly></textarea></p>
<p><label for="t-s2">Progress sekarang diubah ke menit <strong>(jam dikali 60 ditambah menit)</strong></label></p>
<p><textarea id="t-s2" name="t-s2" rows="1" cols="50" readonly></textarea></p>
<p><label for="t-s3">Menit sebelumnya ditambah menit sekarang <strong>(total menit)</strong></label></p>
<p><textarea id="t-s3" name="t-s3" rows="1" cols="50" readonly></textarea></p>
<p><label for="t-s4">Total menit dibagi 60, dibulatkan ke bawah <strong>(jam)</strong></label></p>
<p><textarea id="t-s4" name="t-s4" rows="1" cols="50" readonly></textarea></p>
<p><label for="t-s5">Sisa total menit dibagi 60 <strong>(menit)</strong></label></p>
<p><textarea id="t-s5" name="t-s5" rows="1" cols="50" readonly></textarea></p>
</details>
</div>
</section>

<section role="tabpanel" id="panel-buff" aria-labelledby="tab-buff" hidden>
<h2>Buff Counter</h2>
<div id="form-buff">
<fieldset>
<legend>Input</legend>
<p><label for="b-shift">Shift length:</label> <input type="text" id="b-shift" name="shift" value="6h"></p>
<p><label for="b-duration">Buff duration:</label> <input type="text" id="b-duration" name="duration" value="15m"></p>
<p><label for="b-cooldown">Cooldown:</label> <input type="text" id="b-cooldown" name="cooldown" value="10s"></p>
<p><label for="b-price">Price per buff (opsional):</label> <input type="text" id="b-price" name="price" value="27.5m"></p>
<p><button type="button" id="reset-buff">Reset input</button></p>
</fieldset>
<p><label for="b-o1">Shift:</label> <textarea id="b-o1" name="shift-out" rows="1" cols="40" readonly></textarea></p>
<p><label for="b-o2">Buff:</label> <textarea id="b-o2" name="buff-out" rows="1" cols="40" readonly></textarea></p>
<p><label for="b-o3">Total Buff:</label> <textarea id="b-o3" name="total-buff" rows="1" cols="40" readonly></textarea></p>
<p><label for="b-o4">Cost:</label> <textarea id="b-o4" name="cost" rows="1" cols="40" readonly></textarea></p>
<p>Note:</p>
<ul>
<li>Jika ditulis tanpa satuan, Shift length dihitung <em>jam</em>, Buff duration <em>menit</em>, dan Cooldown <em>detik</em>, jadi <code>6 15 10</code> sama dengan <code>6h 15m 10s</code></li>
<li>Satuan yang bisa dipakai: <code>h</code>, <code>m</code>, <code>s</code>. Tiap form input hanya dapat diisi dalam satu nilai, misal tulis <code>90m</code> bukan <code>1h 30m</code></li>
<li>Price per buff bisa pakai angka biasa, pemisah ribuan, atau akhiran <code>k</code>, <code>m</code>, <code>b</code>. Jika dikosongkan, Cost tidak akan dihitung</li>
</ul>
<p>Contoh:</p>
<ul>
<li>Shift length: <code>6h</code>, Buff duration: <code>15m</code>, Cooldown: <code>10s</code>, Price per buff: <code>27.5m</code></li>
<li>Shift: <samp>6h</samp></li>
<li>Buff: <samp>15m duration + 10s cooldown (one buff covers 15m 10s)</samp></li>
<li>Total Buff: <samp>24 buffs</samp></li>
<li>Cost: <samp>24 x 27,500,000 = 660,000,000 silver</samp></li>
</ul>
<details>
<summary>Perhitungan</summary>
<p><label for="b-s1">Shift diubah ke detik <strong>(nilai dikali satuan detik)</strong></label></p>
<p><textarea id="b-s1" name="b-s1" rows="1" cols="50" readonly></textarea></p>
<p><label for="b-s2">Buff duration diubah ke detik <strong>(nilai dikali satuan detik)</strong></label></p>
<p><textarea id="b-s2" name="b-s2" rows="1" cols="50" readonly></textarea></p>
<p><label for="b-s3">Cooldown diubah ke detik <strong>(nilai dikali satuan detik)</strong></label></p>
<p><textarea id="b-s3" name="b-s3" rows="1" cols="50" readonly></textarea></p>
<p><label for="b-s4">Satu buff menutupi waktu shift sebesar duration ditambah cooldown <strong>(siklus, dalam detik)</strong></label></p>
<p><textarea id="b-s4" name="b-s4" rows="1" cols="50" readonly></textarea></p>
<p><label for="b-s5">Shift dibagi siklus</label></p>
<p><textarea id="b-s5" name="b-s5" rows="1" cols="50" readonly></textarea></p>
<p><label for="b-s6">Hasil bagi dibulatkan ke atas</label></p>
<p><textarea id="b-s6" name="b-s6" rows="1" cols="50" readonly></textarea></p>
<p><label for="b-s7">Jumlah buff minimal 1 <strong>(ambil yang terbesar antara 1 dan hasil pembulatan)</strong></label></p>
<p><textarea id="b-s7" name="b-s7" rows="1" cols="50" readonly></textarea></p>
<p><label for="b-s8">Harga per buff diubah ke silver <strong>(nilai dikali pengali, dibulatkan ke bawah)</strong></label></p>
<p><textarea id="b-s8" name="b-s8" rows="1" cols="50" readonly></textarea></p>
<p><label for="b-s9">Total biaya: jumlah buff dikali harga per buff <strong>(silver)</strong></label></p>
<p><textarea id="b-s9" name="b-s9" rows="1" cols="50" readonly></textarea></p>
</details>
</div>
</section>

<section role="tabpanel" id="panel-tax" aria-labelledby="tab-tax" hidden>
<h2>BDO Tax Calculator</h2>
<div id="form-tax">
<fieldset>
<legend>Input</legend>
<p><label for="d-price">Price:</label> <input type="text" id="d-price" name="price" value="5m"></p>
<p><label for="d-options">Options (opsional):</label> <input type="text" id="d-options" name="options" value="vp ring 4500"></p>
<p><button type="button" id="reset-tax">Reset input</button></p>
</fieldset>
<p><label for="d-o1">Sale price:</label> <textarea id="d-o1" name="d-o1" rows="1" cols="40" readonly></textarea></p>
<p><label for="d-o2">Tax (35%):</label> <textarea id="d-o2" name="d-o2" rows="1" cols="40" readonly></textarea></p>
<p><label for="d-o3">Base profit (65%):</label> <textarea id="d-o3" name="d-o3" rows="1" cols="40" readonly></textarea></p>
<p><label for="d-o4">Value Pack (+30%):</label> <textarea id="d-o4" name="d-o4" rows="1" cols="40" readonly></textarea></p>
<p><label for="d-o5">Ring/Pass (+5%):</label> <textarea id="d-o5" name="d-o5" rows="1" cols="40" readonly></textarea></p>
<p><label for="d-o6" id="d-l6">Family Fame:</label> <textarea id="d-o6" name="d-o6" rows="1" cols="40" readonly></textarea></p>
<p><label for="d-o7">You receive:</label> <textarea id="d-o7" name="d-o7" rows="1" cols="40" readonly></textarea></p>
<fieldset id="d-out2" hidden>
<legend>with Value Pack</legend>
<p><label for="d-p1">Sale price:</label> <textarea id="d-p1" name="d-p1" rows="1" cols="40" readonly></textarea></p>
<p><label for="d-p2">Tax (35%):</label> <textarea id="d-p2" name="d-p2" rows="1" cols="40" readonly></textarea></p>
<p><label for="d-p3">Base profit (65%):</label> <textarea id="d-p3" name="d-p3" rows="1" cols="40" readonly></textarea></p>
<p><label for="d-p4">Value Pack (+30%):</label> <textarea id="d-p4" name="d-p4" rows="1" cols="40" readonly></textarea></p>
<p><label for="d-p5">You receive:</label> <textarea id="d-p5" name="d-p5" rows="1" cols="40" readonly></textarea></p>
</fieldset>
<p>Note:</p>
<ul>
<li>Price bisa pakai angka biasa (<code>5000000</code>), pemisah ribuan (<code>1,000,000</code>), atau akhiran <code>k</code> (ribu), <code>m</code> (juta), <code>b</code> (miliar), <code>t</code> (triliun), contoh <code>500k</code>, <code>100m</code>, <code>1.5b</code></li>
<li>Options boleh dikosongkan atau diisi beberapa, dipisah spasi: <code>vp</code> (Value Pack aktif), <code>ring</code> (Rich Merchant's Ring atau Old Moon Trade Pass, keduanya tidak bisa ditumpuk), dan Family Fame berupa tier <code>fame1</code>, <code>fame2</code>, <code>fame3</code> atau poin Family Fame <strong>P</strong> (contoh <code>4500</code>, otomatis jadi tier)</li>
<li>Jika Options kosong, result akan menampilkan dua versi: biasa dan with Value Pack</li>
<li>Jika ada lebih dari satu input Family Fame, maka otomatis yang terakhir sendiri masuk ke result</li>
<li>Pajak total <em>35%</em> (30% Central Market dan 5% territory), jadi seller menerima <em>65%</em></li>
<li>Semua bonus dihitung dari profit setelah pajak <em>(65%)</em>, lalu dijumlahkan: <em>Value Pack +30%</em>, <em>Ring/Pass +5%</em>, <em>Family Fame 1000–3999 +0.5%</em>, <em>4000–6999 +1.0%</em>, <em>7000 ke atas +1.5%</em></li>
</ul>
<p>Contoh:</p>
<ul>
<li>Price: <code>100m</code>, Options dikosongkan akan menampilkan hasil dengan Value Pack</li>
<li>Price: <code>1.5b</code>, Options: <code>vp</code> menampilkan Value Pack saja</li>
<li>Price: <code>5m</code>, Options: <code>vp ring 4500</code>, poin 4500 menjadi tier +1.0%</li>
<li>Price: <code>100m</code>, Options: <code>vp ring fame3</code> menampilkan semua bonus lewat tier</li>
<li>Sale price: <samp>5,000,000</samp></li>
<li>Tax (35%): <samp>-1,750,000</samp></li>
<li>Base profit (65%): <samp>3,250,000</samp></li>
<li>Value Pack (+30%): <samp>+975,000</samp></li>
<li>Ring/Pass (+5%): <samp>+162,500</samp></li>
<li>Family Fame (4,500 pts, +1.0%): <samp>+32,500</samp></li>
<li>You receive: <samp>4,420,000 (88.40%)</samp></li>
</ul>
<details>
<summary>Perhitungan</summary>
<p><label for="d-s1">Harga diubah ke silver <strong>(nilai dikali pengali, dibulatkan ke bawah)</strong></label></p>
<p><textarea id="d-s1" name="d-s1" rows="1" cols="50" readonly></textarea></p>
<p><label for="d-s2">Profit setelah pajak: harga dikali 0.65</label></p>
<p><textarea id="d-s2" name="d-s2" rows="1" cols="50" readonly></textarea></p>
<p><label for="d-s3">Pajak: harga dikurangi profit</label></p>
<p><textarea id="d-s3" name="d-s3" rows="1" cols="50" readonly></textarea></p>
<p><label for="d-s4">Bonus Value Pack: profit dikali 0.3</label></p>
<p><textarea id="d-s4" name="d-s4" rows="1" cols="50" readonly></textarea></p>
<p><label for="d-s5">Bonus Ring/Pass: profit dikali 0.05</label></p>
<p><textarea id="d-s5" name="d-s5" rows="1" cols="50" readonly></textarea></p>
<p><label for="d-s6">Family Fame points dibandingkan dengan batas tier</label></p>
<p><textarea id="d-s6" name="d-s6" rows="1" cols="50" readonly></textarea></p>
<p><label for="d-s7">Bonus Family Fame: profit dikali persen tier</label></p>
<p><textarea id="d-s7" name="d-s7" rows="1" cols="50" readonly></textarea></p>
<p><label for="d-s8">Total diterima: profit ditambah semua bonus</label></p>
<p><textarea id="d-s8" name="d-s8" rows="1" cols="50" readonly></textarea></p>
<p><label for="d-s9">Rate efektif: total dibagi harga</label></p>
<p><textarea id="d-s9" name="d-s9" rows="1" cols="50" readonly></textarea></p>
<p><label for="d-s10">Rate dalam persen: rate dikali 100</label></p>
<p><textarea id="d-s10" name="d-s10" rows="1" cols="50" readonly></textarea></p>
<fieldset id="d-stp2" hidden>
<legend>with Value Pack</legend>
<p><label for="d-t1">Profit setelah pajak: harga dikali 0.65</label></p>
<p><textarea id="d-t1" name="d-t1" rows="1" cols="50" readonly></textarea></p>
<p><label for="d-t2">Pajak: harga dikurangi profit</label></p>
<p><textarea id="d-t2" name="d-t2" rows="1" cols="50" readonly></textarea></p>
<p><label for="d-t3">Bonus Value Pack: profit dikali 0.3</label></p>
<p><textarea id="d-t3" name="d-t3" rows="1" cols="50" readonly></textarea></p>
<p><label for="d-t4">Total diterima: profit ditambah semua bonus</label></p>
<p><textarea id="d-t4" name="d-t4" rows="1" cols="50" readonly></textarea></p>
<p><label for="d-t5">Rate efektif: total dibagi harga</label></p>
<p><textarea id="d-t5" name="d-t5" rows="1" cols="50" readonly></textarea></p>
<p><label for="d-t6">Rate dalam persen: rate dikali 100</label></p>
<p><textarea id="d-t6" name="d-t6" rows="1" cols="50" readonly></textarea></p>
</fieldset>
</details>
</div>
</section>

</main>
<script>
(function () {
  "use strict";

  /* Tinggi textarea mengikuti isi */
  var fit = function (el) {
    if (!el.clientWidth) return;
    el.style.height = "auto";
    el.style.height = (el.scrollHeight + el.offsetHeight - el.clientHeight) + "px";
  };
  var fitAll = function () {
    Array.prototype.forEach.call(document.querySelectorAll("textarea"), fit);
  };

  /* Isi textarea perhitungan per langkah */
  var fill = function (prefix, lines, count) {
    for (var k = 0; k < count; k++) {
      document.getElementById(prefix + (k + 1)).value = lines[k] || "";
    }
  };

  /* Tema terang/gelap */
  var root = document.documentElement;
  var themeBtn = document.getElementById("theme-toggle");
  var themeIcon = document.getElementById("theme-icon");
  var themeLabel = document.getElementById("theme-label");
  var mq = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;
  var currentTheme = function () {
    return root.getAttribute("data-theme") || (mq && mq.matches ? "dark" : "light");
  };
  var renderTheme = function () {
    var dark = currentTheme() === "dark";
    themeIcon.textContent = dark ? "\u2600\uFE0E" : "\u263E";
    themeLabel.textContent = dark ? "Mode Terang" : "Mode Gelap";
  };
  themeBtn.addEventListener("click", function () {
    var next = currentTheme() === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try { localStorage.setItem("theme", next); } catch (e) {}
    renderTheme();
  });
  if (mq && mq.addEventListener) mq.addEventListener("change", renderTheme);
  renderTheme();

  /* Tabs */
  var tabs = Array.prototype.slice.call(document.querySelectorAll('[role="tab"]'));
  function activate(tab) {
    tabs.forEach(function (t) {
      var on = t === tab;
      t.setAttribute("aria-selected", on ? "true" : "false");
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")).hidden = !on;
    });
    fitAll();
  }
  tabs.forEach(function (t, i) {
    t.addEventListener("click", function () { activate(t); });
    t.addEventListener("keydown", function (ev) {
      var n = null;
      if (ev.key === "ArrowRight") n = tabs[(i + 1) % tabs.length];
      if (ev.key === "ArrowLeft") n = tabs[(i + tabs.length - 1) % tabs.length];
      if (n) { ev.preventDefault(); activate(n); n.focus(); }
    });
  });

  /* 1. Google Stopwatch */
  var calcStopwatch = function () {
    var h = String(Number(document.getElementById("sw-h").value));
    var m = String(Number(document.getElementById("sw-m").value)).padStart(2, "0");
    var s = String(Number(document.getElementById("sw-s").value)).padStart(2, "0");
    var t = h + ":" + m + ":" + s;
    var code = '(()=>{const t=' + JSON.stringify(t) + ',e=document.querySelector(\'[jsname="LQ3Xe"]\');if(!e){console.error(\'Element with selector [jsname="LQ3Xe"] was not found on this page.\');return}const s=document.title.replace(/^[\\d:\\s]+/,""),f=(e.textContent.match(/\\.\\d+$/)||[".00"])[0],o=`${t}${f}`;e.textContent=o;document.title=`${t.padStart(8,"0")} ${s.trim()}`;console.log(o)})();';
    document.getElementById("sw-out").value = code;
  };

  /* 2. Progress hourly tanpa Agris */
  var calcHourly = function () {
    var out = document.getElementById("h-out");
    var t = Number(document.getElementById("h-total").value);
    var p = Number(document.getElementById("h-rate").value);

    if (!t || !p || t < 0 || p <= 0) {
      out.value = "Invalid input.";
      fill("h-s", [], 5);
      return;
    }

    var totalSeconds = Math.floor((t / p) * 3600);
    var hours = Math.floor(totalSeconds / 3600);
    var minutes = Math.floor((totalSeconds % 3600) / 60);
    var seconds = totalSeconds % 60;

    out.value = hours + " Hours " + minutes + " Minutes " + seconds + " Seconds";

    fill("h-s", [
      t + " ÷ " + p + " = " + (t / p),
      "floor(" + (t / p) + " × 3600) = " + totalSeconds,
      "floor(" + totalSeconds + " ÷ 3600) = " + hours,
      "floor((" + totalSeconds + " mod 3600) ÷ 60) = " + minutes,
      totalSeconds + " mod 60 = " + seconds
    ], 5);
  };

  /* 3. Progress hourly dengan Agris */
  var calcAgris = function () {
    var out = document.getElementById("a-out");
    var withA = document.getElementById("a-with");
    var withoutA = document.getElementById("a-without");
    var totalTL = Number(document.getElementById("a-total").value);
    var agrisRate = Number(document.getElementById("a-rate").value);
    var agrisCostPerHour = Number(document.getElementById("a-cost").value);
    var normalRate = Number(document.getElementById("a-normal").value);
    var currentAgris = Number(document.getElementById("a-current").value);

    if (!totalTL || !agrisRate || !agrisCostPerHour || !normalRate || totalTL < 0 || agrisRate <= 0 || agrisCostPerHour <= 0 || normalRate <= 0) {
      out.value = "Invalid input.";
      withA.value = "";
      withoutA.value = "";
      fill("a-s", [], 5);
      fill("a-t", [], 4);
      fill("a-w", [], 4);
      fill("a-o", [], 4);
      return;
    }

    var maxAgrisHours = currentAgris / agrisCostPerHour;
    var maxAgrisTL = maxAgrisHours * agrisRate;

    var agrisTL = 0;
    var normalTL = 0;
    var hoursWithAgris = 0;
    var hoursWithoutAgris = 0;

    if (totalTL <= maxAgrisTL) {
      agrisTL = totalTL;
      hoursWithAgris = agrisTL / agrisRate;
    } else {
      agrisTL = maxAgrisTL;
      normalTL = totalTL - maxAgrisTL;
      hoursWithAgris = maxAgrisHours;
      hoursWithoutAgris = normalTL / normalRate;
    }

    var formatHours = function (h) {
      var totalSecs = Math.floor(h * 3600);
      var hrs = Math.floor(totalSecs / 3600);
      var mins = Math.floor((totalSecs % 3600) / 60);
      var secs = totalSecs % 60;
      return hrs + " Hours " + mins + " Minutes " + secs + " Seconds";
    };

    var totalSeconds = Math.floor((hoursWithAgris + hoursWithoutAgris) * 3600);
    var hours = Math.floor(totalSeconds / 3600);
    var minutes = Math.floor((totalSeconds % 3600) / 60);
    var seconds = totalSeconds % 60;

    out.value = hours + " Hours " + minutes + " Minutes " + seconds + " Seconds";
    withA.value = formatHours(hoursWithAgris);
    withoutA.value = formatHours(hoursWithoutAgris);

    var breakdown = function (h) {
      var secs = Math.floor(h * 3600);
      return [
        "floor(" + h + " × 3600) = " + secs,
        "floor(" + secs + " ÷ 3600) = " + Math.floor(secs / 3600),
        "floor((" + secs + " mod 3600) ÷ 60) = " + Math.floor((secs % 3600) / 60),
        secs + " mod 60 = " + (secs % 60)
      ];
    };
    var enough = totalTL <= maxAgrisTL;

    var l4 = document.getElementById("a-l4");
    l4.textContent = enough
      ? "Total TL dibagi TL/hr dengan Agris "
      : "(Total TL dikurangi Maks TL Agris) dibagi TL/hr tanpa Agris ";
    var l4b = document.createElement("strong");
    l4b.textContent = enough ? "(waktu with Agris, dalam jam)" : "(waktu without Agris, dalam jam)";
    l4.appendChild(l4b);
    fill("a-s", [
      currentAgris + " ÷ " + agrisCostPerHour + " = " + maxAgrisHours,
      maxAgrisHours + " × " + agrisRate + " = " + maxAgrisTL,
      totalTL + (enough ? " ≤ " : " > ") + maxAgrisTL,
      enough
        ? totalTL + " ÷ " + agrisRate + " = " + hoursWithAgris
        : "(" + totalTL + " − " + maxAgrisTL + ") ÷ " + normalRate + " = " + hoursWithoutAgris,
      hoursWithAgris + " + " + hoursWithoutAgris + " = " + (hoursWithAgris + hoursWithoutAgris)
    ], 5);
    fill("a-t", breakdown(hoursWithAgris + hoursWithoutAgris), 4);
    fill("a-w", breakdown(hoursWithAgris), 4);
    fill("a-o", breakdown(hoursWithoutAgris), 4);
  };

  /* 4. Total progress hourly */
  var calcTotal = function () {
    var out = document.getElementById("t-out");
    var p = function (s) {
      return Array.from(s.matchAll(/(\d+)\s*([hm])/gi)).reduce(function (a, m) {
        return a + (m[2].toLowerCase() === "h" ? Number(m[1]) * 60 : Number(m[1]));
      }, 0);
    };

    var explain = function (s) {
      var terms = [];
      var sum = 0;
      Array.from(s.matchAll(/(\d+)\s*([hm])/gi)).forEach(function (m) {
        var isHour = m[2].toLowerCase() === "h";
        sum += isHour ? Number(m[1]) * 60 : Number(m[1]);
        terms.push(isHour ? m[1] + " × 60" : m[1]);
      });
      var expr = terms.join(" + ");
      return (expr === String(sum) || !terms.length ? "" : expr + " = ") + sum;
    };

    var i = document.getElementById("t-prev").value;
    if (!i) { out.value = ""; fill("t-s", [], 5); return; }

    var x = document.getElementById("t-now").value;
    if (!x) { out.value = ""; fill("t-s", [], 5); return; }

    var totalMinutes = p(i) + p(x);
    var hours = Math.floor(totalMinutes / 60);
    var minutes = totalMinutes % 60;

    out.value = hours + " H " + minutes + " M";

    fill("t-s", [
      explain(i),
      explain(x),
      p(i) + " + " + p(x) + " = " + totalMinutes,
      "floor(" + totalMinutes + " ÷ 60) = " + hours,
      totalMinutes + " mod 60 = " + minutes
    ], 5);
  };
  /* 5. Buff counter */
  var DURATION_UNITS = { h: 3600, m: 60, s: 1 };
  var PRICE_SUFFIXES = { k: 1000, m: 1000000, b: 1000000000 };
  var MAX_SECONDS = 1e6;

  var asciiDigits = function (text) {
    return Array.from(text).map(function (ch) {
      var cp = ch.codePointAt(0);
      if (cp < 128 || !/^\p{Nd}$/u.test(ch)) return ch;
      var start = cp;
      while (/^\p{Nd}$/u.test(String.fromCodePoint(start - 1))) start--;
      return String((cp - start) % 10);
    }).join("");
  };
  var pyFloat = function (text) {
    var t = asciiDigits(text.trim());
    if (/^[+-]?(inf|infinity)$/i.test(t)) return t.charAt(0) === "-" ? -Infinity : Infinity;
    if (/^[+-]?nan$/i.test(t)) return NaN;
    return /^[+-]?(\d+\.?\d*|\.\d+)(e[+-]?\d+)?$/.test(t) ? Number(t) : NaN;
  };
  var pyRound = function (x) {
    var r = Math.round(x);
    return (Math.abs(x % 1) === 0.5 && r % 2 !== 0) ? r - 1 : r;
  };

  var parseDuration = function (text, defaultUnit, label, allowZero) {
    var cleaned = text.trim().toLowerCase().replace(/[,_]/g, "");
    if (!cleaned) throw new Error("missing " + label);

    var unit = defaultUnit;
    var last = cleaned.charAt(cleaned.length - 1);
    if (DURATION_UNITS.hasOwnProperty(last)) {
      unit = last;
      cleaned = cleaned.slice(0, -1);
    }

    var value = pyFloat(cleaned);
    if (isNaN(value)) throw new Error("'" + text + "' is not a valid " + label);
    var seconds = value * DURATION_UNITS[unit];

    if (!isFinite(seconds)) throw new Error("'" + text + "' is not a valid " + label);
    if (allowZero) {
      if (seconds < 0) throw new Error(label + " cannot be negative");
    } else if (seconds <= 0) {
      throw new Error(label + " must be greater than zero");
    }
    if (seconds > MAX_SECONDS) throw new Error(label + " is too large");
    return { value: value, mult: DURATION_UNITS[unit], seconds: seconds };
  };

  var parsePrice = function (text) {
    var cleaned = text.trim().toLowerCase().replace(/[,_]/g, "");
    if (!cleaned) throw new Error("missing price");

    var mult = 1;
    var last = cleaned.charAt(cleaned.length - 1);
    if (PRICE_SUFFIXES.hasOwnProperty(last)) {
      mult = PRICE_SUFFIXES[last];
      cleaned = cleaned.slice(0, -1);
    }

    var value = pyFloat(cleaned);
    if (isNaN(value)) throw new Error("'" + text + "' is not a valid price");
    var price = value * mult;

    if (!isFinite(price)) throw new Error("'" + text + "' is not a valid price");
    if (price <= 0) throw new Error("price must be greater than zero");
    if (price > 1e15) throw new Error("price is too large");
    return { value: value, mult: mult, price: BigInt(Math.trunc(price)) };
  };

  var fmtDuration = function (seconds) {
    var total = pyRound(seconds);
    var hours = Math.floor(total / 3600);
    var rem = total % 3600;
    var minutes = Math.floor(rem / 60);
    var secs = rem % 60;
    var parts = [];
    if (hours) parts.push(hours + "h");
    if (minutes) parts.push(minutes + "m");
    if (secs || !parts.length) parts.push(secs + "s");
    return parts.join(" ");
  };

  var calcBuff = function () {
    var outs = ["b-o1", "b-o2", "b-o3", "b-o4"].map(function (id) {
      return document.getElementById(id);
    });
    var clearAll = function (message) {
      outs[0].value = message;
      outs[1].value = "";
      outs[2].value = "";
      outs[3].value = "";
      fill("b-s", [], 9);
    };

    var shift, duration, cooldown, priceText, price, cycle, ratio, count;
    try {
      shift = parseDuration(document.getElementById("b-shift").value, "h", "shift length", false);
      duration = parseDuration(document.getElementById("b-duration").value, "m", "buff duration", false);
      cooldown = parseDuration(document.getElementById("b-cooldown").value, "s", "cooldown", true);
      priceText = document.getElementById("b-price").value;
      price = priceText.trim() ? parsePrice(priceText) : null;

      cycle = duration.seconds + cooldown.seconds;
      ratio = shift.seconds / cycle;
      if (!isFinite(ratio)) throw new Error("result is too large");
      count = Math.max(1, Math.ceil(ratio));
    } catch (e) {
      clearAll(e.message);
      return;
    }

    var countStr = BigInt(count).toString();

    outs[0].value = fmtDuration(shift.seconds);
    outs[1].value = fmtDuration(duration.seconds) + " duration + " +
      fmtDuration(cooldown.seconds) + " cooldown (one buff covers " + fmtDuration(cycle) + ")";
    outs[2].value = countStr + " " + (count === 1 ? "buff" : "buffs");
    outs[3].value = price
      ? countStr + " x " + price.price.toLocaleString("en-US") + " = " +
        (BigInt(count) * price.price).toLocaleString("en-US") + " silver"
      : "";

    var lines = [
      shift.value + " × " + shift.mult + " = " + shift.seconds,
      duration.value + " × " + duration.mult + " = " + duration.seconds,
      cooldown.value + " × " + cooldown.mult + " = " + cooldown.seconds,
      duration.seconds + " + " + cooldown.seconds + " = " + cycle,
      shift.seconds + " ÷ " + cycle + " = " + ratio,
      "ceil(" + ratio + ") = " + BigInt(Math.ceil(ratio)).toString(),
      "max(1, " + BigInt(Math.ceil(ratio)).toString() + ") = " + countStr
    ];
    if (price) {
      lines.push("floor(" + price.value + " × " + price.mult + ") = " + price.price.toString());
      lines.push(countStr + " × " + price.price.toString() + " = " + (BigInt(count) * price.price).toString());
    }
    fill("b-s", lines, 9);
  };

  /* 6. BDO tax calculator */
  var TAX_BASE = 0.65;
  var TAX_VP = 0.30;
  var TAX_RING = 0.05;
  var TAX_FAME = { 1: 0.005, 2: 0.010, 3: 0.015 };
  var TAX_FAME_PCT = { 1: "0.5%", 2: "1.0%", 3: "1.5%" };
  var TAX_SUFFIXES = { k: 1000, m: 1000000, b: 1000000000, t: 1000000000000 };

  var fameTier = function (points) {
    if (points >= 7000n) return 3;
    if (points >= 4000n) return 2;
    if (points >= 1000n) return 1;
    return 0;
  };

  var parseTaxPrice = function (text) {
    var cleaned = text.trim().toLowerCase().replace(/[,_]/g, "");
    if (!cleaned) throw new Error("missing price");

    var mult = 1;
    var last = cleaned.charAt(cleaned.length - 1);
    if (TAX_SUFFIXES.hasOwnProperty(last)) {
      mult = TAX_SUFFIXES[last];
      cleaned = cleaned.slice(0, -1);
    }

    var value = pyFloat(cleaned);
    if (isNaN(value)) throw new Error("'" + text + "' is not a valid price");
    var price = value * mult;

    if (isNaN(price)) throw new Error("'" + text + "' is not a valid price");
    if (price <= 0) throw new Error("price must be greater than zero");
    if (price > 1e15) throw new Error("price is too large");
    return { value: value, mult: mult, price: Math.trunc(price) };
  };

  var parseTaxFlags = function (tokens) {
    var o = { vp: false, ring: false, fame: 0, famePoints: null };
    tokens.forEach(function (raw) {
      var token = raw.trim().toLowerCase();
      if (token === "vp") {
        o.vp = true;
      } else if (token === "ring") {
        o.ring = true;
      } else if (token === "fame1" || token === "fame2" || token === "fame3") {
        o.fame = Number(token.charAt(token.length - 1));
        o.famePoints = null;
      } else if (/^\p{Nd}+$/u.test(token)) {
        o.famePoints = BigInt(asciiDigits(token));
        o.fame = fameTier(o.famePoints);
      } else {
        throw new Error("unknown option '" + token + "' \u2014 use: vp, ring, fame1, fame2, fame3, " +
          "or your Family Fame points (e.g. 4500)");
      }
    });
    return o;
  };

  var taxBreakdown = function (price, vp, ring, fame, famePoints) {
    var profit = price * TAX_BASE;
    var vpBonus = vp ? profit * TAX_VP : 0;
    var ringBonus = ring ? profit * TAX_RING : 0;
    var fameBonus = fame ? profit * TAX_FAME[fame] : 0;
    var total = profit + vpBonus + ringBonus + fameBonus;
    return {
      price: price, tax: price - profit, profit: profit,
      vp: vpBonus, ring: ringBonus, fameBonus: fameBonus, fame: fame, famePoints: famePoints,
      vpOn: vp, ringOn: ring, total: total, rate: total / price
    };
  };

  var money = function (value) { return pyRound(value).toLocaleString("en-US"); };

  var put = function (id, text) {
    if (!id) return;
    var el = document.getElementById(id);
    var row = el.parentNode;
    var prev = row.previousElementSibling;
    var pair = prev && prev.firstElementChild && prev.firstElementChild.htmlFor === id ? prev : null;
    el.value = text === null ? "" : text;
    row.hidden = text === null;
    if (pair) pair.hidden = text === null;
  };

  var showTaxOut = function (ids, r) {
    put(ids.price, money(r.price));
    put(ids.tax, "-" + money(r.tax));
    put(ids.profit, money(r.profit));
    put(ids.vp, r.vp ? "+" + money(r.vp) : null);
    put(ids.ring, r.ring ? "+" + money(r.ring) : null);
    if (r.fameBonus) {
      document.getElementById("d-l6").textContent = "Family Fame (" +
        (r.famePoints !== null ? r.famePoints.toLocaleString("en-US") + " pts, " : "") +
        "+" + TAX_FAME_PCT[r.fame] + "):";
      put(ids.fame, "+" + money(r.fameBonus));
    } else if (r.famePoints !== null) {
      document.getElementById("d-l6").textContent = "Family Fame (" +
        r.famePoints.toLocaleString("en-US") + " pts):";
      put(ids.fame, "no bonus (below 1000)");
    } else {
      put(ids.fame, null);
    }
    put(ids.receive, money(r.total) + " (" + (r.rate * 100).toFixed(2) + "%)");
  };

  var showTaxSteps = function (ids, r, parsed) {
    var pctText = TAX_FAME[r.fame];
    put(ids.price, parsed ? "floor(" + parsed.value + " × " + parsed.mult + ") = " + r.price : null);
    put(ids.profit, r.price + " × " + TAX_BASE + " = " + r.profit);
    put(ids.tax, r.price + " − " + r.profit + " = " + r.tax);
    put(ids.vp, r.vp ? r.profit + " × " + TAX_VP + " = " + r.vp : null);
    put(ids.ring, r.ring ? r.profit + " × " + TAX_RING + " = " + r.ring : null);
    var pts = r.famePoints;
    put(ids.points, pts !== null
      ? pts.toString() + (pts >= 7000n ? " ≥ 7000" : pts >= 4000n ? " ≥ 4000" : pts >= 1000n ? " ≥ 1000" : " < 1000")
      : null);
    put(ids.fame, r.fameBonus ? r.profit + " × " + pctText + " = " + r.fameBonus : null);
    var terms = [String(r.profit)];
    if (r.vp) terms.push(String(r.vp));
    if (r.ring) terms.push(String(r.ring));
    if (r.fameBonus) terms.push(String(r.fameBonus));
    put(ids.total, terms.length > 1 ? terms.join(" + ") + " = " + r.total : null);
    put(ids.rate, r.total + " ÷ " + r.price + " = " + r.rate);
    put(ids.pct, r.rate + " × 100 = " + (r.rate * 100));
  };

  var OUT1 = { price: "d-o1", tax: "d-o2", profit: "d-o3", vp: "d-o4", ring: "d-o5", fame: "d-o6", receive: "d-o7" };
  var OUT2 = { price: "d-p1", tax: "d-p2", profit: "d-p3", vp: "d-p4", ring: null, fame: null, receive: "d-p5" };
  var STP1 = { price: "d-s1", profit: "d-s2", tax: "d-s3", vp: "d-s4", ring: "d-s5", points: "d-s6", fame: "d-s7", total: "d-s8", rate: "d-s9", pct: "d-s10" };
  var STP2 = { price: null, profit: "d-t1", tax: "d-t2", vp: "d-t3", ring: null, points: null, fame: null, total: "d-t4", rate: "d-t5", pct: "d-t6" };

  var calcTax = function () {
    var parsed, options, r1, r2 = null;
    try {
      parsed = parseTaxPrice(document.getElementById("d-price").value);
      options = parseTaxFlags(document.getElementById("d-options").value.split(/\s+/).filter(function (t) { return t; }));
      if (parsed.price === 0) throw new Error("price must be greater than zero");
    } catch (e) {
      Object.keys(OUT1).forEach(function (k) { put(OUT1[k], null); });
      Object.keys(OUT2).forEach(function (k) { put(OUT2[k], null); });
      Object.keys(STP1).forEach(function (k) { put(STP1[k], null); });
      Object.keys(STP2).forEach(function (k) { put(STP2[k], null); });
      put(OUT1.price, e.message);
      document.getElementById("d-out2").hidden = true;
      document.getElementById("d-stp2").hidden = true;
      return;
    }

    var noFlags = !options.vp && !options.ring && !options.fame && options.famePoints === null;
    if (noFlags) {
      r1 = taxBreakdown(parsed.price, false, false, 0, null);
      r2 = taxBreakdown(parsed.price, true, false, 0, null);
    } else {
      r1 = taxBreakdown(parsed.price, options.vp, options.ring, options.fame, options.famePoints);
    }

    showTaxOut(OUT1, r1);
    showTaxSteps(STP1, r1, parsed);
    document.getElementById("d-out2").hidden = !noFlags;
    document.getElementById("d-stp2").hidden = !noFlags;
    if (noFlags) {
      showTaxOut(OUT2, r2);
      showTaxSteps(STP2, r2, null);
    }
  };

  /* Simpan input di localStorage (hanya nilai yang berbeda dari default) */
  var STORE_KEY = "bdo-game-pilot:inputs";
  var readStore = function () {
    try {
      var data = JSON.parse(localStorage.getItem(STORE_KEY) || "{}");
      return data && typeof data === "object" && !Array.isArray(data) ? data : {};
    } catch (e) {
      return {};
    }
  };
  var writeStore = function (data) {
    try {
      if (Object.keys(data).length) localStorage.setItem(STORE_KEY, JSON.stringify(data));
      else localStorage.removeItem(STORE_KEY);
    } catch (e) {}
  };

  var restoreInputs = function () {
    var data = readStore();
    Array.prototype.forEach.call(document.querySelectorAll("main input"), function (el) {
      if (Object.prototype.hasOwnProperty.call(data, el.id) && typeof data[el.id] === "string") {
        el.value = data[el.id];
      }
    });
  };
  restoreInputs();

  document.querySelector("main").addEventListener("input", function (ev) {
    var el = ev.target;
    if (!el || el.tagName !== "INPUT" || !el.id) return;
    var data = readStore();
    if (el.value === el.defaultValue) delete data[el.id];
    else data[el.id] = el.value;
    writeStore(data);
  });

  /* Live update */
  [
    ["form-stopwatch", calcStopwatch],
    ["form-hourly", calcHourly],
    ["form-agris", calcAgris],
    ["form-total", calcTotal],
    ["form-buff", calcBuff],
    ["form-tax", calcTax]
  ].forEach(function (x) {
    var form = document.getElementById(x[0]);
    form.addEventListener("input", function () { x[1](); fitAll(); });

    document.getElementById("reset-" + x[0].replace("form-", "")).addEventListener("click", function () {
      var data = readStore();
      Array.prototype.forEach.call(form.querySelectorAll("input"), function (el) {
        el.value = el.defaultValue;
        delete data[el.id];
      });
      writeStore(data);
      x[1]();
      fitAll();
    });

    x[1]();
  });

  fitAll();
  window.addEventListener("resize", fitAll);
  document.addEventListener("toggle", fitAll, true);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitAll);
})();
</script>
</body>
</html>
