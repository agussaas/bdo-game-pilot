  });

  /* Verifikasi Progress Hourly dengan Agris (Claude, ChatGPT, Gemini) */
  var buildAgrisVerifyPrompt = function () {
    var v = function (id) { return document.getElementById(id).value; };
    var group = function (title, prefix, count) {
      var items = [];
      for (var k = 1; k <= count; k++) {
        var s = v(prefix + k);
        if (s) items.push(s);
      }
      return items.length
        ? ["", title].concat(items.map(function (s, i) { return (i + 1) + ". " + s; }))
        : [];
    };
    var lines = [
      "Tolong verifikasi perhitungan progress hourly (dengan Agris) di bawah ini. Saya ingin memastikan hasilnya benar.",
      "",
      "Data input:",
      "- Total TL selama shift: " + v("a-total"),
      "- TL/hr dengan Agris (patokan note): " + v("a-rate"),
      "- Agris yang digunakan per jam (patokan note): " + v("a-cost"),
      "- TL/hr tanpa Agris (patokan note): " + v("a-normal"),
      "- Agris yang digunakan selama shift: " + v("a-current"),
      "",
      "Rumus yang dipakai:",
      "1. Maks jam Agris = Agris yang digunakan selama shift ÷ Agris per jam",
      "2. Maks TL Agris = Maks jam Agris × TL/hr dengan Agris",
      "3. Jika Total TL ≤ Maks TL Agris (Agris cukup): waktu with Agris = Total TL ÷ TL/hr dengan Agris, waktu without Agris = 0",
      "4. Jika Total TL > Maks TL Agris (Agris tidak cukup): waktu with Agris = Maks jam Agris, waktu without Agris = (Total TL − Maks TL Agris) ÷ TL/hr tanpa Agris",
      "5. Total waktu = waktu with Agris + waktu without Agris (dijumlahkan dalam jam, sebelum dibulatkan)",
      "6. Setiap waktu (dalam jam) diubah ke jam/menit/detik: total detik = floor(jam × 3600), jam = floor(total detik ÷ 3600), menit = floor((total detik mod 3600) ÷ 60), detik = total detik mod 60",
      "Catatan: karena pembulatan dilakukan terpisah untuk tiap hasil, Total Time boleh berbeda sekitar 1 detik dari penjumlahan Time with Agris dan Time without Agris.",
      "",
      "Hasil dari tool:",
      "- Total Time: " + v("a-out"),
      "- Time with Agris: " + v("a-with"),
      "- Time without Agris: " + v("a-without")
    ];
    lines = lines
      .concat(group("Langkah perhitungan dari tool:", "a-s", 5))
      .concat(group("Konversi Total Time:", "a-t", 4))
      .concat(group("Konversi Time with Agris:", "a-w", 4))
      .concat(group("Konversi Time without Agris:", "a-o", 4));
    lines.push(
      "",
      "Yang ingin saya ketahui:",
      "1. Apakah rumusnya sudah benar, termasuk pembagian kasus Agris cukup dan Agris tidak cukup?",
      "2. Hitung ulang sendiri dari data input di atas, apakah hasilnya sama dengan hasil tool?",
      "3. Apakah pembulatan ke bawah (floor) sudah tepat?",
      "",
      "Jawab jujur dan jelas. Jika ada selisih, jelaskan di langkah mana. Jika tidak yakin, bilang tidak yakin."
    );
    return lines.join("\n");
  };
  document.getElementById("verify-agris-open").addEventListener("click", function () {
    if (verifyDlg.open) return;
    verifyOut.value = buildAgrisVerifyPrompt();
    if (typeof verifyDlg.showModal === "function") verifyDlg.showModal();
    else verifyDlg.setAttribute("open", "");
    fit(verifyOut);
  });

