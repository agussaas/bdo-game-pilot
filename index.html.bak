<p><label><input type="checkbox" id="au-reset" name="reset" aria-controls="au-before"> Agris sebelum reset:</label> <input type="text" inputmode="decimal" id="au-before" name="before" value="60,000" disabled aria-label="Agris sebelum reset"></p>
<p><button type="button" id="reset-used">Reset</button> <button type="button" id="clear-used">Clear</button></p>
</fieldset>
<p><label for="au-out">Agris yang digunakan:</label> <textarea id="au-out" name="agris-used" rows="1" cols="40" readonly></textarea></p>
