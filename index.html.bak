      ["Tax (35%):", "d-o2"],
      ["Base profit (65%):", "d-o3"],
      ["Value Pack (+30%):", "d-o4"],
      ["Ring/Pass (+5%):", "d-o5"],
      [fameLabel, "d-o6"],
      ["You receive:", "d-o7"]
    ]));
